/*
 * HalowVideoP2P_AP — приёмная плата, прозрачный режим (uart_p2p).
 *
 * Цепочка доставки:
 *   камера --UART--> модуль STA --эфир--> модуль AP --UART--> этот ESP32
 *   --USB--> ПК (tools/halow_viewer.py)
 *
 * ЧЕМ ОТЛИЧАЕТСЯ ОТ HalowVideo_AP
 * Там из UART модуля вычитывались текстовые заголовки "+RXDATA:<len>" и следом
 * ровно len бинарных байт. Здесь никаких "+RXDATA" нет: прошивка 2.4.1.3 с
 * SYS_APP_UART_P2P=1 выдаёт в UART чистый поток байт, ровно то, что записала в
 * свой UART другая плата. Границы пакетов в потоке не сохраняются, поэтому их
 * несёт наше собственное кадрирование из halow_stream.h — маркер, длина, CRC16.
 *
 * Формат отдачи в USB НЕ ИЗМЕНИЛСЯ: те же записи [0xA5][0x5A][type][len][payload]
 * с телом halow_app_hdr_t + кусок JPEG. Это сделано намеренно —
 * tools/halow_viewer.py работает без единой правки.
 *
 * ЧТО ПОТЕРЯНО: AT-команд на прозрачной прошивке нет (uart_p2p_init забирает
 * UART1 и глушит печать), значит нет ни AT+CONN_STATE, ни AT+RSSI. Поле rssi в
 * метриках всегда 0, просмотрщик покажет прочерк. Живость линка теперь видна
 * не по RSSI, а по счётчикам: растёт pkts_ok — связь есть; растёт crc_err —
 * байты теряются.
 */

#include <Arduino.h>
#include "utilities.h"
#include "halow_stream.h"
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

// ---------------------------- настройки ----------------------------

// Должны совпадать со STA и с UART_P2P_BAUDRATE в прошивке модуля.
#define AT_BAUD   115200   // скорость стартового окна (жёстко 115200 в прошивке)
#define P2P_BAUD  3000000   // ДОЛЖНА совпадать с UART_P2P_BAUDRATE залитого bin
                           // 24.09: модули на 3000000 с патчем кольца 8 КБ (запас 27.3 мс).
                           // Чанк поднять НЕЛЬЗЯ: 1400 — предел эфирного
                           // кадра модуля (1500 Б), см. halow_stream.h:175.
                           // Поэтому пауза 6 мс платится с каждых 1400 Б.
                           // Прежде:
                           // (APP_..._2026-09-24_step3-1000000-RING8K_...bin).
                           // 96e6/1000000 = 96 ровно, ошибка частоты 0%.
                           // Откат на 384000 — и прошивку модуля откатывать тоже.

/*
 * ЗАДЕРЖКА ПРОЗРАЧНОГО РЕЖИМА В ЗАЛИТОЙ ПРОШИВКЕ МОДУЛЯ.
 *
 * Копия UART_P2P_START_DELAY_MS из project_config.h той сборки, что лежит в
 * модуле ЭТОЙ платы (сейчас 180 с, delay180s от 26.08).
 *
 * Зачем задержка вообще: точка доступа, уже ушедшая в прозрачный режим,
 * отказывает новым станциям — на запрос подключения отвечает деаутентификацией
 * с причиной 2. Значит камера обязана подключиться ДО захвата UART.
 *
 * Окно скетча обязано быть длиннее модульного, иначе ESP32 переключит порт на
 * 230400, пока модуль ещё разговаривает по AT на 115200.
 *
 * 27.08: прежнее предупреждение «у модуля камеры пока 8 секунд» устарело и
 * успело обойтись дорого. В обоих модулях с 26.08 залита delay180s, а в скетче
 * камеры оставалось окно 33 с — полторы минуты двоичного мусора в живой
 * разборщик AT-команд ровно во время ассоциации. Теперь обе платы объявляют
 * задержку модуля явно и считают окно от неё.
 */
/*
 * 01.09: 30000, а не 180000. В модуль залита сборка delay30s-nonetlog от
 * 25.08 — проверено опросом, AT+SYSCFG печатает build time Aug 25 2026
 * 17:48:12, что совпадает с датой файла в SDK/builds.
 *
 * Зачем сокращали. Задержку подняли до 180 с вслепую, когда причина отказов
 * связи была неизвестна: считалось, что точка доступа обязана принять станцию
 * ДО перехода в прозрачный режим. Измерения 01.09 показали, что окно из
 * страховки превратилось в главное препятствие: ассоциации происходили на
 * 30-й, 60-й и 95-й секундах и держались до полуминуты, но приёмник начинал
 * слать отчёты только на 178-й — камера об установившейся связи просто не
 * узнавала, гейт не открывался, и к моменту первого отчёта станция уже
 * отваливалась. Итог прогона: ok=0 при трёх состоявшихся ассоциациях.
 *
 * Теперь окно 33 с у обеих плат, отчёты идут почти сразу после старта, и
 * попытка стоит минуту вместо четырёх — при перемежающейся ассоциации это
 * единственный способ набрать статистику, а не гадать по одному прогону.
 */
#define MODULE_P2P_DELAY_MS 30000
#define P2P_WINDOW_MS (MODULE_P2P_DELAY_MS + 3000)

// Мастер-выключатель всего, что скетч делает с модулем в стартовом окне.
#define USE_AT_WINDOW 1

/*
 * 27.08: ОКНО РАЗДЕЛЕНО НА ЧТЕНИЕ И ЗАПИСЬ. Подробное обоснование — в скетче
 * камеры, здесь коротко: запись конфигурации при каждой загрузке приходится на
 * секунды 1-6 жизни модуля, то есть на время ассоциации, и AT+ENCRYPT в этот
 * момент пересобирает ключи и роняет интерфейс. Конфигурация ставится один раз
 * с терминала (tools/halow_at.py setup) и живёт во флеше.
 *
 * AT_WINDOW_LOGCFG оставлен включённым: AT+SYSDBG и AT+PRINT_PERIOD меняют
 * только многословность печати LMAC, полей в struct sys_config под них нет,
 * во флеш не пишутся. А печать здесь нужна — по ней и видно add_STA и WPA.
 */
#define AT_WINDOW_WRITE  0
#define AT_WINDOW_LOGCFG 1
#define AT_WINDOW_READ   1

/*
 * ЗАПАС ПО ПОРОГУ ЗАНЯТОСТИ КАНАЛА, дБ. 0 — не трогать.
 *
 * Это единственная запись, которую скетч приёмника делает намеренно, и она
 * стоит вне AT_WINDOW_WRITE. Разница с остальными в том, что те переписывали
 * то, что и так лежит во флеше, а эта настройка **живёт только в ОЗУ**:
 * проверено 27.08 перезагрузкой модуля — margin возвращается в 0. Не ставить
 * при каждом старте её нельзя.
 *
 * Что она лечит. Точка доступа измеряет фоновый уровень сама, и у неё он
 * выходит около −87 дБм, тогда как у платы с камерой около −60: камера
 * электрически шумнее (шина DVP, PSRAM, XCLK 20 МГц). При таком пороге
 * приёмник считает канал занятым почти всегда, откладывает передачу и копит
 * очередь — 27.08 замерено, как sq растёт до 154, пул падает с 76 до нуля, а
 * кадры ждут отправки до 134 секунд. Ответ на запрос подключения при таком
 * ожидании не успевает никогда: у станции таймаут около секунды.
 *
 * С margin=20 канал видится свободным (cca 0:0), очередь не растёт вовсе, и
 * станция впервые проходит ассоциацию: add_STA, aid=1.
 *
 * Величину подбирали грубо: 20 дБ поднимают порог примерно до уровня, на
 * котором работает камера. Уточнять — измерением, а не на глаз: слишком
 * большой запас делает передатчик невежливым к соседям по диапазону.
 */
#define CCA_MARGIN_DB 20

/*
 * 06.10: ЧЕРЕДОВАНИЕ ЗАПАСА CCA в одном включении — опыт ABAB «20 против 0».
 *
 * Гипотеза. 05.10 камера-точка теряла 7–37 % квитанций при SNR обратного пути
 * 38–40 дБ — не от слабого сигнала. Порог занятости модуля = фон + запас +
 * 10..21 дБ (lmac_adjust_cca_threshold): с запасом 20 при фоне около −87 это
 * −57..−46 дБм, а камера на 3 дБм в 5 м приходит около −64. Приёмник её не
 * слышит и шлёт квитанцию, когда камера передаёт, — та её не принимает.
 *
 * Как. Модуль сам меняет запас каждые CCA_SW_S секунд: CCA_MARGIN_DB,
 * CCA_SW_ALT, CCA_MARGIN_DB, … (AT+CCASW, прошивка модуля ..._ccasw от 06.10).
 * Отсчёт — от команды; ESP32 считает фазу по тому же отсчёту и отдаёт её в
 * просмотрщик полем margin (столбец ap_margin в CSV) и в строку DIAG (cca=).
 * Старая прошивка модуля команду не знает: ответ ERROR, чередования нет,
 * в CSV остаётся CCA_MARGIN_DB.
 *
 * 0 в CCA_SW_S — не чередовать.
 */
#define CCA_SW_S   0     /* 06.10 swap5: CCA 20 постоянно (swap4: 0 даёт 90 % квитанций вместо 74, но больше потерь кусков и обрыв) */
#define CCA_SW_ALT 0

/*
 * 05.10: квитанции и отчёты камере — адресно, если модуль приёмника клиент (опыт
 * «камера — точка доступа»). Прямой канал — всем, обратный — адресно. Если модуль
 * точка доступа (обычная раскладка), ничего не меняется. 0 — всегда «всем».
 */
#define PEER_UNICAST 1

/*
 * ДИАГНОСТИКА ЛИНКА: 1 — спросить модуль, кто он и в каком режиме.
 *
 * Нужна, потому что прозрачный режим невозможно проверить изнутри: мы пишем
 * байты и не получаем на них никакого подтверждения. Если модуль остался в
 * AT-режиме, запись просто исчезает, а скетч продолжает показывать бодрые fps.
 */
#define LINK_DIAG 1

// 1 — ГЛУШИТЬ. Вернул 25.08, и это не косметика.
//
// В прошивке модуля включён netlog (SYS_APP_NETLOG=1): он дублирует ВЕСЬ лог
// модуля в сеть пакетами UDP. Пока к точке доступа никто не подключён, каждую
// такую строку отправить некому — netdev_send_data возвращает -1, lwIP печатает
// "Send to netdev error", и буфер не возвращается в пул.
//
// Замерено 25.08: пул из ~75 буферов выедается за 60 секунд, из них половина
// уходит за первые 4 секунды (загрузочный лог), дальше ровно по 0.6 буфера в
// секунду — это периодический дамп LMAC STATUS, пятнадцать строк каждые шесть
// секунд. С нулём буферов модуль не может передать даже ответ на запрос
// подключения, и связь перестаёт устанавливаться навсегда.
//
// Поставив здесь 0 ради диагностики, я открыл этот кран и на сутки лишил стенд
// связи. Ставить 0 можно только на короткий разбор и помня о цене.
#define QUIET_MODULE 1

/*
 * СТАВИТЬ ЛИ ШИРОКОВЕЩАТЕЛЬНЫЕ ПАРАМЕТРЫ: 1 — как раньше, 0 — оставить заводские.
 *
 * 20.08: платы перестали сходиться. Единственная конфигурация, в которой
 * ассоциация проходит целиком (add_STA, DHCP, адрес 192.168.123.2), — это когда
 * на приёмнике висит сервисный мост. А мост, в отличие от этого скетча, НЕ
 * посылает MCAST_BW и MCAST_MCS. Прецедент уже был: 18.08 от MCAST_MCS=7 связь
 * переставала устанавливаться вовсе, потому что "multicast" здесь — это все
 * кадры на широковещательный адрес, включая маяки и обмен при подключении.
 *
 * Поэтому проверяем без них. Если связь встанет — параметр трогать нельзя, и
 * скорость широковещательного тракта придётся поднимать иначе.
 */
#define SET_MCAST 1   // 03.09: включён ради замера согласованной полосы

/*
 * ШИРОКОВЕЩАТЕЛЬНЫЙ ТРАКТ — им идёт всё наше видео.
 *
 * Измерено 18.08 на живой прошивке: AT+MCAST_BW отвечал "tx bw=2 MHz",
 * AT+MCAST_MCS — "muticast tx mcs= 0". То есть видео шло в полосе 2 МГц из
 * доступных 8 и на самой нижней модуляции.
 *
 * Физическая скорость 802.11ah, один поток:
 *      2 МГц MCS0 —   650 кбит/с      8 МГц MCS0 —  2925
 *      2 МГц MCS7 —  5850             8 МГц MCS7 — 26000
 *
 * Почему это вообще так: uart_p2p шлёт кадры на адрес ff:ff:ff:ff:ff:ff.
 * Широковещательные кадры никто не подтверждает, значит нет ни повторов, ни
 * обратной связи — а без обратной связи модуль не может подбирать модуляцию и
 * ставит заведомо живучую. Отсюда же наши потери при нулевой порче байтов:
 * у каждого пакета ровно одна попытка.
 *
 * Эти два параметра, похоже, НЕ сохраняются между перезагрузками (в отличие от
 * AT+BSS_BW, который пишет в параметры). Поэтому выставляем их здесь, при
 * каждом старте, в том же окне, где ещё жив AT.
 *
 * ОСТОРОЖНО С MCS. 18.08: поставили MCAST_MCS=7, разнесли платы — связь
 * перестала УСТАНАВЛИВАТЬСЯ вовсе. Причина в том, что "multicast" здесь это
 * все кадры на широковещательный адрес, включая МАЯКИ точки доступа и обмен
 * при подключении. По маякам станция находит AP; на MCS 7 они добивают только
 * вплотную. То есть параметр бьёт не по скорости видео, а по самой связи.
 *
 * Поэтому MCS поднимать по одной ступени и каждый раз проверять, что платы
 * вообще сходятся на рабочей дистанции. Полоса (MCAST_BW) в этом смысле
 * безопаснее: 8 МГц совпадает с полосой самого канала.
 */

/*
 * 03.09: MCAST_BW поднят до 8, чтобы полоса сигнала совпала с BSS_BW=8.
 *
 * Зачем. При BSS_BW=8 и MCAST_BW=2 приёмник слушает вчетверо более широкую
 * полосу, чем занимает сигнал, и набирает вчетверо больше шума — около 6 дБ
 * впустую. Проверяем, вернёт ли согласование эти децибелы.
 *
 * Риск известен и измерен 01.09: при MCAST_BW=8 связь не встала (ok=0) —
 * "multicast" здесь это все кадры на широковещательный адрес, включая маяки.
 * Откат бесплатный: MCAST_BW и MCAST_MCS живут только в ОЗУ, снятие питания
 * возвращает 2.
 *
 * Блок вынесен из-под AT_WINDOW_WRITE по той же причине, что и CCA_MARGIN_DB:
 * эти две команды не пишут флеш и не пересобирают ключи, а без них замер
 * попросту не состоится. Всё остальное в окне по-прежнему не пишется.
 */
#define MCAST_BW   4       // 1 / 2 / 4 / 8 МГц. ПОДНИМАТЬ ПО ОДНОЙ СТУПЕНИ
                           // ОБЯЗАНА быть <= BSS_BW: сигнал шире окна приёма
                           // приёмник срежет, это уже не потеря дБ, а потеря сигнала
#define MCAST_MCS  0       // 0..7. ВЫШЕ 0 ПОДНИМАТЬ ПО ОДНОЙ СТУПЕНИ, см. выше

/*
 * РЕГУЛЯТОР МОЩНОСТИ В МОДУЛЕ (28.09): -1 — не слать, 0 — только мерить,
 * 1 — регулировать. Смысл и коридор — как в скетче камеры (PWRCTL_MODE там).
 * Регулировать нужно обе стороны: неудачной передача камеры считается и тогда,
 * когда её приёмник перегружен сигналом ЭТОЙ платы и не слышит подтверждение.
 * Контуры развязаны: каждый модуль смотрит на tx_snr — как сосед слышит его.
 * Печати здесь нет и быть не должно: этим UART идёт видео (P2PLOG выключен).
 */
#define PWRCTL_MODE 1
/* ПРИЁМНИК ВСЕГДА НА ПОТОЛКЕ PWRCTL_MAX (30.09, рабочее решение). Коридор
 * 79–80 дБ недостижим: регулятор всё время хочет вверх и держит потолок, а
 * заводские 20 дБм при этом срезаны до 14 (в режиме 0 среза нет).
 * Почему не коридор 25–35, как у камеры: 30.09 ночью в 5 м, два прогона подряд
 * одной рабочей прошивкой камеры, первые 5 минут каждого:
 *   коридор 25–35  камера слышит приёмник на −66 дБм, 4,54 к/с, 208 кбит/с,
 *                  потери кадров 5,4 %, битых (радуга) 1,0 %;
 *   прибит 14 дБм  −54 дБм, 4,80 к/с, 231 кбит/с, потери 4,8 %, радуги 0,2 %.
 * Выигрыш небольшой (в пределах плавания канала), но везде в одну сторону:
 * камере нужнее всего подтверждения приёмника, им полезен запас. Наземной
 * станции экономить незачем; регулятор нужен на борту (батарея, радуга).
 * Коридор как у камеры: 25 и 35. */
#define PWRCTL_LO   79
#define PWRCTL_HI   80
/* Потолок мощности, дБм: 14 = 25 мВт, предел ГКРЧ для 866–868 МГц. Регулятор
 * сразу срезает до него и заводскую стартовую мощность модуля (20 дБм). */
#define PWRCTL_MAX  14

/*
 * ШТАТНАЯ АВТОМОЩНОСТЬ МОДУЛЯ: -1 — не трогать, 0 — выключить, 1 — включить.
 *
 * 28.09: при включённой AT+TX_PWR_AUTO регулятор PWRCTL ставил 1 дБм, а сосед
 * слышал нас по-прежнему (SNR 64): автомощность выбирает уровень на каждый кадр
 * сама и перекрывает заданный. На камере с выключенной — SNR 64 -> 38, сдвиг
 * захвата 88 % -> 0 из 3199. Здесь то же самое для сигнала приёмника.
 */
#define TX_PWR_AUTO 0


/*
 * ПОИСК СКОРОСТИ: 1 — если из модуля не идёт ни байта, перебирать бод.
 *
 * 20.08. Приёмник не отдаёт в UART НИЧЕГО — ни пакетов, ни мусора (junk=0),
 * хотя его радио в это время принимает кадры камеры (проверено через мост:
 * счётчик rx растёт, est_rate до 313 кбит/с). Ноль мусора при живом эфире —
 * это подпись несовпадения скорости: на неверном бод драйвер ESP32 ловит
 * ошибку кадрирования и выбрасывает байт молча, не считая его мусором.
 *
 * Повод подозревать именно это: в project_config.h прошивки модуля стоит
 * UART_P2P_BAUDRATE 460800, а здесь открывается 230400.
 *
 * Перебираем сами, чтобы не гадать и не перепрошивать под каждое значение.
 * Как только появятся байты — скетч напечатает, на какой скорости, и
 * останется на ней.
 */
// 0: вопрос закрыт. 25.08 перебор прошёл пять полных кругов по 230400/460800/
// 115200/921600 — тишина на каждой. Дело не в скорости, а в том, что модуль
