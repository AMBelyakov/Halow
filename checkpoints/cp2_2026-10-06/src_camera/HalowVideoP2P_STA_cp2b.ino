#if VSYNC_PROBE
/* Щуп VSYNC — см. VSYNC_PROBE. Прерывание GPIO на любой фронт. */
static volatile uint32_t vs_edges = 0;
static void IRAM_ATTR vs_probe_isr(void *arg)
{
    (void)arg;
    vs_edges++;
}

static void vs_probe_attach(void)
{
    const gpio_num_t pin = (gpio_num_t)CAMERA_PIN_VSYNC;
    gpio_install_isr_service(0);        /* уже стоит — вернёт ошибку, это нормально */
    gpio_isr_handler_remove(pin);       /* после перезапуска драйвера — не дважды */
    gpio_set_intr_type(pin, GPIO_INTR_ANYEDGE);
    esp_err_t rc = gpio_isr_handler_add(pin, vs_probe_isr, NULL);
    gpio_intr_enable(pin);
    SerialMon.printf("VSYNC: щуп на GPIO %d — %s\n", (int)pin, rc == ESP_OK ? "стоит" : "НЕ ВСТАЛ");
}
#endif

/*
 * КЭШ И КАДР (06.10). При XCLK 16 МГц драйвер пишет кадр DMA прямо в PSRAM, мимо
 * кэша процессора (см. CAM_XCLK_HZ), а сама библиотека кэш не трогает — в
 * libesp32-camera.a нет ни одного вызова Cache_*. Тогда в кэше могут остаться
 * строки ПРОШЛОГО кадра из того же буфера, и процессор прочтёт их вместо новых.
 * Хуже того, правка слипа пишет в буфер на месте: грязная строка, вытесненная из
 * кэша уже после DMA, затёрла бы новый кадр старыми байтами.
 * Поэтому: взяли кадр — выбросили из кэша его строки (только целые, по 32 Б, чтобы
 * не задеть соседей по куче); отдаём — сначала выписали грязные в PSRAM.
 * При 20 МГц драйвер копирует кадр в PSRAM сам, через кэш, и обе функции пустые.
 */
static inline void cam_cache_fresh(camera_fb_t *fb)
{
#if CAM_XCLK_HZ == 16000000
    uint32_t a = ((uint32_t)fb->buf + 31u) & ~31u;
    uint32_t e = ((uint32_t)fb->buf + fb->len) & ~31u;
    if (e > a) {
        Cache_Invalidate_Addr(a, e - a);
    }
#else
    (void)fb;
#endif
}

static inline void cam_fb_give(camera_fb_t *fb)
{
#if CAM_XCLK_HZ == 16000000
    Cache_WriteBack_Addr((uint32_t)fb->buf, fb->len);
#endif
    esp_camera_fb_return(fb);
}

/* Сила выходов сенсора — см. CAM_DRIVE. force — записать, даже если уже стоит:
 * после перезапуска драйвера сенсор снова на ×4 из таблицы библиотеки. */
static uint8_t cam_drv_now = 0;     /* 0 — не трогали (у библиотеки ×4), 1..4 — ×1..×4 */

static void cam_drv_apply(uint8_t drv, bool force)
{
    if (drv < 1 || drv > 4 || (drv == cam_drv_now && !force)) {
        return;
    }
    sensor_t *sn = esp_camera_sensor_get();
    if (!sn || !sn->set_reg || !sn->get_reg || sn->id.PID != OV5640_PID) {
        return;
    }
    int was = sn->get_reg(sn, 0x302C, 0xFF);
    int rc = sn->set_reg(sn, 0x302C, 0xC0, (drv - 1) << 6);
    int now = sn->get_reg(sn, 0x302C, 0xFF);
    cam_drv_now = drv;
    SerialMon.printf("ТОК ВЫХОДОВ: 0x302C было 0x%02x, стало 0x%02x — x%u (set_reg=%d)\n",
                     was & 0xFF, now & 0xFF, (unsigned)drv, rc);
}

