static int8_t   autoq_idx = -1;        /* ступень; -1 — взять ближайшую к jpeg_q_rt */
#endif

/* Такт XCLK сенсора: остановить — шлейф и сенсор замолкают. */
static void exp_xclk(bool on)
{
    if (on) {
        ledc_timer_resume(LEDC_LOW_SPEED_MODE, LEDC_TIMER_0);
    } else {
        ledc_timer_pause(LEDC_LOW_SPEED_MODE, LEDC_TIMER_0);
    }
}

/* Такт сенсора на ходу: 1 — CAM_PLL_MUL/CAM_PLL_PCLK_DIV, 0 — как ставит драйвер для
 * QVGA RGB565 (множитель 8, делитель PCLK 4). Кадр-другой на переходе может выйти битым. */
static void cam_pll_apply(uint8_t fast)
{
    if (fast == cam_pll_fast) {
        return;
    }
    sensor_t *sn = esp_camera_sensor_get();
    if (!sn || !sn->set_pll || sn->id.PID != OV5640_PID) {
        return;
    }
    int rc = fast ? sn->set_pll(sn, 0, CAM_PLL_MUL, 1, 0, 1, 1, 1, CAM_PLL_PCLK_DIV)
                  : sn->set_pll(sn, 0, 8, 1, 0, 1, 1, 1, 4);
    cam_pll_fast = fast;
    SerialMon.printf("PLL: такт сенсора %s (set_pll=%d)\n", fast ? "x1,5" : "x1", rc);
}

static void exp_apply(uint8_t synth, uint8_t xclk_off, uint16_t chunk, uint8_t q,
                      uint8_t win, uint16_t gap_us, uint8_t autoq, uint8_t pll, uint8_t drv,
                      uint8_t gate)
{
    cam_pll_apply(pll);
#if GATED_CAPTURE
    gate_force = gate == 1 ? 0 : gate == 2 ? 1 : (int8_t)GATE_FORCE;
#else
    (void)gate;
#endif
    cam_drv_apply(drv, false);         /* 0 — не трогать */
    jpeg_q_rt = q;
    chunk_payload = chunk;
    fc_window = win;
    chunk_gap_us = gap_us;
    exp_xclk(!xclk_off);
    synth_on = synth || SYNTH_NOCAM;
#if AUTO_Q
    autoq_on = autoq;
    autoq_idx = -1;                     /* начать с заданного q */
#endif
}

static void exp_mark(uint32_t now)
{
    e_bytes0 = bytes_total;
    e_fid0 = frame_id;
    e_acks0 = lat_acks;
    e_to0 = fc_timeouts;
    e_inc0 = lat_incomplete;
    e_rtt0 = lat_rtt_sum;
    e_cap0 = cap_all;
    e_cwait0 = cam_ms_all;
    e_fixt0 = cam_fix_try;
    e_fixok0 = cam_fix_ok;
    e_fixus0 = cam_fix_us;
    e_votes0 = cam_votes_sum;
    e_ln0 = cam_live_n;
    e_lb0 = cam_live_bad;
#if CAM_WATCHDOG
    e_reinit0 = cam_reinits;
#endif
    e_kb0 = exp_tx0_kb;
    e_rxf0 = peer.frames_done;
    e_rxok0 = peer.pkts_ok;
    e_rxcrc0 = peer.pkts_crc_err;
    e_blk0 = fc_blocked_ms;
    e_cks0 = ck_sent;
    e_ckg0 = ck_got;
    e_ckm0 = ck_mask_acks;
    memcpy(e_ckp0, ck_lost_pos, sizeof(e_ckp0));
#if LMAC_DBG_EVERY
    e_tp0 = lmac_tp_seen;
#endif
    e_q_sum = e_q_n = 0;
    e_q_t = now;
    exp_air_sum = exp_per_sum = exp_mcs_sum = exp_mod_n = 0;
    exp_m0 = now;
    exp_marked = true;
}

static void exp_report(int8_t idx, uint32_t now)
{
    const exp_step_t *s = &exp_steps[idx];
    uint32_t dt = now - exp_m0;
    uint32_t fed = bytes_total - e_bytes0;
    uint32_t sent = frame_id - e_fid0;
    uint32_t acks = lat_acks - e_acks0;
    uint32_t rxf = peer.frames_done - e_rxf0;
    uint32_t n = exp_mod_n ? exp_mod_n : 1;
    /* Эфир — средняя скорость из строк tx0 модуля; счётчик data= в них не
     * монотонный (29.09 разность уходила в минус), поэтому по скорости. */
    uint32_t fed_kbps = dt ? (uint32_t)((uint64_t)fed * 8u / dt) : 0;
    uint32_t ratio100 = fed_kbps ? exp_air_sum / n * 100u / fed_kbps : 0;
    SerialMon.printf("ОПЫТ ИТОГ | %s | %lu с | кадров отпр %lu, подтв %lu, неполных %lu, списано %lu | "
                     "приёмник: чанков %lu (%lu.%lu в с), пакетов %lu, битых %lu | "
                     "подача %lu кбит/с, кадр %lu Б | эфир %lu кбит/с, эфир/подача %lu.%02lu | "
                     "PER модуля %lu %%, MCS %lu.%lu (%lu замеров) | RTT %lu мс | мощность %d дБм | "
                     "W=%u, пауза %u мкс, окно закрыто %lu %%, качество ср %lu\n",
                     s->name, (unsigned long)(dt / 1000),
                     (unsigned long)sent, (unsigned long)acks,
                     (unsigned long)(lat_incomplete - e_inc0), (unsigned long)(fc_timeouts - e_to0),
                     (unsigned long)rxf,
                     (unsigned long)(dt ? rxf * 10000u / dt / 10 : 0),
                     (unsigned long)(dt ? rxf * 10000u / dt % 10 : 0),
                     (unsigned long)(peer.pkts_ok - e_rxok0),
                     (unsigned long)(peer.pkts_crc_err - e_rxcrc0),
                     (unsigned long)fed_kbps,
                     (unsigned long)(sent ? fed / sent : 0),
                     (unsigned long)(exp_air_sum / n),
                     (unsigned long)(ratio100 / 100), (unsigned long)(ratio100 % 100),
                     (unsigned long)(exp_per_sum / n),
                     (unsigned long)(exp_mcs_sum * 10 / n / 10), (unsigned long)(exp_mcs_sum * 10 / n % 10),
                     (unsigned long)exp_mod_n,
                     (unsigned long)(acks ? (uint32_t)((lat_rtt_sum - e_rtt0) / acks) : 0),
                     (int)mod_pwr_dbm,
                     (unsigned)fc_window, (unsigned)chunk_gap_us,
                     (unsigned long)(dt ? (fc_blocked_ms - e_blk0) * 100u / dt : 0),
                     (unsigned long)(e_q_n ? e_q_sum / e_q_n : jpeg_q_rt));
    /* 05.10: куски по квитанциям — отдельной строкой, чтобы не трогать разбор
     * «ОПЫТ ИТОГ» (tools/rc_sweep_report.py). Доля — в десятых процента. */
    {
        uint32_t cs = ck_sent - e_cks0, cg = ck_got - e_ckg0;
        uint32_t lost = cs - cg;
        uint32_t pm = cs ? (uint32_t)((uint64_t)lost * 1000u / cs) : 0;
        SerialMon.printf("ОПЫТ КУСКИ | %s | дошло %lu из %lu, пропало %lu (%lu.%lu %%) | "
                         "по месту: первый %lu, средние %lu, последний %lu | "
                         "квитанций %lu, со списком %lu\n",
                         s->name, (unsigned long)cg, (unsigned long)cs, (unsigned long)lost,
                         (unsigned long)(pm / 10), (unsigned long)(pm % 10),
                         (unsigned long)(ck_lost_pos[0] - e_ckp0[0]),
                         (unsigned long)(ck_lost_pos[1] - e_ckp0[1]),
                         (unsigned long)(ck_lost_pos[2] - e_ckp0[2]),
                         (unsigned long)acks, (unsigned long)(ck_mask_acks - e_ckm0));
    }
    /* 06.10 (drvab): захват по этапу — сдвиг байта и пропуски кадров драйвером
     * (их видно по ожиданию кадра: сенсор отдаёт кадр раз в 112–126 мс). */
    {
        uint32_t nc = cap_all - e_cap0;
        uint32_t ft = cam_fix_try - e_fixt0;
        uint32_t ln = cam_live_n - e_ln0, lb = cam_live_bad - e_lb0;
        uint32_t ft10 = ln ? ft * 1000u / ln : 0;
        uint32_t lb10 = ln ? lb * 1000u / ln : 0;
        uint32_t v10 = ft ? (cam_votes_sum - e_votes0) * 10u / ft : 0;
        uint32_t fps10 = dt ? nc * 10000u / dt : 0;
        uint32_t rn = 0;
#if CAM_WATCHDOG
        rn = cam_reinits - e_reinit0;
#endif
        SerialMon.printf("ОПЫТ КАМЕРА | %s | снято %lu (%lu.%lu к/с), ждали кадр ср %lu мс | "
                         "со сдвигом %lu из %lu (%lu.%lu %%), строк на такой кадр %lu.%lu, вылечено %lu | "
                         "шершавых %lu (%lu.%lu %%) | правка ср %lu мс | перезапусков драйвера %lu | ток x%u\n",
                         s->name, (unsigned long)nc, (unsigned long)(fps10 / 10), (unsigned long)(fps10 % 10),
                         (unsigned long)(nc ? (cam_ms_all - e_cwait0) / nc : 0),
                         (unsigned long)ft, (unsigned long)ln,
                         (unsigned long)(ft10 / 10), (unsigned long)(ft10 % 10),
                         (unsigned long)(v10 / 10), (unsigned long)(v10 % 10),
                         (unsigned long)(cam_fix_ok - e_fixok0),
                         (unsigned long)lb, (unsigned long)(lb10 / 10), (unsigned long)(lb10 % 10),
                         (unsigned long)(ft ? (cam_fix_us - e_fixus0) / ft / 1000u : 0),
                         (unsigned long)rn, (unsigned)cam_drv_now);
    }
    if (idx >= 0 && idx < EXP_RES_MAX) {
        exp_res_t *r = &exp_res[idx];
        uint32_t cs = ck_sent - e_cks0, cg = ck_got - e_ckg0;
        r->fed_kbps = fed_kbps;
        r->frame_b = sent ? fed / sent : 0;
        r->sent = sent;
        r->acks = acks;
        r->inc = lat_incomplete - e_inc0;
        r->wo = fc_timeouts - e_to0;
        r->rx10 = dt ? rxf * 10000u / dt : 0;
        r->lost_pm = cs ? (uint32_t)((uint64_t)(cs - cg) * 1000u / cs) : 0;
        r->rtt = acks ? (uint32_t)((lat_rtt_sum - e_rtt0) / acks) : 0;
        r->cap10 = dt ? (cap_all - e_cap0) * 10000u / dt : 0;
        r->slips = cam_fix_try - e_fixt0;
        r->ln = cam_live_n - e_ln0;
        r->drv = cam_drv_now;
        r->done = 1;
    }
#if LMAC_DBG_EVERY
    /* Сколько раз модуль печатал смену лучшей модуляции (tp1=/tp2=): частая
     * печать сама может тормозить модуль — сверять с R1 без таблицы. */
    SerialMon.printf("ОПЫТ ТАБЛИЦА | %s | смен лучшей за этап %lu\n", s->name,
                     (unsigned long)(lmac_tp_seen - e_tp0));
#endif
}

static void exp_tick(uint32_t now)
{
    const int8_t n = (int8_t)(sizeof(exp_steps) / sizeof(exp_steps[0]));
    if (exp_idx >= n) {
        /* Сводка — каждые 20 с, пока плата работает (см. exp_res). */
        if (now - exp_sum_t >= 20000u) {
            exp_sum_t = now;
            for (int8_t i = 0; i < n && i < EXP_RES_MAX; i++) {
                const exp_res_t *r = &exp_res[i];
                if (!r->done) {
                    continue;
                }
                SerialMon.printf("ОПЫТ СВОДКА | %s | подача %lu кбит/с, кадр %lu Б | отпр %lu, подтв %lu, "
                                 "неполных %lu, списано %lu | приёмник %lu.%lu чанка/с, кусков пропало %lu.%lu %% | "
                                 "RTT %lu мс | съёмка %lu.%lu к/с, сдвигов %lu из %lu | ток x%u\n",
                                 exp_steps[i].name, (unsigned long)r->fed_kbps, (unsigned long)r->frame_b,
                                 (unsigned long)r->sent, (unsigned long)r->acks, (unsigned long)r->inc,
                                 (unsigned long)r->wo, (unsigned long)(r->rx10 / 10), (unsigned long)(r->rx10 % 10),
                                 (unsigned long)(r->lost_pm / 10), (unsigned long)(r->lost_pm % 10),
                                 (unsigned long)r->rtt, (unsigned long)(r->cap10 / 10), (unsigned long)(r->cap10 % 10),
                                 (unsigned long)r->slips, (unsigned long)r->ln, (unsigned)r->drv);
            }
        }
        return;
    }
    if (exp_idx < 0) {
        if (!link_up) {
            return;
        }
        if (!exp_link_ms) {
            exp_link_ms = now;
        }
        if (now - exp_link_ms < EXP_SETTLE_MS) {
            return;
        }
    } else {
        const exp_step_t *s = &exp_steps[exp_idx];
        if (!exp_marked) {
            if (now - exp_t0 >= EXP_WARM_MS) {
                exp_mark(now);
            }
            return;
        }
        if (now - e_q_t >= 1000) {
            e_q_t = now;
            e_q_sum += jpeg_q_rt;
            e_q_n++;
        }
        if (now - exp_t0 < (uint32_t)s->secs * 1000u) {
            return;
        }
        exp_report(exp_idx, now);
    }
    exp_idx++;
    exp_marked = false;
    exp_t0 = now;
    if (exp_idx >= n) {
        exp_apply(0, 0, CHUNK_PAYLOAD, JPEG_QUALITY_SW, FC_WINDOW, CHUNK_GAP_US, AUTO_Q,
                  (CAM_PLL_MUL > 0) ? 1 : 0, CAM_DRIVE ? CAM_DRIVE : 4, 0);
        SerialMon.printf("ОПЫТ: закончен, дальше живое видео%s\n",
                         AUTO_Q ? " с автокачеством" : "");
        return;
    }
    const exp_step_t *s = &exp_steps[exp_idx];
    exp_apply(s->synth, s->xclk_off, s->chunk, s->q, s->win, s->gap_us, s->autoq, s->pll, s->drv,
              s->gate);
    SerialMon.printf("ОПЫТ: этап %d из %d — %s, %u с\n", (int)exp_idx + 1, (int)n,
                     s->name, (unsigned)s->secs);
}
#endif

