static int8_t   exp_idx = -1;          /* -1 — не начат; = числу этапов — закончен */
static uint32_t exp_link_ms = 0, exp_t0 = 0, exp_m0 = 0;
static bool     exp_marked = false;
static uint32_t e_bytes0, e_fid0, e_acks0, e_to0, e_inc0, e_kb0, e_rxf0, e_rxok0, e_rxcrc0;
static uint32_t e_blk0, e_q_sum, e_q_n, e_q_t;
static uint32_t e_cks0, e_ckg0, e_ckm0, e_ckp0[3];
static uint64_t e_rtt0;
static uint32_t e_cap0, e_cwait0, e_fixt0, e_fixok0, e_fixus0, e_votes0, e_ln0, e_lb0, e_reinit0;
/* 06.10 ночь: итоги этапов — в таблицу, её повторяем после опыта: строки этапов
 * теряются в эфире вместе с кусками лога (22:13 пропал итог этапа ×4). */
#define EXP_RES_MAX 8
typedef struct {
    uint32_t fed_kbps, frame_b, sent, acks, inc, wo, rx10, lost_pm, rtt, cap10, slips, ln;
    uint8_t  drv, done;
} exp_res_t;
