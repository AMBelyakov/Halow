/*
 * ОКНО КАДРОВ В ПОЛЁТЕ (28.09, шаг 2 из плана в журнале).
 *
 * Зачем. Подача по UART не знает скорости эфира: при ~20 к/с по 3,3 КБ это
 * ~520 кбит/с, а эфир отдаёт ~490 — очередь модуля то копится до 2–3 с, то
 * сходит. Окно ограничивает число отправленных, но ещё не подтверждённых
 * кадров: следующий уходит, только когда приёмник подтвердил предыдущий.
 * Подача сама подстраивается под эфир («тактирование подтверждениями», как в
 * TCP), и в модуле никогда не лежит больше FC_WINDOW кадров — это и есть
 * потолок задержки.
 *
 * Потерянный кадр подтверждения не получит никогда (пропал последний чанк),
 * поэтому самый старый неподтверждённый списывается через FC_ACK_TIMEOUT_MS.
 * Подтверждение накопительное: пришло на кадр N — всё до N тоже закрыто.
 *
 * Пока окно закрыто, конвейер не должен копить старьё: лишние кадры в
 * очереди выбрасываются, в эфир уходит самый свежий (счётчик fc_skipped).
 *
 * 0 — окна нет, шлём, как раньше, всё, что успела снять камера.
 */
/*
 * 29.09, 320x240: кадр ~7,8 КБ (6 чанков), RTT вырос до 0,9 с в среднем и 3 с
 * в худшем. При таймауте 600 мс камера списала 802 кадра, которые ещё лежали
 * в очереди модуля, и слала новые: окно перестало сдерживать поток, очередь
 * модуля переполнялась, у приёмника пропало 23 % чанков (35 % кадров). Окно
 * держим в кадрах вдвое меньше (кадры вдвое крупнее), ждём дольше RTT.
 */
/* 05.10: в ROLE_SWAP — 4. Повторов в эфире нет, очередь модуля не раздувается, а
 * квитанции от приёмника-клиента теряются (~10 %) и опаздывают: при W=2 окно стояло
 * закрытым 57–75 % времени на синтетике. Потерянную квитанцию закрывает следующая. */
#define FC_WINDOW          (ROLE_SWAP ? 4 : 2)   /* 29.09: было 4; кадры 320x240 вдвое крупнее */
#define FC_ACK_TIMEOUT_MS  1500   /* 29.09: было 600, меньше RTT на 320x240 */
/* 06.10: с правилами автокачества 3 (ROLE_SWAP). Видео идёт всем без повторов:
 * кадр либо дошёл за обычный RTT (медиана ~150 мс, 99 % до ~650), либо не дойдёт
 * никогда — ждать 1,5 с значит держать окно закрытым из-за потерянной квитанции. */
#define FC_ACK_TIMEOUT3_MS 800

/*
 * СЪЁМКА В ПАУЗАХ ПЕРЕДАЧИ (29.09): 1 — в эфир уходят только кадры, снятые
 * целиком, пока модуль камеры молчал.
 *
 * Зачем. Слип и радуга — наводка собственного передатчика на шлейф камеры
 * (26.09; «шторка» 28.09: сдвиг только пока модуль излучает). На 320x240 при
 * 10 дБм битых 40–60 % кадров, при 12 дБм почти все, а потолок мощности режет
 * дальность.
 *
 * Как. Цикл из двух фаз:
 *   передача — шлём до GATE_FRAMES готовых кадров (в пределах FC_WINDOW) и
 *              ждём подтверждения на все: тогда очередь модуля пуста;
 *   тишина   — в модуль не пишем ничего, ни видео, ни лог по воздуху; ждём,
 *              пока камера снимет GATE_FRAMES кадров, целиком уложившихся в
 *              тишину, и пока в очереди есть сжатый кадр прошлой тишины.
 * Кадр чистый, если [начало, начало + длительность кадра] лежит внутри одной
 * тишины: начало — fb->timestamp, длительность — наименьший шаг между кадрами
 * сенсора. Грязные кадры возвращаются драйверу сразу, не сжимаясь. Кадры этой
 * тишины сжимаются во время следующей передачи.
 * Остаток риска: и в тишине модуль камеры коротко отвечает MAC-ACK на пакеты
 * приёмника (подтверждения кадров, отчёт раз в секунду).
 */
#define GATED_CAPTURE     1
#define GATE_FRAMES       2      /* чистых кадров за тишину = кадров за передачу */
#define GATE_MARGIN_MS    5      /* тишина считается через столько после подтверждения */
#define GATE_QUIET_MAX_MS 500    /* дольше не молчим: нет чистых — шлём, что готово */
/*
 * Паузы только при большой мощности (29.09, прогон gated2 на 5 м): паузы
 * убрали радугу (0 из 561), но вдвое срезали скорость — 3,5 к/с и 225 кбит/с
 * против 6,4 к/с и 450 кбит/с без них. А регулятор PWRCTL держал модуль на
 * 2–5 дБм, где радуги и без пауз ~6 %. Наводка растёт с мощностью, поэтому
 * паузы включаются, только когда модуль сам поднял мощность. Мощность берём
 * из его строки «PWRCTL snr=... pwr=N», она приходит раз в несколько секунд.
 */
#define GATE_PWR_ON       8      /* дБм: от стольких паузы включаются */
#define GATE_PWR_OFF      5      /* дБм: до стольких выключаются (гистерезис) */
/*
 * 06.10 ночь: -1 — паузы по мощности (как выше), 0 — выключены всегда, 1 — включены
 * всегда. Опыт меняет на ходу (exp_step_t.gate). Зачем: чекпоинт 2 на 14 дБм шёл
 * 1,7–1,9 к/с — паузы включились сами (мощность ≥ 8) и выбросили 1899 кадров из
 * 2446, а радуги при токе сенсора ×1 было всего 1,2 %. Нужны ли паузы с ×1 —
 * вопрос опыта gate14.
 */
#define GATE_FORCE        (-1)
/*
 * Сколько ждать квитанцию на кадр перед тишиной. В gated2 квитанций не дошло
 * 23 на 551 кадр (приёмник потерял только 5), и каждая стоила 1,5 с простоя
 * (FC_ACK_TIMEOUT_MS) — ~35 с из 4 минут. Задержка квитанции там не больше
 * 226 мс, так что 500 мс с запасом.
 */
#define GATE_ACK_TIMEOUT_MS 500

#if GATED_CAPTURE
#define GATE_RING 8
static portMUX_TYPE gate_mux = portMUX_INITIALIZER_UNLOCKED;
static uint32_t gate_q_start[GATE_RING];
static uint32_t gate_q_end[GATE_RING];         /* 0 — тишина ещё идёт */
static uint32_t gate_q_n = 0;                  /* сколько тишин было */
static volatile bool     gate_quiet = false;
static uint32_t          gate_quiet_t0 = 0;
static volatile uint32_t gate_clean_cur = 0;   /* чистых кадров в текущей тишине */
static volatile uint32_t gate_frame_ms = 100;  /* длительность кадра сенсора, оценка */
static uint32_t gate_sent_busy = 0;            /* кадров ушло в текущей передаче */
static uint32_t gate_cycles = 0, gate_forced = 0, gate_quiet_ms_sum = 0;
static volatile int8_t mod_pwr_dbm = PWRCTL_MAX;   /* мощность модуля, из строки PWRCTL */
static volatile uint32_t mod_pwr_seen = 0;         /* сколько таких строк разобрано */
static volatile bool gate_on = true;               /* паузы сейчас включены */
static int8_t gate_force = GATE_FORCE;             /* см. GATE_FORCE */
static uint32_t gate_switches = 0;                 /* переключений вкл/выкл */
static uint32_t gate_on_ms = 0, gate_off_ms = 0;   /* время в каждом режиме */
static uint32_t gate_mode_t = 0;
static volatile uint32_t gate_clean = 0, gate_dirty = 0;

static void gate_begin_quiet(uint32_t now)
{
    portENTER_CRITICAL(&gate_mux);
    uint32_t i = gate_q_n % GATE_RING;
    gate_q_end[i] = 0;
    gate_q_start[i] = now + GATE_MARGIN_MS;
    gate_q_n++;
    gate_clean_cur = 0;
    gate_quiet = true;
    portEXIT_CRITICAL(&gate_mux);
    gate_quiet_t0 = now;
}

static void gate_end_quiet(uint32_t now)
{
    portENTER_CRITICAL(&gate_mux);
    if (gate_q_n) {
        gate_q_end[(gate_q_n - 1) % GATE_RING] = now;
    }
    gate_quiet = false;
    portEXIT_CRITICAL(&gate_mux);
    gate_quiet_ms_sum += now - gate_quiet_t0;
    gate_cycles++;
}

/* Из главного цикла: включить или выключить паузы по мощности модуля. */
static void gate_mode_update(uint32_t now)
{
    if (gate_mode_t) {
        if (gate_on) {
            gate_on_ms += now - gate_mode_t;
        } else {
            gate_off_ms += now - gate_mode_t;
        }
    }
    gate_mode_t = now;
    int p = synth_on ? 0 : mod_pwr_dbm;       /* в синтетике картинка не важна */
    bool want_off = gate_force >= 0 ? gate_force == 0 : p <= GATE_PWR_OFF;
    bool want_on  = gate_force >= 0 ? gate_force == 1 : p >= GATE_PWR_ON;
    if (gate_on && want_off) {
        if (gate_quiet) {
            gate_end_quiet(now);
        }
        gate_on = false;
        gate_switches++;
    } else if (!gate_on && want_on) {
        gate_on = true;
        gate_sent_busy = GATE_FRAMES;   /* сперва дождаться подтверждений и замолчать */
        gate_switches++;
    }
}

/* Из захвата (под cap_mutex): кадр целиком в одной тишине? Заодно оценка
 * длительности кадра — наименьший шаг между началами за 32 кадра. */
static bool gate_frame_clean(uint32_t start)
{
    static uint32_t prev = 0, min_d = 1000, cnt = 0;
    uint32_t d = start - prev;
    prev = start;
    if (d >= 15 && d < min_d) {
        min_d = d;
    }
    if (++cnt >= 32) {
        gate_frame_ms = min_d;
        min_d = 1000;
        cnt = 0;
    }

    if (!gate_on) {
        return true;
    }
    bool clean = false;
    uint32_t dur = gate_frame_ms;
    portENTER_CRITICAL(&gate_mux);
    uint32_t n = gate_q_n;
    for (uint32_t k = 0; k < GATE_RING && k < n; k++) {
        uint32_t i = (n - 1 - k) % GATE_RING;
        uint32_t s = gate_q_start[i], e = gate_q_end[i];
        if ((int32_t)(start - s) < 0) {
            continue;                          /* кадр начался раньше этой тишины */
        }
        if (e == 0) {                          /* тишина идёт, кадр уже дописан */
            clean = true;
            gate_clean_cur++;
        } else if ((int32_t)(e - (start + dur)) >= 0) {
            clean = true;                      /* уложился до конца тишины */
        }
        break;
    }
    portEXIT_CRITICAL(&gate_mux);
    if (clean) {
        gate_clean++;
    } else {
        gate_dirty++;
    }
    return clean;
}
#endif

static uint32_t fc_last_ack_id = 0;   /* старший подтверждённый (или списанный) кадр */
static uint32_t fc_timeouts = 0;      /* списано кадров без подтверждения */
static uint32_t fc_skipped = 0;       /* выброшено устаревших кадров из очереди */
static uint32_t fc_blocked_ms = 0;    /* сколько окно было закрыто при готовом кадре */
static uint8_t  fc_window = FC_WINDOW; /* окно сейчас; меняет опыт (EXP_PROGRAM) */

#if FC_WINDOW
static bool fc_can_send(void)
{
    if (frame_id - fc_last_ack_id < fc_window) {
        return true;
    }
    /* Окно полно. Самый старый неподтверждённый — следующий за подтверждённым. */
    uint32_t oldest = fc_last_ack_id + 1;
    lat_slot_t *s = &lat_ring[oldest % LAT_RING];
    /* 06.10: в ROLE_SWAP — всегда короткий (видео всем, повторов нет), чтобы этапы с
     * закреплённым Q и с автокачеством различались только автокачеством. */
    uint32_t tmo = (ROLE_SWAP || autoq_on >= 3) ? FC_ACK_TIMEOUT3_MS : FC_ACK_TIMEOUT_MS;
    if (s->id != oldest || !s->sent_ms || millis() - s->sent_ms > tmo) {
        /* Затёрт в кольце, уже подтверждён или ждёт слишком долго — списываем. */
        fc_last_ack_id = oldest;
        fc_timeouts++;
        return frame_id - fc_last_ack_id < fc_window;
    }
    return false;
}
#endif

static void lat_on_ack(const halow_p2p_ack_t *a, bool has_mask)
{
    uint32_t now = millis();
    /* Для окна — накопительно и до любых проверок: подтверждение на кадр N
     * закрывает и все до него. Номер из будущего не берём. */
    if ((int32_t)(a->frame_id - fc_last_ack_id) > 0 &&
        (int32_t)(frame_id - a->frame_id) >= 0) {
        fc_last_ack_id = a->frame_id;
    }
    lat_slot_t *s = &lat_ring[a->frame_id % LAT_RING];
    if (s->id != a->frame_id || !s->sent_ms) {
        lat_unmatched++;
        return;
    }
    uint32_t rtt = now - s->sent_ms;
    uint32_t age = now - s->cap_ms;
    s->sent_ms = 0;                      /* повторное подтверждение не считаем */
    lat_acks++;
    if (a->chunks_got < a->chunk_cnt) {
        lat_incomplete++;
    }
    ck_sent += a->chunk_cnt;
    ck_got += a->chunks_got < a->chunk_cnt ? a->chunks_got : a->chunk_cnt;
    if (has_mask) {
        ck_mask_acks++;
        for (uint16_t i = 0; i < a->chunk_cnt && i < 32; i++) {
            if (!(a->chunk_mask & (1u << i))) {
                ck_lost_pos[i == 0 ? 0 : (i + 1 == a->chunk_cnt ? 2 : 1)]++;
            }
        }
    }
    lat_rtt_sum += rtt;
    lat_age_sum += age;
    {
        /* 06.10, правила автокачества 3: запоздалая квитанция — последнего куска нет,
         * приёмник ответил по первому куску следующего кадра, RTT больше на кадр. */
        bool late = has_mask && a->chunk_cnt && a->chunk_cnt <= 32 &&
                    !(a->chunk_mask & (1u << (a->chunk_cnt - 1)));
        if (late) {
            aq_late++;
        } else if (aq_rtt_n < AQ_RTT_MAX) {
            aq_rtt_buf[aq_rtt_n++] = (uint16_t)(rtt > 65535 ? 65535 : rtt);
        }
    }
    if (rtt > lat_rtt_max) lat_rtt_max = rtt;
    if (rtt < lat_rtt_min) lat_rtt_min = rtt;
    if (age > lat_age_max) lat_age_max = age;
    uint32_t bin = age / LAT_HIST_MS;
    if (bin >= LAT_HIST_BINS) bin = LAT_HIST_BINS - 1;
    lat_hist[bin]++;
}

/* Время съёмки кадра в шкале millis(): и то и другое идёт от esp_timer. */
static uint32_t fb_start_ms(const camera_fb_t *fb)
{
    return (uint32_t)((uint64_t)fb->timestamp.tv_sec * 1000ULL +
                      (uint64_t)fb->timestamp.tv_usec / 1000ULL);
}

