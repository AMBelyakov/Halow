//************************************[ СТАРТОВОЕ ОКНО ]*********************************

// Пока прозрачный режим не стартовал, модуль ещё понимает AT. Пользуемся этим
// ровно один раз — чтобы заткнуть периодическую печать LMAC, которая иначе
// будет сыпаться в поток.

// Одна команда в стартовом окне: послать и показать ответ модуля.
// wait_ms — сколько ждать ответа. 300 мс хватает почти всем, но AT+SYSCFG
// вываливает два десятка строк, и на 300 мс его ответ обрезается посередине.
/* Возвращает ответ модуля: он нужен не только логу. Из AT+SYSCFG мы достаём
 * bssid, чтобы не зашивать MAC приёмника константой (см. P2P_UNICAST). */
/*
 * Сколько команд стартового окна получили ответ.
 *
 * ЗАЧЕМ СЧИТАТЬ. esptool перезагружает только ESP32; модуль TX-AH при этом
 * продолжает работать и, если с его включения прошло больше
 * UART_P2P_START_DELAY_MS, уже забрал UART себе. Тогда стартового окна нет:
 * все команды уходят в пустоту, модуль молча остаётся на настройках прошлой
 * загрузки, а скетч как ни в чём не бывало начинает поток.
 *
 * 16.09 на этом сгорела целая ночь измерений: три прогона подряд были
 * подписаны как широковещательные, а шли одноадресно, потому что P2PDEST
 * остался от прошлой загрузки. Снятие флага в скетче не меняет НИЧЕГО, когда
 * команду некому принять.
 *
 * Поэтому: если ни одна команда окна не получила ответа — кричать об этом в
 * лог, чтобы прогон не был засчитан.
 */
static uint8_t at_window_answers = 0;

static String atWindowCmdWait(const char *cmd, uint16_t wait_ms)
{
    while (SerialAT.available()) {
        SerialAT.read();
    }
    SerialAT.print(cmd);

    /* Вычёрпываем ВО ВРЕМЯ ожидания, а не после. Раньше здесь был delay() и
     * потом чтение: длинный ответ (AT+SYSCFG — два десятка строк) не помещался
     * в приёмный буфер драйвера и обрезался посередине, а обрезанным его не
     * прочитать. */
    String resp;
    uint32_t t0 = millis();
    while (millis() - t0 < wait_ms) {
        while (SerialAT.available()) {
            resp += (char)SerialAT.read();
        }
        delay(2);
    }
    resp.trim();
    /*
     * Засчитываем ТОЛЬКО ответ, содержащий "OK".
     *
     * Проверки «строка непустая» недостаточно: 16.09 она дала ложный пропуск.
     * Модуль сидел в прозрачном режиме, в UART шёл его поток данных, и куски
     * этого потока попадали в ответ — на AT+SYSCFG, который печатает два
     * десятка строк, пришёл одинокий знак вопроса. Четыре таких огрызка были
     * посчитаны за ответы, и прогон объявлен годным.
     *
     * "OK" модуль печатает в конце почти каждой команды окна (SYSDBG,
     * MCAST_BW, MCAST_MCS, P2PDEST, ENCRYPT, SSID, SET_BGRSSI). Случайно
     * собраться из видеопотока эти два байта подряд практически не могут.
     */
    if (resp.indexOf("OK") >= 0 && at_window_answers < 255) {
        at_window_answers++;
    }
    String echo(cmd);
    echo.trim();                 // без хвостового CRLF, иначе лог лесенкой
    if (!resp.length()) {
        SerialMon.printf("  %s -> (нет ответа)\n", echo.c_str());
    } else if (resp.indexOf('\n') < 0) {
        SerialMon.printf("  %s -> %s\n", echo.c_str(), resp.c_str());
    } else {
        /* Многострочный ответ печатаем как есть: складывать конфигурацию
         * модуля в одну строку — значит потом её не прочитать. */
        SerialMon.printf("  %s ->\n", echo.c_str());
        SerialMon.println(resp);
    }
    return resp;
}

static void atWindowCmd(const char *cmd)
{
    atWindowCmdWait(cmd, 300);
}

/* Определена ниже, в разделе камеры; замеру шума она нужна здесь. */
static bool camera_init(void);

static void useAtWindow(void)
{
#if USE_AT_WINDOW
#if AT_WINDOW_LOGCFG && QUIET_MODULE
    const char *cmds[] = {
#if LMAC_STATS
        /* Обратно включаем печать LMAC: ради неё всё и затевается. */
        "AT+SYSDBG=LMAC,1\r\n",
#else
        "AT+SYSDBG=LMAC,0\r\n",
#endif
        "AT+SYSDBG=WNB,0\r\n",
    };
#endif
#if AT_WINDOW_WRITE || CCA_MARGIN_DB || SET_MCAST || LMAC_STATS || P2P_UNICAST
    char buf[48];
#endif

#if CCA_MARGIN_DB
    snprintf(buf, sizeof(buf), "AT+BGRSSI_MARGIN=%d\r\n", CCA_MARGIN_DB);
    atWindowCmd(buf);
#endif

    SerialMon.printf("Стартовое окно (%u с): запись %s, чтение %s\n",
                     (unsigned)(P2P_WINDOW_MS / 1000),
                     AT_WINDOW_WRITE ? "ВКЛ" : "выкл",
                     AT_WINDOW_READ ? "вкл" : "выкл");

#if AT_WINDOW_LOGCFG && QUIET_MODULE
    /* Только многословность печати LMAC. Радио, ключи и флеш не трогает. */
#if LMAC_STATS
    snprintf(buf, sizeof(buf), "AT+PRINT_PERIOD=%d\r\n", (int)LMAC_STATS);
    atWindowCmd(buf);
    /*
     * Вернуть печать ПОСЛЕ старта прозрачного режима. Без этой команды всё
     * предыдущее бесполезно: uart_p2p_init() последним делом зовёт
     * disable_print(1), и статистика замолкает на 30-й секунде — ровно перед
     * тем, как пойдёт видео. AT+P2PLOG заводит в модуле периодический таймер,
     * который возвращает disable_print(0).
     *
     * Команды нет в заводской прошивке: она добавлена в project/atcmd.c и
     * собрана 17.09 (SDK/builds/APP_..._p2pdest_p2plog.bin). На старой прошивке
     * не ответит, и прогон просто пойдёт без статистики.
     *
     * ТОЛЬКО НА КАМЕРЕ. На приёмнике этим же UART идёт видео из эфира, и текст
     * его побьёт.
     */
    snprintf(buf, sizeof(buf), "AT+P2PLOG=%d\r\n", (int)LMAC_STATS);
    atWindowCmd(buf);
    snprintf(buf, sizeof(buf), "AT+UARTDRAIN=%d\r\n", (int)UART_DRAIN);
    atWindowCmd(buf);
#endif
    for (unsigned i = 0; i < sizeof(cmds) / sizeof(cmds[0]); i++) {
        atWindowCmd(cmds[i]);
    }
#endif

#if SET_MCAST
    /* Широковещательный тракт — им идёт видео. Ставим каждый раз:
     * эти параметры, судя по всему, не переживают перезагрузку.
     *
     * ОСТОРОЖНО: на приёмнике этот же блок отключён (SET_MCAST 0) с 20.08,
     * потому что MCAST_MCS бьёт по маякам и по самой возможности подключиться.
     * Асимметрия «на камере ставим, на приёмнике нет» держалась неделю и никем
     * не была замечена — ещё одна причина не писать конфигурацию из скетча. */
    snprintf(buf, sizeof(buf), "AT+MCAST_BW=%d\r\n", MCAST_BW);
    atWindowCmd(buf);
    snprintf(buf, sizeof(buf), "AT+MCAST_MCS=%d\r\n", MCAST_MCS);
    atWindowCmd(buf);
#endif

#if AT_WINDOW_READ
    /* Паспорт прогона со стороны модуля: конфигурация целиком, одной командой.
     * Ловится в консольный лог и подшивается к прогону
     * (tools/run_passport.py). Ничего не меняет. */
    String syscfg = atWindowCmdWait("AT+SYSCFG\r\n", 2000);
#if P2P_UNICAST
    /*
     * Кому слать видео. bssid станции — это MAC точки доступа; берём его из
     * ответа выше, а не из константы.
     *
     * Формат строки: "  mac:c6:e8:35:92:6e:18, bssid:c6:e8:35:70:7a:68".
     * Ищем именно "bssid:", а не "mac:" — иначе подставили бы собственный
     * адрес и отправляли бы кадры сами себе.
     */
    {
        int at = syscfg.indexOf("bssid:");
        if (at < 0) {
            SerialMon.println("  P2PDEST: bssid в AT+SYSCFG не найден, "
                              "остаёмся широковещательными");
        } else {
            String bssid = syscfg.substring(at + 6, at + 6 + 17);
            bssid.trim();
            if (bssid.length() != 17) {
                SerialMon.printf("  P2PDEST: bssid непохож на MAC (%s)\n",
                                 bssid.c_str());
            } else if (bssid.startsWith("00:00:00:00:00:00")) {
                /* Станция ещё не ассоциирована, точка доступа неизвестна.
                 * Слать нулевой адрес нельзя — модуль его и сам отвергнет. */
                SerialMon.println("  P2PDEST: bssid нулевой, точка доступа ещё "
                                  "не выбрана — остаёмся широковещательными");
            } else {
#if P2P_DEST_TEST
                /* Отладка: шлём в никуда, чтобы убедиться, что адрес вообще
                 * управляет эфиром. Видео должно пропасть. */
                SerialMon.printf("  P2PDEST: ПРОВЕРКА ЛОЖНЫМ АДРЕСОМ, настоящий "
                                 "%s подменяю на %s%s",
                                 bssid.c_str(), P2P_DEST_TEST_MAC, "\n");
                bssid = P2P_DEST_TEST_MAC;
#endif
                snprintf(buf, sizeof(buf), "AT+P2PDEST=%s\r\n", bssid.c_str());
                atWindowCmd(buf);
            }
        }
    }
#endif
#if TX_PWR_AUTO >= 0
    snprintf(buf, sizeof(buf), "AT+TX_PWR_AUTO=%d\r\n", (int)TX_PWR_AUTO);
    atWindowCmd(buf);
    atWindowCmd("AT+TX_PWR_AUTO=?\r\n");
#endif
#if TX_POWER_DBM >= 1
    snprintf(buf, sizeof(buf), "AT+TXPOWER=%d\r\n", (int)TX_POWER_DBM);
    atWindowCmd(buf);
    atWindowCmd("AT+TXPOWER=?\r\n");
#endif
#if RTS_SET_SYM > 0
    snprintf(buf, sizeof(buf), "AT+SET_RTS=%d\r\n", (int)RTS_SET_SYM);
    atWindowCmd(buf);
#endif
#if PWRCTL_MODE >= 0
    /* После AT+TXPOWER: регулятор берёт её как стартовую мощность. */
    snprintf(buf, sizeof(buf), "AT+PWRCTL=%d,%d,%d,%d\r\n",
             (int)PWRCTL_MODE, (int)PWRCTL_LO, (int)PWRCTL_HI, (int)PWRCTL_MAX);
    atWindowCmd(buf);
#endif
#if ROLE_SWAP && MCSCTL_MODE >= 0
    /* После AT+MCAST_MCS (блок SET_MCAST выше): с неё подстройка и стартует. */
#if MCSCTL_ALT_S > 0
    snprintf(buf, sizeof(buf), "AT+MCSCTL=%d,0,0,6,%d\r\n", (int)MCSCTL_MODE, (int)MCSCTL_ALT_S);
#else
    snprintf(buf, sizeof(buf), "AT+MCSCTL=%d\r\n", (int)MCSCTL_MODE);
#endif
    atWindowCmd(buf);
#endif
#if TX_MCS_MAX_CAP >= 0
    /* 128 — бит «ограничение задано», без него значение игнорируется. */
    snprintf(buf, sizeof(buf), "AT+TX_MCS_MAX=%d\r\n",
             128 + (int)TX_MCS_MAX_CAP);
    atWindowCmd(buf);
#endif
#if MCS_SWEEP
    {
        static const int8_t lst[] = MCS_SWEEP_LIST;
        const uint8_t n = sizeof(lst) / sizeof(lst[0]);
        Preferences pr;
        pr.begin(MCS_SWEEP_NS, false);
        uint8_t i = pr.getUChar("i", 0);
        int8_t v = lst[i % n];
        bool ok = at_window_answers >= 3;
        if (v >= 0) {
            snprintf(buf, sizeof(buf), "AT+TX_MCS=%d\r\n", (int)v);
            ok = (atWindowCmdWait(buf, 300).indexOf("OK") >= 0) && ok;
        }
        char vs[16];           /* «авто» в UTF-8 — 8 байт плюс ноль */
        if (v >= 0) snprintf(vs, sizeof(vs), "%d", (int)v);
        else        snprintf(vs, sizeof(vs), "авто");
        SerialMon.printf("MCS-ПЕРЕБОР: шаг %u из %u, MCS %s%s\n",
                         (unsigned)(i % n + 1), (unsigned)n, vs,
                         ok ? "" : " — ОКНО/КОМАНДА НЕ ПРОШЛИ, шаг не засчитан");
        if (ok) {
            pr.putUChar("i", (uint8_t)(i + 1));
        }
        pr.end();
    }
#elif TX_MCS_FIX >= 0
    snprintf(buf, sizeof(buf), "AT+TX_MCS=%d\r\n", (int)TX_MCS_FIX);
    atWindowCmd(buf);
#endif
    bool chan_written = false;
#if BSS_BW_SET > 0 || CHAN_SET > 0
    {
        /* Ответы: "+BSS_BW:4", "+CHAN_LIST:8660". Пишем, только если прочли. */
        String r = atWindowCmdWait("AT+BSS_BW=?\r\n", 300);
        int k = r.indexOf("+BSS_BW:");
        int bw = k >= 0 ? r.substring(k + 8).toInt() : -1;
        r = atWindowCmdWait("AT+CHAN_LIST=?\r\n", 300);
        k = r.indexOf("+CHAN_LIST:");
        int ch = k >= 0 ? r.substring(k + 11).toInt() : -1;
        if (BSS_BW_SET > 0 && bw > 0 && bw != BSS_BW_SET) {
            snprintf(buf, sizeof(buf), "AT+BSS_BW=%d\r\n", (int)BSS_BW_SET);
            atWindowCmd(buf);
            chan_written = true;
        }
        if (CHAN_SET > 0 && ch > 0 && ch != CHAN_SET) {
            snprintf(buf, sizeof(buf), "AT+CHAN_LIST=%d\r\n", (int)CHAN_SET);
            atWindowCmd(buf);
            chan_written = true;
        }
        SerialMon.printf("КАНАЛ: в модуле %d МГц на %d.%d МГц%s\n", bw, ch / 10, ch % 10,
                         chan_written ? " — ЗАПИСАН НОВЫЙ, действует со следующего включения питания"
                                      : (bw > 0 ? " — как задано" : " — не прочитан"));
    }
#endif
#if VAR_SWEEP
    {
        const uint8_t n = sizeof(var_sweep) / sizeof(var_sweep[0]);
        Preferences pr;
        pr.begin(VAR_SWEEP_NS, false);
        uint8_t i = pr.getUChar("i", 0);
        const var_step_t *v = &var_sweep[i % n];
        if (v->gap_us) {
            chunk_gap_us = v->gap_us;   /* и в незасчитанном шаге: так он и работает */
        }
        bool ok = at_window_answers >= 3 && !chan_written;
        /* 30.09: ответ на команду варианта на счёт шага не влияет — у ручек из
         * отладочной таблицы модуля (RC_NEW, LMAC_DBGSEL) формат ответа не
         * проверен, и без «OK» перебор застрял бы на одном шаге. Принята ли
         * команда — видно по её ответу строкой выше и по чтению после неё. */
        bool cmd_ok = true;
        for (uint8_t c = 0; c < 2; c++) {
            if (v->cmd[c]) {
                cmd_ok = (atWindowCmdWait(v->cmd[c], 300).indexOf("OK") >= 0) && cmd_ok;
            }
        }
        SerialMon.printf("ВАРИАНТ: шаг %u из %u, %s%s%s\n",
                         (unsigned)(i % n + 1), (unsigned)n, v->name,
                         ok ? "" : chan_written ? " — канал только что записан, шаг не засчитан"
                                                : " — ОКНО НЕ ОТКРЫЛОСЬ, шаг не засчитан",
                         cmd_ok ? "" : " — на команду варианта нет «OK», см. ответ выше");
        if (ok) {
            pr.putUChar("i", (uint8_t)(i + 1));
        }
        pr.end();
    }
    /* Что реально стоит после варианта: склейка, ожидание ACK, повторы, RTS. */
    atWindowCmd("AT+TX_MAX_AGG=?\r\n");
    atWindowCmd("AT+TX_AGG_AUTO=?\r\n");
    atWindowCmd("AT+ACK_TO=?\r\n");
    atWindowCmd("AT+TX_CNT_MAX=?\r\n");
    atWindowCmd("AT+SET_RTS=?\r\n");
#endif
    /* Читаем ПОСЛЕ возможной записи: в лог попадает то, что реально стоит. */
    atWindowCmd("AT+TX_MCS=?\r\n");
    atWindowCmd("AT+TX_MCS_MAX=?\r\n");
    atWindowCmd("AT+TX_MCS_MIN=?\r\n");
    atWindowCmd("AT+TX_RATE_FIXED=?\r\n");
    atWindowCmd("AT+ENCRYPT=?\r\n");
    atWindowCmd("AT+SSID=?\r\n");
    /* Измеренный фоновый уровень. Он не настройка, а показание, и по нему
     * видно, не уехал ли шум платы — см. комментарий к CCA_MARGIN_DB. */
    atWindowCmd("AT+SET_BGRSSI=?\r\n");
