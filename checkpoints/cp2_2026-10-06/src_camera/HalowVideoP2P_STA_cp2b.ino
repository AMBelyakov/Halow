 * (кадр старше кольца) — считается в lat_unmatched.
 */
#define LAT_RING      64
#define LAT_HIST_MS   100          /* шаг гистограммы возраста */
#define LAT_HIST_BINS 31           /* 0..3 с по 100 мс, последний — всё дольше */
typedef struct {
    uint32_t id;
    uint32_t cap_ms;
    uint32_t sent_ms;
} lat_slot_t;
static lat_slot_t lat_ring[LAT_RING];
static uint32_t   lat_next_cap_ms = 0;   /* съёмка кадра, который сейчас уйдёт */
static uint32_t   lat_acks = 0, lat_incomplete = 0, lat_unmatched = 0;
static uint64_t   lat_rtt_sum = 0, lat_age_sum = 0;
static uint32_t   lat_rtt_max = 0, lat_age_max = 0;       /* за период статистики */
static uint32_t   lat_rtt_min = 0xFFFFFFFFu;               /* за период статистики */
static uint32_t   lat_hist[LAT_HIST_BINS];
static uint32_t   lat_hist_print = 0;
/* 05.10: куски по квитанциям. Квитанция несёт chunks_got/chunk_cnt, новый
 * приёмник — ещё и список пришедших (chunk_mask), по нему видно, какой именно
