/*
 * HalowVideoP2P_STA — плата с камерой, прозрачный режим (uart_p2p).
 *
 * ЧЕМ ОТЛИЧАЕТСЯ ОТ HalowVideo_STA
 * Там каждый кусок кадра уезжал так: пишем в UART "AT+TXDATA=<len>", ждём "OK",
 * шлём len байт, ждём ответ, спим CHUNK_GAP_MS. То есть на каждые ~1.4 КБ данных
 * приходился разбор AT-команды, круговая задержка и фиксированная пауза.
 *
 * Здесь ничего этого нет. Прошивка 2.4.1.3 собрана с SYS_APP_UART_P2P=1, модуль
 * забирает UART1 себе и просто выдаёт всё записанное на другом конце линка.
 * Мы пишем байты — они выходят из UART приёмника. Никакого протокола с модулем.
 *
 * Скорость UART та же, 115200: её поднимает следующий шаг (UART_P2P_BAUDRATE).
 * Выигрыш этого шага — снятие пауз и круговых задержек AT, а не бод.
 *
 * ЧТО ЗА ЭТО ПОТЕРЯНО
 * AT-команд больше нет вообще: uart_p2p_init() делает uart_request_irq и
 * disable_print на том же UART1. Значит недоступны AT+CONN_STATE и AT+RSSI —
 * ни состояния связи, ни RSSI спросить не у кого. Поэтому:
 *   - поле rssi в halow_app_hdr_t всегда 0 (просмотрщик покажет прочерк);
 *   - живость связи определяется по обратному каналу: приёмник раз в секунду
 *     шлёт пакет типа 'S' со своими счётчиками, и это единственный признак,
 *     что нас кто-то слышит.
 * Для замеров RSSI/MCS остаётся сборка шага 2 (SYS_APP_UART_P2P=0), где AT жив.
 *
 * ОКНО ПРИ СТАРТЕ — НЕ ТРОГАТЬ
 * Прозрачный режим включается не сразу, а через UART_P2P_START_DELAY_MS
 * после загрузки модуля. Всё это время UART1 держит atcmd, и туда же модуль
 * печатает загрузочный лог. Окно существует ради AT+NOP2P: это единственный
 * способ вернуть AT-режим и перепрошить модуль, не вынимая флеш (см.
 * SDK/builds/STEP3_2026-08-13.txt). Поэтому первые P2P_WINDOW_MS мс мы молчим.
 *
 * Точное значение задержки зависит от залитой сборки и объявлено ниже
 * как MODULE_P2P_DELAY_MS. Держать его в согласии с прошивкой обязательно:
 * см. предупреждение там же.
 */

#include <Arduino.h>
#include "utilities.h"
#include "esp_camera.h"
#include "driver/ledc.h"      // опыт: остановка такта XCLK сенсора
#include "img_converters.h"   // fmt2jpg() — программное сжатие, сенсор JPEG не отдаёт
#include "esp_jpeg_enc.h"     // esp_new_jpeg — см. NEW_JPEG (путь в platformio.ini)
#include "esp_heap_caps.h"    // heap_caps_malloc() и порог malloc между SRAM и PSRAM
#include "halow_stream.h"
#include <Preferences.h>       // номер шага перебора MCS (MCS_SWEEP)

/*
 * ЛОГ КАМЕРЫ ПО ВОЗДУХУ (28.09): 1 — всё, что камера печатает в консоль,
 * копируется в кольцо и уезжает на приёмник пакетами 'T' (HALOW_P2P_TYPE_LOG)
 * тем же каналом, что и видео. Приёмник отдаёт их в USB записью 'L',
 * просмотрщик пишет tools/logs/cam_air_ДАТА_ВРЕМЯ_метка.txt — тот же текст,
 * что пишет cam_console.py, — и показывает хвост лога на своей странице.
 *
 * Зачем. Камере больше не нужен ноутбук: на столе она живёт от powerbank,
 * на БПЛА ноутбука нет в принципе, а наземная станция и так сидит у ПК.
 *
 * USB-консоль при этом НЕ ждёт хоста: ожидание записи 0 и буфер 8 КБ. Иначе
 * без ноутбука каждая печать стояла бы до 100 мс (ядро 2.0.9, HWCDC), а
 * печать идёт в том числе из pumpRx, то есть из тракта передачи.
 *
 * До связи текст копится в кольце AIRLOG_RING (загрузка, стартовое окно,
 * ожидание приёмника) и уезжает, как только приёмник отозвался. Кольцо
 * полно — новый текст выбрасывается, в лог встаёт отметка о пропуске.
 * Цена — эфир: в работе консоль даёт ~0,5–1 КБ/с, около 1 % канала.
 */
#define AIR_LOG          1
#define AIRLOG_RING      32768   /* байт; до связи копится ~30 с консоли */
#define AIRLOG_CHUNK     1024    /* текста в одном пакете 'T' */
#define AIRLOG_MIN_MS    100     /* не чаще одного пакета за столько мс */
#define AIRLOG_FLUSH_MS  500     /* неполный пакет ждёт добора не дольше */

#if AIR_LOG
static uint8_t  airlog_ring[AIRLOG_RING];
static volatile uint32_t airlog_head = 0;   /* свободно бегущие счётчики */
static volatile uint32_t airlog_tail = 0;
static uint32_t airlog_lost = 0;            /* выброшено с последней отметки */
static uint32_t airlog_lost_total = 0;
static portMUX_TYPE airlog_mux = portMUX_INITIALIZER_UNLOCKED;

static void airlog_copy_in(const uint8_t *b, uint32_t n)
{
    uint32_t pos = airlog_head % AIRLOG_RING;
    uint32_t first = AIRLOG_RING - pos;
    if (first > n) first = n;
    memcpy(airlog_ring + pos, b, first);
    memcpy(airlog_ring, b + first, n - first);
    airlog_head += n;
}

/* Зовётся из обоих ядер (loop и camera_task), отсюда спинлок. */
static void airlog_put(const uint8_t *b, size_t n)
{
    portENTER_CRITICAL(&airlog_mux);
    uint32_t used = airlog_head - airlog_tail;
    if (airlog_lost) {
        char mark[80] = "\n[лог: пропущено ";
        size_t k = strlen(mark);
        utoa(airlog_lost, mark + k, 10);
        strcat(mark, " байт]\n");
        k = strlen(mark);
        if (used + k + n <= AIRLOG_RING) {
            airlog_copy_in((const uint8_t *)mark, k);
            used += k;
            airlog_lost = 0;
        }
    }
    if (!airlog_lost && used + n <= AIRLOG_RING) {
        airlog_copy_in(b, n);
    } else {
        airlog_lost += n;
        airlog_lost_total += n;
    }
    portEXIT_CRITICAL(&airlog_mux);
}

/* Консоль: USB как раньше плюс копия в кольцо. Подменяет SerialMon ниже. */
class AirMon : public Stream {
public:
    void begin(unsigned long baud) { Serial.begin(baud); }
    void setTxTimeoutMs(uint32_t ms) { Serial.setTxTimeoutMs(ms); }
    void setTxBufferSize(size_t n) { Serial.setTxBufferSize(n); }
    int available() override { return Serial.available(); }
    int read() override { return Serial.read(); }
    int peek() override { return Serial.peek(); }
    void flush() override { }          /* ждать хоста нельзя, см. halow_mon_settle */
    size_t write(uint8_t c) override { return write(&c, 1); }
    size_t write(const uint8_t *b, size_t n) override
    {
        airlog_put(b, n);
        Serial.write(b, n);
        return n;
    }
    using Print::write;
};
static AirMon airMon;
#undef SerialMon
#define SerialMon airMon
#endif

