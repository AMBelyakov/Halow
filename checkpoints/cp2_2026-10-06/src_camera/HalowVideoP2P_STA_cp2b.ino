#define CHUNK_PAYLOAD 1400

/*
 * ПОДБОР РАЗМЕРА ЧАНКА: 1 — перебирать значения и складывать результат в CSV.
 *
 * Приёмнику знать размер не нужно: каждый чанк несёт свою длину, а кадр —
 * общее число чанков. Поэтому размер можно менять на ходу, ничего не
 * перепрошивая на той стороне.
 *
 * Действующее значение едет в поле rssi заголовка (делённое на 20, чтобы
 * влезть в знаковый байт) и попадает в CSV в столбец sta_rssi. Умножь на 20
 * и получишь байты: 70 -> 1400, 35 -> 700, 23 -> 460, 13 -> 260.
 */
#define PAYLOAD_SWEEP    0
#define PSWEEP_STEP_MS   20000
#define PSWEEP_SETTLE_MS 5000

#define STATS_PERIOD_MS 2000
#define LINK_TIMEOUT_MS 5000   // нет 'S' от приёмника дольше — считаем связь потерянной

/*
 * НЕ ВЕЩАТЬ ВСЛЕПУЮ: ждать первого 'S' от приёмника, прежде чем начать поток.
 *
 * До 27.08 камера начинала лить видео сразу после стартового окна, независимо
 * от того, есть связь или нет (комментарий «курица и яйцо» в captureFrame).
 * Курицы с яйцом здесь на самом деле нет: приёмник шлёт свой отчёт 'S' раз в
 * секунду безусловно, ему для этого ничего от нас не нужно. А получить этот
 * отчёт камера может только будучи ассоциированной — значит первый 'S' и есть
 * доказательство связи, причём единственное доступное на прозрачной прошивке.
 *
 * Зачем это нужно. Пока связи нет, поток всё равно никуда не доезжает, зато
 * модуль камеры занят: 18 КБ/с в UART, разбор, попытки отправки. Молчащий
 * модуль имеет заметно больше шансов спокойно отсканировать эфир и пройти
 * ассоциацию. Заодно исчезает целый класс вопросов «мешает ли наш поток
 * подключению» — теперь не мешает по построению.
 *
 * Побочная польза для диагностики: строка «жду отчёта приёмника, N с» в
 * консоли прямо говорит, что ассоциация не состоялась. Раньше на её месте были
 * бодрые fps, за которыми не стояло ни одного доехавшего байта.
 *
 * HELLO_WAIT_MAX_MS = 0 — ждать бесконечно (так и надо на отладочном стенде:
 * молчание камеры и есть результат замера). Ненулевое значение — аварийный
 * клапан: столько миллисекунд подождать и начать вещать вслепую, как раньше.
 */
#define WAIT_FOR_HELLO     1
#define HELLO_WAIT_MAX_MS  0

/*
 * Период маячка, пока ждём первого отчёта. 0 — не слать вовсе (то поведение,
 * которое 01.09 дало вечное ожидание).
 *
 * ИСПРАВЛЕНИЕ К КОММЕНТАРИЮ ВЫШЕ. Там сказано, что курицы с яйцом нет, потому
 * что приёмник шлёт отчёт безусловно. Это верно только про приёмник. Про
 * камеру — нет: в прозрачном режиме её модуль формирует пакеты из того, что
 * пришло в UART, и без данных ассоциацию не форсирует.
 *
 * Измерено: камера молчала 240 с, приёмник всё это время показывал RSSI 0 и
 * sta_cnt 0 при пустой очереди — то есть не слышал её ни разу. Связь не
 * вставала, потому что нечему было её начать.
 *
 * Секунда выбрана как заведомо достаточная и заведомо дешёвая: 11 байт на
 * пакет против 19 КБ/с потока — влияние на занятость эфира пренебрежимое,
 * ровно то, ради чего гейт и вводился.
 */
#define HELLO_PROBE_MS     1000

/*
 * Прекращать ли поток, если отчёты приёмника пропали.
 *
 * По умолчанию 0, и это осознанно. Обратный канал глохнет, пока передатчик
 * занимает эфир: 15.08 замерено, что доходило около 10% отчётов. При периоде
 * 1 с это значит «в среднем один отчёт в десять секунд», и короткий таймаут
 * загонит скетч в качели «пошёл поток — отчёт потерялся — встал — пришёл
 * отчёт — пошёл». Поэтому гейт работает только на СТАРТ: важно не вещать до
 * ассоциации, а обрыв уже установленной связи ловится по link_up и виден в
 * логе. Включать только вместе с заведомо большим HELLO_LOST_MS.
 */
#define RESTREAM_ON_HELLO_LOSS 0
#define HELLO_LOST_MS          30000

/*
 * ДИАГНОСТИКА: 1 — снять один кадр при старте и слать его по кругу.
 *
 * Нужно, чтобы отделить порчу картинки в камере от порчи в передаче. Байты на
 * входе передатчика перестают меняться, и картинка на экране отвечает сама:
 *   полосы на одних и тех же местах  -> испорчен исходный JPEG, виновата камера
 *   полосы каждый раз новые          -> портит наш путь (UART/радио/сборка)
 *   картинка чистая                  -> камера портит кадры по-разному
 *
 * В рабочем режиме держать 0.
 */
#define TEST_PATTERN 0

/*
 * СИНТЕТИЧЕСКИЙ ИСТОЧНИК (28.09): 1 — снять один кадр при старте и гонять его
 * копии через обычный конвейер с окном FC_WINDOW. Камера и кодер в замере не
 * участвуют, поэтому упираемся в канал: UART с паузами между чанками, модуль,
 * эфир, приёмник, подтверждения. Отличие от TEST_PATTERN: тот шлёт в обход
 * окна и конвейера и меряет порчу, а этот — потолок канала в рабочем тракте.
 *
 * Зачем. С окном W=3 канал на столе простаивал: окно закрыто 3 % времени,
 * упор в сжатие (~20 к/с по 3,4 КБ = 0,54 Мбит/с). Расчёт в журнале (раздел 8)
 * даёт потолок провода 1,45 Мбит/с при паузе 3 мс — это и проверяем.
 *
 * В рабочем режиме держать 0.
 */
#define SYNTH_SOURCE 0   /* 29.09: живая камера, два кодировщика */

/*
 * СИНТЕТИКА БЕЗ КАМЕРЫ (30.09): 1 — камера не запускается вовсе, кадр для
 * синтетики — SYNTH_NOCAM_LEN байт из памяти (FF D8 ... FF D9, внутри шум).
 * Видео нет, меряется только радио. Зачем: 29.09 при перестановке плат на
 * плате Б сенсор отдавал пустые кадры («шершавость 0.00»), драйвер сыпал
 * EV-VSYNC-OVF сотнями в секунду и душил ESP32 — стартовое окно модуля не
 * открылось (0 ответов OK), пакеты рвались посреди чанка.
 */
#define SYNTH_NOCAM     0
#define SYNTH_NOCAM_LEN 8400

/*
 * ОПЫТ ПО ВРЕМЕНИ (29.09): 1 — после подъёма связи камера сама проходит этапы
 * exp_steps и в конце каждого печатает строку «ОПЫТ ИТОГ». Всё за одно
 * включение питания: камера стоит в 5 м, ходить к ней не нужно.
 *
 *   Q60/Q80/Q90 — качество JPEG на живом видео. В 5 м канал берёт ~960
 *     кбит/с, а камера отдаёт ~435: сенсор на 320x240 даёт кадр раз в
 *     126 мс, fps не поднять, значит поток растёт только размером кадра.
 *   СИНТ сенсор вкл/ВЫКЛ — синтетика (один кадр по кругу), такт XCLK
 *     сенсора остановлен или идёт. Повторы — это неуслышанные подтверждения
 *     (to(frm) при нуле промахов CTS), а фон у камеры около −60 дБм против
 *     −87 у приёмника: плата шумит. Затихнет шлейф — станет ли меньше повторов?
 *   СИНТ кусок 700/350 — зависят ли повторы от длины пакета в эфире.
 *
 * Первые EXP_WARM_MS каждого этапа не считаются (переходный процесс). После
 * последнего — живое видео с настройками по умолчанию. RTS меняется только в
 * стартовом окне — он в VAR_SWEEP, по включениям питания.
 *
 * 29.09 вечер: этапы — окно W и пауза после пакета на синтетике, потом живое
 * видео с автокачеством (AUTO_Q). Поля win/gap_us/autoq в exp_step_t.
 */
#define EXP_PROGRAM   0   /* 29.09 вечер: рабочая прошивка — опыты выключены, см. журнал */
#define EXP_SETTLE_MS 20000   /* от подъёма связи до первого этапа: регулятор мощности */
#define EXP_WARM_MS   10000   /* начало этапа, которое не считаем */
typedef struct {
    const char *name;
    uint8_t     synth;      /* 1 — синтетика */
    uint8_t     xclk_off;   /* 1 — такт сенсора остановлен (только с синтетикой) */
    uint16_t    chunk;      /* байт полезной нагрузки в пакете */
    uint8_t     q;          /* качество JPEG (с autoq — стартовое) */
    uint16_t    secs;
    uint8_t     win;        /* окно кадров в полёте */
    uint16_t    gap_us;     /* пауза после пакета, мкс */
    uint8_t     autoq;      /* 1 — качество подбирает AUTO_Q */
    uint8_t     pll;        /* 1 — такт сенсора CAM_PLL_MUL, 0 — как у драйвера (06.10) */
    uint8_t     drv;        /* 1..4 — сила выходов сенсора ×1..×4, 0 — не трогать (06.10) */
    uint8_t     gate;       /* паузы передачи: 0 — как GATE_FORCE, 1 — выкл, 2 — вкл (06.10) */
} exp_step_t;
static volatile bool synth_on = SYNTH_NOCAM;         /* синтетика включена опытом */
static uint8_t  jpeg_q_rt = JPEG_QUALITY_SW;   /* качество JPEG сейчас */

/*
 * АВТОКАЧЕСТВО JPEG (29.09): 1 — камера сама подбирает качество под канал.
 *
 * Зачем. Канал в одной и той же точке гулял от 250 до 987 кбит/с. С
 * постоянным качеством на плохом канале видео встаёт (Q90 при включённом
 * RTS: 1,5 к/с, RTT 1,5 с), а на хорошем качество недобирает.
 *
 * Как. Раз в секунду по подтверждениям: средний RTT, списанные по таймауту,
 * сколько окно было закрыто при готовом кадре (канал не успевает за камерой).
 *   таймаут, RTT > AUTOQ_RTT_BAD или ни одной квитанции при кадрах в пути
 *                                          -> на две ступени вниз;
 *   RTT > AUTOQ_RTT_HI или окно закрыто > AUTOQ_BLOCK_HI мс из 1000
 *                                          -> на ступень вниз;
 *   три секунды подряд RTT < AUTOQ_RTT_LO и окно почти не закрыто
 *                                          -> на ступень вверх.
 * Ступени autoq_ladder. Вниз быстро, вверх медленно — чтобы не качало. С
 * паузами съёмки (GATED_CAPTURE) окно не считаем: кадров меньше из-за пауз,
 * а не из-за канала. В синтетике выключено.
 *
 * 2 (05.10, для ROLE_SWAP) — без штрафа за одиночный списанный кадр. Камера-точка
 * теряет ~10 % квитанций (приёмник-клиент шлёт их адресно, с повторами), и правило
 * «таймаут — две ступени вниз» роняло качество каждые несколько секунд: за 6 мин
 * 128 смен, скорость гуляла 300–750 кбит/с вслед за Q. Теперь списанные кадры —
 * ступень вниз, только если их два и больше за секунду; остальное как в 1.
 *
 * 3 (06.10, для ROLE_SWAP) — квитанции только мерка очереди модуля, их потеря не
 * штраф. Ночью 05.10 Q падал с 70 до 37–53 не от канала: видео доходило (кусков
 * пропадало 3–4 %), а квитанций 63–74 %. Разбор 379 шагов вниз: половина — RTT
 * 350–600 (среднее за секунду тянут вверх запоздалые квитанции), остальное —
 * окно, закрытое потерянными квитанциями, и «ни одной квитанции за секунду».
 * Правила 3:
 *   RTT — МЕДИАНА за секунду и без запоздалых квитанций (последний кусок пропал,
 *         приёмник ответил по первому куску следующего кадра — по chunk_mask);
 *   медиана > AUTOQ_RTT_BAD -> на две вниз, > AUTOQ_RTT_HI -> на одну;
 *   окно закрыто > AUTOQ_BLOCK_HI — на одну, только если и медиана > AUTOQ_RTT_LO
 *         (окно держит медленная очередь, а не потерянные квитанции);
 *   ни одной квитанции две секунды подряд — на одну (было: одна секунда — на две);
 *   списанные кадры не в счёт вовсе; вверх — три секунды медиана < AUTOQ_RTT_LO;
 *   кадр без квитанции окно списывает через FC_ACK_TIMEOUT3_MS, а не 1,5 с.
 *
 * 4 (06.10, для ROLE_SWAP) — как 3, но одиночный всплеск задержки не в счёт. Прогон
 * swap4: RTT от Q не зависит (медиана 141–208 мс при Q 30…90, всплески > 350 мс в
 * 10–18 % секунд при ЛЮБОМ Q) — канал не забит, всплески приходят не из радио, а
 * правило «медиана > 350 — вниз» дало 50 из 67 шагов вниз; Q в среднем ~50,
 * ~450 кбит/с против 783 ночью на том же месте. АК3 против АК2 — только +4 %.
 * Правила 4:
 *   медиана > AUTOQ_RTT_HI три секунды подряд — на одну вниз (очередь правда растёт);
 *   медиана > AUTOQ_RTT_BAD две секунды подряд — на две;
 *   ни одной квитанции две секунды подряд — на одну, как в 3;
 *   окно не в счёт (закрывают его потерянные квитанции); вверх — как в 3.
 */
#define AUTO_Q          (ROLE_SWAP ? 4 : 1)
/* 06.10 вечер (выбор пользователя): мягкие пороги — вниз только при задержке больше
 * 600 мс. Было 200/350/600: Q падал от всплесков задержки квитанций, а не от канала. */
#define AUTOQ_RTT_LO    300    /* мс */
#define AUTOQ_RTT_HI    600
#define AUTOQ_RTT_BAD   1000
#define AUTOQ_BLOCK_LO  150    /* мс из 1000 */
#define AUTOQ_BLOCK_HI  400
static volatile uint8_t autoq_on = AUTO_Q;   /* 0 — выкл, 1 / 2 / 3 — правила, см. AUTO_Q */
/* 06.10, правила 3: RTT квитанций за секунду — для медианы. Запоздалые сюда не
 * попадают, их считает aq_late. Наполняет lat_on_ack, опустошает autoq_tick. */
#define AQ_RTT_MAX 24
static uint16_t aq_rtt_buf[AQ_RTT_MAX];
static uint8_t  aq_rtt_n = 0;
static uint32_t aq_late = 0;
/* Шаги вниз по причинам (все правила): RTT>BAD, нет квитанций, RTT>HI, окно, списания,
 * мало кадров (07.10, AQ_FPS_MIN). */
static uint32_t aq_why[6] = { 0, 0, 0, 0, 0, 0 };
/*
 * НИЖНИЙ ПРЕДЕЛ КАДРОВ В СЕКУНДУ (07.10). Правила 3 и 4 смотрят только на задержку
 * квитанций. На чистом канале она мала, и Q уходил к 90–95: на 480×320 это кадр
 * 45–60 КБ и 1,7 к/с (чекпоинт 2 на 14 дБм, 06.10 22:59, Q90 57 % времени). Теперь
 * вверх — только если камера отдаёт не меньше AQ_FPS_UP к/с, а меньше AQ_FPS_MIN три
 * секунды подряд — ступень вниз. Не ниже AQ_FPS_Q_FLOOR: если кадров мало не из-за
 * размера (паузы передачи, сенсор), опускать дальше незачем — это дело правил задержки.
 */
#define AQ_FPS_MIN      4
#define AQ_FPS_UP       5
#define AQ_FPS_Q_FLOOR  50
static uint32_t aq_fr0 = 0, aq_last_fps10 = 0;
static uint32_t exp_tx0_kb = 0;                /* счётчик эфира модуля (tx0 data=), КБ */
static uint32_t exp_air_sum = 0, exp_per_sum = 0, exp_mcs_sum = 0, exp_mod_n = 0;

/*
 * ДИАГНОСТИКА: 1 — проверять, не меняется ли буфер кадра во время сжатия.
 *
 * Считаем CRC буфера до frame2jpg и сразу после. Кадр наш на всё это время:
 * мы держим его до esp_camera_fb_return. Если CRC разошлась — значит DMA
 * камеры продолжает писать в буфер, который драйвер уже отдал нам, и JPEG
 * кодируется с полудописанного кадра. Это и есть радужные полосы.
 *
 * ВНИМАНИЕ, чего эта проверка НЕ ловит: если драйвер отдал уже недописанный
 * кадр, а DMA ушёл писать в другой буфер, содержимое неподвижно и при этом
 * битое — CRC до и после совпадут. Для этого случая есть CHECK_ENCODER ниже.
 *
 * Стоит около 25 мс на кадр, в рабочем режиме держать 0.
 */
#define CHECK_FB 0

/*
 * ДИАГНОСТИКА: 1 — сжать один и тот же кадр дважды и сравнить результаты.
 *
 * Кодировщик детерминирован: из одинакового входа обязан выйти побайтно
 * одинаковый JPEG. Расхождение означает, что портит сам frame2jpg. Совпадение
 * при битой картинке означает обратное — кадр пришёл к нам уже рваным, и
 * виноват драйвер камеры.
 *
 * Стоит ещё одно сжатие на кадр, в рабочем режиме держать 0.
 */
#define CHECK_ENCODER 0

/*
 * ДИАГНОСТИКА: 1 — проверять, не менялся ли кадр во время копирования в SRAM.
 *
 * От гонки за PSRAM осталось одно окно: пока мы читаем 84 КБ, DMA камеры пишет
 * очередной кадр в соседний буфер. Окно короткое — единицы миллисекунд против
 * шестидесяти у кодировщика, — но если полосы вернутся, надо знать, оно ли.
 *
 * Считаем CRC исходного буфера ПОСЛЕ копирования и CRC копии. Разошлись —
 * значит в буфер писали, пока мы его читали, и окно ещё живо. Совпали — окно
 * ни при чём, искать надо дальше.
 *
 * Стоит два прохода по 84 КБ на кадр, в рабочем режиме держать 0.
 *
 * 15.09 ВКЛЮЧЕНО. К этому моменту провод оправдан полностью: просмотрщик
 * сверяет CRC собранного кадра (14.09), и за прогон 647 кадров frame_crc_err
 * остался нулём при ap_crc_err 0. Значит до экрана доезжает ПОБАЙТНО тот JPEG,
 * который здесь сжался, — радуга рождается на этой плате, до передачи.
 * На плате два подозреваемых: копия 84 КБ из PSRAM в SRAM (эта проверка) и сам
 * frame2jpg (CHECK_ENCODER). Начинаем с копии: она дешевле и её исход виден в
 * той же периодической печати, без отдельного инструмента.
 *
 * 15.09 ОТВЕТ ПОЛУЧЕН, ВЕРСИЯ ЗАКРЫТА. Прогон с радугой на экране:
 *     КОПИЯ В SRAM: проверено 71, оригинал менялся во время копирования 0
 * Ни одного расхождения при заведомо битой картинке. Окно в 2 мс чистое,
 * возвращаем 0 — два прохода по 84 КБ на кадр больше не нужны.
 *
 * Чего это НЕ доказывает: если драйвер отдал уже рваный, но неподвижный буфер,
 * обе суммы сойдутся. Именно этот случай и разбирает DUMP_RAW ниже.
