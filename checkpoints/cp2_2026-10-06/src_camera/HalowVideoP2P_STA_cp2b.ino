#if DUMP_RAW || CHECK_FB || CHECK_COPY
/*
 * Контрольная сумма буфера произвольной длины. halow_crc16 берёт длину 16 бит,
 * а кадр 84 КБ, поэтому идём кусками по 32 КБ и мешаем результаты (сдвиг —
 * чтобы куски не сокращали друг друга). Одна на все диагностики: выгрузку
 * сырых кадров, проверку буфера камеры и проверку копии в SRAM.
 */
static uint16_t big_crc(const uint8_t *p, size_t len)
{
    const size_t step = 32768;
    uint16_t acc = 0;
    size_t off = 0;

    while (off < len) {
        size_t n = len - off;
        if (n > step) {
            n = step;
        }
        acc = (uint16_t)(acc ^ halow_crc16(p + off, (uint16_t)n));
        acc = (uint16_t)((acc << 1) | (acc >> 15));
        off += n;
    }
    return acc;
}
#endif

#if DUMP_RAW
static uint32_t dump_counter = 0;

/*
 * Формат записи в USB:
 *   [0xA5][0x5A]['R'][w16][h16][len32][данные][crc16]
 * Маркер тот же, что у остальных наших потоков, чтобы разборщик на ПК мог
 * пересинхронизироваться после текстовых строк лога.
 */
static void dumpRawFrame(const camera_fb_t *fb)
{
    uint8_t hdr[11];
    uint16_t crc = big_crc(fb->buf, fb->len);

    hdr[0] = HALOW_P2P_SYNC0;
    hdr[1] = HALOW_P2P_SYNC1;
    hdr[2] = 'R';
    hdr[3] = (uint8_t)(fb->width & 0xff);
    hdr[4] = (uint8_t)(fb->width >> 8);
    hdr[5] = (uint8_t)(fb->height & 0xff);
    hdr[6] = (uint8_t)(fb->height >> 8);
    hdr[7] = (uint8_t)(fb->len & 0xff);
    hdr[8] = (uint8_t)((fb->len >> 8) & 0xff);
    hdr[9] = (uint8_t)((fb->len >> 16) & 0xff);
    hdr[10] = (uint8_t)((fb->len >> 24) & 0xff);

    SerialMon.write(hdr, sizeof(hdr));
    SerialMon.write(fb->buf, fb->len);
    uint8_t tail[2] = {(uint8_t)(crc & 0xff), (uint8_t)(crc >> 8)};
    SerialMon.write(tail, sizeof(tail));
}

#if DUMP_JPEG
/*
 * Тот же формат, но тип 'J' и в полях ширины/высоты нули: размер берётся из
 * самого JPEG. Идёт сразу за сырым кадром, то есть это ровно тот JPEG, который
 * сделан из только что выгруженных байт.
 */
static void dumpJpegFrame(const uint8_t *jpg, size_t len)
{
    uint8_t hdr[11];
    uint16_t crc = big_crc(jpg, len);

    hdr[0] = HALOW_P2P_SYNC0;
    hdr[1] = HALOW_P2P_SYNC1;
    hdr[2] = 'J';
    hdr[3] = 0; hdr[4] = 0;
    hdr[5] = 0; hdr[6] = 0;
    hdr[7] = (uint8_t)(len & 0xff);
    hdr[8] = (uint8_t)((len >> 8) & 0xff);
    hdr[9] = (uint8_t)((len >> 16) & 0xff);
    hdr[10] = (uint8_t)((len >> 24) & 0xff);

    SerialMon.write(hdr, sizeof(hdr));
    SerialMon.write(jpg, len);
    uint8_t tail[2] = {(uint8_t)(crc & 0xff), (uint8_t)(crc >> 8)};
    SerialMon.write(tail, sizeof(tail));
}
#endif
