/*
 * Скорость UART ESP32 <-> модуль. Должна совпадать с UART_P2P_BAUDRATE в
 * залитом bin.
 *
 * 230400, а не 460800. Причина не в наших измерениях — на 460800 брака не было
 * вовсе, — а в документации вендора: TXSDK_AT указывает для скорости UART
 * диапазон 9600-400K и предупреждает, что выше UART-BUS может работать
 * некорректно. 460800 лежит за этой границей, и на защите такое обосновать
 * нечем. 230400 — внутри диапазона.
 *
 * Стартовое окно всегда идёт на 115200 (в atcmd.c:242 скорость зашита
 * литералом), поэтому порт переоткрывается после окна.
 */
#define AT_BAUD   115200   // скорость стартового окна (жёстко 115200 в прошивке)
#define P2P_BAUD  3000000   // ДОЛЖНА совпадать с UART_P2P_BAUDRATE залитого bin
                           // 24.09: модули на 3000000 с патчем кольца 8 КБ (запас 27.3 мс).
                           // Чанк поднять НЕЛЬЗЯ: 1400 — предел эфирного
                           // кадра модуля (1500 Б), см. halow_stream.h:175.
                           // Поэтому пауза 6 мс платится с каждых 1400 Б.
                           // Прежде:
                           // (APP_..._2026-09-24_step3-1000000-RING8K_...bin).
                           // 96e6/1000000 = 96 ровно, ошибка частоты 0%.
                           // Откат на 384000 — и прошивку модуля откатывать тоже.

/*
 * ЗАДЕРЖКА ПРОЗРАЧНОГО РЕЖИМА В ЗАЛИТОЙ ПРОШИВКЕ МОДУЛЯ.
 *
 * Это не наш параметр, а копия UART_P2P_START_DELAY_MS из project_config.h той
 * сборки, что лежит в модуле ЭТОЙ платы. Держать в согласии обязательно.
 *
 * 30000, ПРОВЕРЕНО ОПРОСОМ 27.08, а не предположено. В модуле этой платы
 * лежит сборка delay30s:
 *
 *     AT+VERSION -> v2.4.1.3-43933, app:0
 *     AT+SYSCFG  -> hgSDK-v2.4.1.3-43933, app-0, build time:Aug 25 2026 17:48:12
 *
 * Это APP_2.4.1.3-43933_2026-08-25_step3-230400-delay30s-nonetlog.bin.
 * Не delay180s от 26.08, как считалось: в приёмник её залили, в камеру — нет.
 *
 * Отсюда важный метод: слот и время сборки модуль сообщает сам. Раньше вопрос
 * «какая из двух сборок реально поднялась» считался неразрешимым и породил
 * пробу AT+VERSION на 15-й секунде (ниже, LINK_DIAG). Проба остаётся полезной
 * как быстрый признак, но точный ответ даёт AT+SYSCFG через мост.
 *
 * ПЕРЕД КАЖДОЙ СМЕНОЙ ПРОШИВКИ МОДУЛЯ сверять это число со временем сборки.
 * Окно скетча меньше задержки — двоичный поток уходит в живой разборщик AT;
 * больше — просто теряется время, это безопасно.
 */
#define MODULE_P2P_DELAY_MS 30000

// Молчим на 3 с дольше модуля: если ESP32 стартовал раньше него, запас съест
// разницу. Меньше задержки модуля ставить НЕЛЬЗЯ, см. выше.
#define P2P_WINDOW_MS (MODULE_P2P_DELAY_MS + 3000)

// Мастер-выключатель всего, что скетч делает с модулем в стартовом окне.
#define USE_AT_WINDOW 1

/*
 * 27.08: ОКНО РАЗДЕЛЕНО НА ЧТЕНИЕ И ЗАПИСЬ.
 *
 * Раньше оба скетча при каждой загрузке переписывали конфигурацию модуля:
 * MCAST_BW, MCAST_MCS, ENCRYPT, TXPOWER. Восемь команд по 300 мс — это секунды
 * 1-6 жизни модуля, ровно то время, когда идёт ассоциация. Что при этом делает
 * AT+ENCRYPT на точке доступа, описано ниже: пересобирает ключи, удаляет GTK и
 * роняет интерфейс. Прогон 26.08 умер именно там — станция подключилась на
 * 3.36 с и к 10-й секунде исчезла.
 *
 * Пока стартовый скрипт остаётся частью прогона, прибор возмущает объект и
 * прогоны несравнимы. Поэтому запись выключена: конфигурация ставится ОДИН РАЗ
 * с терминала (tools/halow_at.py setup) и живёт во флеше.
 *
 * AT_WINDOW_WRITE  — команды, меняющие радио, ключи или флеш. По умолчанию 0.
 * AT_WINDOW_LOGCFG — только AT+SYSDBG и AT+PRINT_PERIOD. Они меняют
 *                    многословность печати LMAC и ничего больше: полей в
 *                    struct sys_config под них нет, syscfg_save не зовётся,
 *                    во флеш не пишутся. Поэтому оставлены включёнными.
 * AT_WINDOW_READ   — читающие запросы. AT+SYSCFG вываливает конфигурацию
 *                    целиком, и она попадает в консольный лог прогона — это и
 *                    есть паспорт прогона со стороны модуля.
 */
#define AT_WINDOW_WRITE  0
#define AT_WINDOW_LOGCFG 1
#define AT_WINDOW_READ   1

/*
 * ЗАМЕР: шумит ли сенсор в собственный приёмник. 1 — мерить, 0 — обычный ход.
 *
 * Зачем. 01.09 выяснилось, что связь встаёт в 4 случаях из 7, и причина не в
 * рукопожатии, как я сначала решил, а в том, что до камеры **не доходит ответ
 * точки доступа на запрос подключения**. Её лог: WPA_ASSOCIATING ->
 * ieee80211_sta_assoc_timeout, до рукопожатия дело вообще не доходит. При этом
 * вверх всё работает: приёмник слышит камеру на −30 и станцию добавляет.
 *
 * Асимметрия направлений совпадает с разницей фона: модуль камеры намеряет
 * −60 дБм, модуль приёмника −85. Двадцать пять децибел — это шина DVP, PSRAM
 * и XCLK 20 МГц в сантиметрах от антенны. Оглушённый приёмник теряет одиночные
 * адресованные кадры, а маяки ловит, потому что они повторяются дважды в
 * секунду.
 *
 * НО: те −60 сняты через сервисный мост, который сенсор не инициализирует
 * вовсе. То есть фон был высоким и при выключенной камере, и версия про
 * «сенсор глушит» пока не доказана. Этот замер её и проверяет:
 *
 *   A — фон при работающем сенсоре (сюда setup приходит уже с камерой);
 *   B — фон через несколько секунд после esp_camera_deinit();
 *   C — фон после повторной инициализации.
 *
 * Если A и C около −60, а B заметно ниже — сенсор виноват, и лечение простое:
 * не включать его, пока связь не установилась. Если все три одинаковы — версия
 * неверна, шумит сама плата или антенна, и надо смотреть служебный тракт
 * (MCAST_BW/MCAST_MCS), которым и передаётся ответ на подключение.
 *
 * Пауза между замерами не случайна: модуль усредняет фон, AT+CCA_OBSV
 * показывает окно наблюдения 4 секунды.
 */
/*
 * ВЫКЛЮЧЕН 01.09, ПОСЛЕ ТОГО КАК ОТВЕТИЛ И СЛОМАЛ СТЕНД.
 *
 * Ответ: фон одинаков во всех трёх замерах, −60 дБм и с работающим сенсором,
 * и с выключенным. Камера собственный приёмник НЕ глушит, версия закрыта.
 *
 * Цена: с этим замером связь встала в 0 прогонах из 5 против 4 из 7 без него.
 * Лог камеры обрывается ровно на строке «B — сенсор выключен», то есть сразу
 * после esp_camera_deinit(), дальше перезагрузка и всё сначала. Выключение и
 * повторная инициализация сенсора на этой сборке не переживаются — плата
 * падает, до передачи дело не доходит.
 *
 * Урок общий: диагностика, вставленная в стартовое окно, вмешивается в то, что
 * измеряет. Замер, меняющий состояние железа, ставить в рабочий путь нельзя —
 * только отдельной сборкой, которую после ответа выбрасывают.
 */
#define NOISE_PROBE      0
#define NOISE_SETTLE_MS  6000

/*
 * ЗАПАС ПО ПОРОГУ ЗАНЯТОСТИ КАНАЛА, дБ. 0 — не трогать.
 *
 * На камере по умолчанию 0, и это осознанно. Проблема была на приёмнике: он
 * измеряет фоновый уровень около −87 дБм и потому считает канал занятым почти
 * всегда. У камеры тот же измеренный уровень около −60 — плата электрически
 * шумнее (шина DVP, PSRAM, XCLK 20 МГц), — и она передаёт свободно без всякого
 * запаса. Поднимать порог ещё и здесь значит делать передатчик невежливым без
 * нужды.
 *
 * Ручка оставлена, потому что уровень измеряется, а не задаётся: если камеру
 * переставить или экранировать, её фон уедет, и тогда запас понадобится.
 * Смотреть текущее значение — AT+SET_BGRSSI=? в читающем блоке ниже.
 * Настройка живёт только в ОЗУ и слетает при перезагрузке модуля.
 */
/*
 * 05.10: фон камеры теперь −100…−101 дБм (лог 30.09), а не −60, — плата больше
 * не шумнее приёмника. В опыте ROLE_SWAP камера — точка доступа, и ей нужен тот
 * же запас, что приёмнику-точке 28.08 (иначе не успевает ответить на запрос
 * подключения). Сам ROLE_SWAP объявлен ниже, у P2P_UNICAST.
 */
#define CCA_MARGIN_DB (ROLE_SWAP ? 20 : 0)

/*
 * ДИАГНОСТИКА ЛИНКА: 1 — спросить модуль, кто он и в каком режиме.
 *
 * Нужна, потому что прозрачный режим невозможно проверить изнутри: мы пишем
 * байты и не получаем на них никакого подтверждения. Если модуль остался в
 * AT-режиме, запись просто исчезает, а скетч продолжает показывать бодрые fps.
 */
#define LINK_DIAG 1

// 1 — ГЛУШИТЬ. Вернул 25.08, и это не косметика.
//
// В прошивке модуля включён netlog (SYS_APP_NETLOG=1): он дублирует ВЕСЬ лог
// модуля в сеть пакетами UDP. Пока к точке доступа никто не подключён, каждую
// такую строку отправить некому — netdev_send_data возвращает -1, lwIP печатает
// "Send to netdev error", и буфер не возвращается в пул.
//
// Замерено 25.08: пул из ~75 буферов выедается за 60 секунд, из них половина
// уходит за первые 4 секунды (загрузочный лог), дальше ровно по 0.6 буфера в
// секунду — это периодический дамп LMAC STATUS, пятнадцать строк каждые шесть
// секунд. С нулём буферов модуль не может передать даже ответ на запрос
// подключения, и связь перестаёт устанавливаться навсегда.
//
// Поставив здесь 0 ради диагностики, я открыл этот кран и на сутки лишил стенд
// связи. Ставить 0 можно только на короткий разбор и помня о цене.
#define QUIET_MODULE 1

/*
 * ШИРОКОВЕЩАТЕЛЬНЫЙ ТРАКТ — им идёт всё наше видео.
 *
 * Измерено 18.08 на живой прошивке: AT+MCAST_BW отвечал "tx bw=2 MHz",
 * AT+MCAST_MCS — "muticast tx mcs= 0". То есть видео шло в полосе 2 МГц из
 * доступных 8 и на самой нижней модуляции.
 *
 * Физическая скорость 802.11ah, один поток:
 *      2 МГц MCS0 —   650 кбит/с      8 МГц MCS0 —  2925
 *      2 МГц MCS7 —  5850             8 МГц MCS7 — 26000
 *
 * Почему это вообще так: uart_p2p шлёт кадры на адрес ff:ff:ff:ff:ff:ff.
 * Широковещательные кадры никто не подтверждает, значит нет ни повторов, ни
 * обратной связи — а без обратной связи модуль не может подбирать модуляцию и
 * ставит заведомо живучую. Отсюда же наши потери при нулевой порче байтов:
 * у каждого пакета ровно одна попытка.
 *
 * Эти два параметра, похоже, НЕ сохраняются между перезагрузками (в отличие от
 * AT+BSS_BW, который пишет в параметры). Поэтому выставляем их здесь, при
 * каждом старте, в том же окне, где ещё жив AT.
 *
 * ОСТОРОЖНО С MCS. 18.08: поставили MCAST_MCS=7, разнесли платы — связь
 * перестала УСТАНАВЛИВАТЬСЯ вовсе. Причина в том, что "multicast" здесь это
 * все кадры на широковещательный адрес, включая МАЯКИ точки доступа и обмен
 * при подключении. По маякам станция находит AP; на MCS 7 они добивают только
 * вплотную. То есть параметр бьёт не по скорости видео, а по самой связи.
 *
 * Поэтому MCS поднимать по одной ступени и каждый раз проверять, что платы
 * вообще сходятся на рабочей дистанции. Полоса (MCAST_BW) в этом смысле
 * безопаснее: 8 МГц совпадает с полосой самого канала.
 */

/*
 * 03.09: MCAST_BW поднят до 8, чтобы полоса сигнала совпала с BSS_BW=8.
 *
 * Зачем. При BSS_BW=8 и MCAST_BW=2 приёмник слушает вчетверо более широкую
 * полосу, чем занимает сигнал, и набирает вчетверо больше шума — около 6 дБ
 * впустую. Проверяем, вернёт ли согласование эти децибелы.
 *
 * Риск известен и измерен 01.09: при MCAST_BW=8 связь не встала (ok=0) —
 * "multicast" здесь это все кадры на широковещательный адрес, включая маяки.
 * Откат бесплатный: MCAST_BW и MCAST_MCS живут только в ОЗУ, снятие питания
 * возвращает 2.
 *
 * Блок вынесен из-под AT_WINDOW_WRITE по той же причине, что и CCA_MARGIN_DB:
 * эти две команды не пишут флеш и не пересобирают ключи, а без них замер
 * попросту не состоится. Всё остальное в окне по-прежнему не пишется.
 */
#define SET_MCAST  1       // 03.09: включён ради замера согласованной полосы

/*
 * ОДНОАДРЕСНАЯ ПЕРЕДАЧА: 1 — попросить модуль слать видео не «всем», а
 * персонально приёмнику.
 *
 * ЗАЧЕМ. uart_p2p шлёт кадры на широковещательный адрес. Такие кадры никто не
 * подтверждает: нет ни повторов, ни обратной связи, а без обратной связи
 * модуль не может подбирать модуляцию и обязан сидеть на MCS 0. Отсюда и
 * характер потерь — пакет пропадает целиком при нулевой порче байтов, потому
 * что попытка у него ровно одна. Назвав получателя, включаем штатные
 * подтверждения, повторы и автоподбор скорости.
 *
 * ЧЕМ ЭТО ДЕЛАЕТСЯ. Командой AT+P2PDEST, которой в заводской прошивке нет —
 * она добавлена в project/atcmd.c и собрана 15.09 (образ
 * SDK/builds/APP_..._p2pdest.bin, карточка P2PDEST_2026-09-15.txt). На старой
 * прошивке команда просто не ответит, и скетч продолжит работать
 * широковещательно — поэтому флаг безопасно держать включённым на обеих
 * платах.
 *
 * АДРЕС НЕ ЗАШИТ. Берём bssid из ответа AT+SYSCFG, который и так читается
 * строкой ниже: у станции bssid — это MAC точки доступа, то есть ровно тот,
 * кому мы и шлём. Зашитый адрес разошёлся бы с железом при первой же замене
 * платы, а у нас модуль камеры уже меняли 14.09.
 *
 * ОТКАТ без перепрошивки: поставить 0 — и скетч команду не пошлёт, транспорт
 * останется широковещательным. В самом модуле переключение тоже обратимо
 * командой AT+P2PDEST=ff:ff:ff:ff:ff:ff.
 *
 * 05.10: при ROLE_SWAP выключено само. У точки доступа bssid — её же MAC:
 * скетч назначил бы получателем самого себя, и в эфир не ушло бы ничего.
 */
#define P2P_UNICAST  (!ROLE_SWAP)

/*
 * СМЕНА РОЛЕЙ (05.10): 1 — модуль камеры работает точкой доступа (ползунок AP
 * на плате камеры), модуль приёмника — клиентом (ползунок STA на его плате).
 *
 * Зачем. Опыт 30.09 (var0930bc): «всем» от клиента в эфире не вещание — клиент
 * отдаёт кадр точке адресно, с подтверждением и повторами (PER tx0 81–87 %), а
 * точка потом рассылает копию. Напрямую, без подтверждений и повторов, вещает
 * только точка доступа. Главный вопрос опыта: доходят ли куски с первой
 * попытки, когда повторов нет вовсе. Ответ — строка «ОПЫТ КУСКИ» (по списку
 * пришедших кусков в квитанции нового приёмника).
 *
 * Что меняется: P2P_UNICAST выключен (видео — всем), запас порога CCA 20 дБ
 * (см. CCA_MARGIN_DB), модуляция видео — AT+MCAST_MCS из варианта перебора.
 * ОСТОРОЖНО: на точке MCAST_MCS задаёт и скорость маяков (18.08 на MCS 7 связь
 * не вставала, см. «ШИРОКОВЕЩАТЕЛЬНЫЙ ТРАКТ»). Мощность прибита
 * (PWRCTL_MODE 0): регулятор ведёт по обратной связи от одноадресных кадров, а
 * их у камеры-точки нет. Скетч приёмника тот же, с квитанцией со списком.
 * ОТКАТ: ползунки обратно (камера STA, приёмник AP), ROLE_SWAP 0, рабочие
 * образы обеим платам, снять питание.
 */
#define ROLE_SWAP     1
/*
 * ПОДСТРОЙКА МОДУЛЯЦИИ «ВСЕМ» в модуле (05.10): AT+MCSCTL=<режим> в стартовом окне,
 * только при ROLE_SWAP. Команда есть только в сборке модуля ..._mcsctl.bin
 * (SDK/builds/MCSCTL_2026-10-05.txt); старая ответит ERROR, и модуляция останется
 * той, что задал AT+MCAST_MCS. Модуль сам меняет её раз в секунду по SNR, с
 * которым приёмник слышит камеру: стартует с MCAST_MCS, дальше — по порогам.
 * -1 — не слать.
 *
 * 06.10: опыт swap4 (автокачество 2/3 × CCA приёмника 20/0) — модуляция закреплена
 * на MCAST_MCS, режим 0: модуль только печатает строку MCSCTL (mcs=, cca=).
 * MCSCTL_ALT_S > 0 — пятый параметр сборки модуля ..._ccasw: модуль сам чередует
 * подстройку и закреплённую MCAST_MCS по столько секунд (опыт ABAB для MCSCTL).
 */
#define MCSCTL_MODE   1
#define MCSCTL_ALT_S  0     /* 06.10 swap6 был 90 (ABAB подстройка / MCS 4); рабочая — подстройка всегда */

/*
 * ПРОВЕРКА ЛОЖНЫМ АДРЕСОМ: 1 — вместо настоящего MAC приёмника подсунуть
 * заведомо несуществующий.
 *
 * ЗАЧЕМ. Модуль отвечает OK на AT+P2PDEST, но это значит лишь «указатель
 * переставлен», а не «кадры в эфире действительно стали адресными». Косвенных
 * признаков мало: скорость перестала быть прибитой к 180 кбит/с и поднималась
 * до 222 — похоже на подбор модуляции, но доказательством не является.
 *
 * ПРОВЕРКА. Назовём получателем адрес, которого в эфире нет. Если правка
 * настоящая — видео обязано пропасть ПОЛНОСТЬЮ: кадры уйдут в никуда. Если
 * картинка продолжит идти как ни в чём не бывало, значит адрес назначения нас
 * не слушается, передача всё это время была широковещательной, и все выводы
 * про адаптивную модуляцию надо выбросить.
 *
 * Адрес взят из диапазона 02:xx (локально администрируемый) — такие вендорам
 * не выдаются, случайно совпасть не с чем.
 *
 * ПОСЛЕ ПРОВЕРКИ ВЕРНУТЬ 0. Это отладочный режим, связь в нём не работает.
 */
/*
 * СКОРОСТЬ ОДНОАДРЕСНОЙ ПЕРЕДАЧИ: -1 — не трогать, 0..7 — прибить гвоздём,
 * 255 — явно включить автоподбор.
 *
 * ЗАЧЕМ. `AT+MCAST_MCS` задаёт скорость ШИРОКОВЕЩАТЕЛЬНЫХ кадров, и мы её
 * держим в нуле. У одноадресных кадров своя ручка — `AT+TX_MCS`, и до 16.09 мы
 * про неё не знали. Нашлась разбором прошивки: `atcmd_tx_mcs_hdl` по адресу
 * 0x200354b8, рядом `AT+TX_MCS_MAX`, `AT+TX_MCS_MIN`, `AT+TX_RATE_FIXED`.
 *
 * ЗАЧЕМ ПРИБИВАТЬ. Чтобы выяснить, ограничено ли кольцо модуля радио. Пауза
 * между чанками нужна ровно на то, чтобы радио успело кольцо выгрести; если
 * поднять модуляцию, сток ускорится и порог паузы должен упасть. Прибив MCS 7
 * и MCS 0 и перемерив порог, получаем ответ числом:
 *
 *   порог упал на MCS 7 и вырос на MCS 0 -> узкое место в эфире, адаптивная
 *       модуляция имеет смысл, её выигрыш равен разнице порогов;
 *   порог не двинулся -> узкое место не в эфире, и на этой дистанции
 *       адаптивная модуляция не может дать ничего.
 *
 * ЧИТАТЬ БЕЗОПАСНО. У `AT+PAIR` режима чтения нет и "?" там превращается в 0,
 * то есть в запись. Здесь не так: в обработчике стоит `cmpnei r3, 63` и переход
 * через atoi, то есть "?" честно пропускает запись и печатает текущее значение.
 * Проверено по дизассемблеру для всех четырёх команд.
 */
/*
 * СТАТИСТИКА МОДУЛЯ ВО ВРЕМЯ ПОТОКА: 0 — молчать (обычный ход),
 * иначе — период печати в миллисекундах.
 *
 * ЗАЧЕМ. Прошивка умеет печатать по каждой станции строку вида
 *
 *     tx0: mcs=3 snr=28 data=1234KB(210kbps) per=7
 *
 * `per` — доля НЕУДАЧНЫХ передач. Узнать, что одноадресный пакет не дошёл,
 * можно ТОЛЬКО по отсутствию подтверждения. Значит ненулевой `per` — прямое
 * доказательство, что подтверждения работают, а `mcs` показывает, какую
 * модуляцию автоподбор выбрал на самом деле. Это те два числа, которых не
 * хватало, чтобы закрыть вопрос про ACK (журнал, раздел 4ж).
 *
 * КАК ЭТО РАБОТАЕТ. Печатает `lmac_transceive_statics` (0x200230bc), она зовёт
 * `lmac_sta_info_statics_print` (0x20022c08). Мы сами её глушим командой
 * `AT+SYSDBG=LMAC,0` в стартовом окне — здесь она включается обратно, а
 * `AT+PRINT_PERIOD` задаёт период.
 *
 * ПОЧЕМУ ЭТО БЕЗОПАСНО ДЛЯ ВИДЕО. Печать идёт в направлении модуль -> ESP32,
 * то есть НАВСТРЕЧУ видеопотоку. Исходящие кадры она не трогает совсем. На
 * приёме смешается с отчётами приёмника, но там своё кадрирование с CRC:
 * текст не совпадёт с заголовком и будет отброшен как мусор. Мы его
 * перехватываем до отбрасывания и печатаем в консоль.
 *
 * ЦЕНА. Печать занимает полосу обратного канала, по которому приходят отчёты
 * приёмника. Слишком частая печать может их вытеснить и уронить признак
 * связи. Поэтому период задавать в секундах, а не в миллисекундах: 5000 —
 * разумный минимум.
 */
#define LMAC_STATS  5000

/*
 * РЕЖИМ ПРИЁМА UART В МОДУЛЕ КАМЕРЫ (24.09).
 *   0 — как у вендора: прерывание на каждый байт, ОДИН байт за вход;
 *   1 — выгребать FIFO целиком за вход (до 64 байт).
 * Нужна прошивка модуля SDK/builds/APP_..._UARTDIAG_... (команда AT+UARTDRAIN,
 * правка в sdk/driver/uart/hguart.c). На старой прошивке команда ответит ERROR
 * и ничего не изменит.
 *
 * Модуль печатает счётчики строкой «UARTSTAT ... oe=N» с периодом LMAC_STATS:
 * oe — сколько раз FIFO модуля переполнился, то есть прямое число потерь на
 * плече «ESP32 камеры -> модуль камеры». Переключение — без перепрошивки
 * модуля: поменять число, залить скетч, снять питание.
 */
#define UART_DRAIN  1

/*
 * РЕГУЛЯТОР МОЩНОСТИ В МОДУЛЕ (28.09): -1 — не слать команду, 0 — только
 * мерить и печатать, 1 — регулировать.
 *
 * Нужна прошивка модуля SDK/builds/APP_..._pwrctl.bin (команда AT+PWRCTL,
 * project/atcmd.c). Модуль раз в секунду сравнивает tx_snr — SNR, с которым
 * СОСЕД слышит нас, — с коридором PWRCTL_LO..PWRCTL_HI и двигает свою мощность
 * на 2 дБ в пределах 1..20. Стартует с AT+TXPOWER (TX_POWER_DBM). На старой
 * прошивке команда ответит ERROR, и прогон пойдёт с постоянной мощностью.
 *
 * Печать «PWRCTL snr=... pwr=...» идёт с периодом LMAC_STATS рядом со
 * строкой модуля «tx0: snr=» — по ним сверяем, что регулятор видит то же
 * число, что и статистика LMAC.
 */
#define PWRCTL_MODE 1
#define PWRCTL_LO   25
#define PWRCTL_HI   35
/* Потолок мощности регулятора, дБм. 14 дБм = 25 мВт — предел ГКРЧ
 * 07-20-03-001 для 866–868 МГц. Нужна сборка модуля ..._pwrctl14.bin (четвёртый
 * параметр AT+PWRCTL); прежняя сборка его не знает и держит потолок 20. */
#define PWRCTL_MAX  14

/*
 * ПОРОГ RTS, символов эфира (~40 мкс каждый): 0 — не трогать (заводской 50,
 * ~2 мс). Перед посылкой длиннее порога модуль спрашивает разрешение
 * (RTS/CTS), а при PER ~70 % — и перед каждым повтором. Нас двое и мы слышим
 * друг друга — это чистый расход эфира. 29.09 выключенный RTS (1000) был
 * лучше на всех 9 этапах опыта: синтетика 252 -> 463 кбит/с, видео Q80
 * 282 -> 618, RTT втрое меньше. Живёт в ОЗУ модуля — шлём в каждом окне.
 */
#define RTS_SET_SYM 1000

/*
 * ОТЧЁТ МОДУЛЯ ЦЕЛИКОМ (30.09): 0 — строгий фильтр (обычный ход), N — каждый
 * N-й периодический отчёт модуля (LMAC_STATS) пропускать в лог целиком, не
 * больше LMAC_DBG_LINES строк, плюс строки смены лучшей модуляции (tp1=/tp2=).
 *
 * Зачем. AT+LMAC_DBGSEL=2 (в VAR_SWEEP) добавляет в отчёт таблицу по всем MCS:
 * попытки, доля успеха, оценка. Это единственный способ увидеть, что выбрал
 * автоподбор: mcs= в строке tx0 — модуляция ПОСЛЕДНЕЙ попытки, а не выбор
 * (журнал, «30.09: как модуль выбирает модуляцию»). Формат строк таблицы
 * заранее не известен, поэтому отчёт пропускается целиком — в том числе без
 * таблицы, для сравнения. Лог идёт по воздуху и делит эфир с видео: при
 * отчёте раз в ~4 с это ~2 кбит/с.
 */
#define LMAC_DBG_EVERY  0
#define LMAC_DBG_LINES  64   /* ~20 строк отчёта + таблица до 32 модуляций */

/*
 * МОЩНОСТЬ ПЕРЕДАТЧИКА, дБм: 0 — не трогать, иначе 1..20.
 *
 * ДИАПАЗОН РОВНО 1..20, ноль отвергается. Проверено по обработчику:
 *     200382a6:  blsz r0, ERROR     ; значение <= 0 -> ошибка
 *     200382b0:  cmplti r0, 21      ; и должно быть < 21
 * 17.09 на этом потеряли прогон: послали AT+TXPOWER=0, получили ERROR, а
 * мощность осталась прежней — и заметили это только по AT+TXPOWER=? в логе.
 *
 * ЗАЧЕМ. На столе платы стоят в двух метрах, а передатчик жарит на 20 дБм.
 * Замер 17.09 показал уровень на входе приёмника около НУЛЯ дБм (минимум -10,
 * максимум +4, 90 замеров из 91 выше -10). Приёмник рассчитан на -60...-90.
 * Это не «отличный сигнал», а перегрузка: мы вгоняем в него на пять порядков
 * больше, чем он ждёт. При этом PER держится 52% в среднем — половина передач
 * требует повтора, и именно там теряется весь выигрыш от быстрой модуляции.
 *
 * Убавив мощность, проверяем догадку напрямую: упадёт PER — значит виновато
 * насыщение, и все столовые замеры до сих пор мерили артефакт близости.
 * Заодно стенд становится честнее: канал начинает походить на настоящий, а не
 * на «антенна в антенну».
 *
 * ОСТОРОЖНО С ВЫВОДАМИ. EVM при перегрузке держался -31 дБ и почти не плыл, а
 * это неплохое качество созвездия. Значит грубого насыщения на ПРИЁМЕ нет, и
 * одна лишь мощность может не объяснить всё. Второй подозреваемый — сам
 * автоподбор: половину времени он сидит на MCS 6-7, а на прибитом MCS 7 связь
 * измеримо сыплется. Его проверяет TX_MCS_MAX, см. ниже.
 *
 * ВО ФЛЕШ НЕ ПИШЕТСЯ. Обработчик AT+TXPOWER зовёт lmac_ioctl и не вызывает
 * syscfg_save — правка живёт только в ОЗУ и сбрасывается снятием питания.
 * Поэтому её можно слать в стартовом окне, не нарушая правила «конфигурация
 * ставится один раз с терминала».
 */
/* 26.09: стол, платы в полуметре. TX_PWR_AUTO=1 держала PER 44-82 — то есть
 * ответ на вопрос выше получен: автоподстройка идёт по линейности MCS, а от
 * перегрузки приёмника не спасает. Проверяем прямым убавлением, как 17.09. */
/* 28.09: 14, а не 20 — стартовая мощность до первого решения регулятора
 * тоже должна укладываться в предел ГКРЧ (25 мВт), см. PWRCTL_MAX. */
#define TX_POWER_DBM  3

/*
 * ПОТОЛОК МОДУЛЯЦИИ: -1 — не трогать, 0..7 — ограничить сверху.
 *
 * КОДИРОВКА НЕОЧЕВИДНА. Ограничение включается СТАРШИМ битом, значение лежит в
 * младших семи:
 *
 *     2002da78:  ld.b  r3, (r6, 0x888)   ; tx_mcs_max
 *     2002da7e:  bhsz  r2, 0x2002da90    ; если >= 0 — ПЕРЕПРЫГНУТЬ ограничение
 *     2002da82:  andi  r3, r3, 127       ; сюда только при взведённом бите 7
 *
 * То есть AT+TX_MCS_MAX=7 не ограничит НИЧЕГО (7 >= 0, переход), а нужное
 * значение — 128+7=135 для потолка MCS 7, 128+4=132 для MCS 4. Ровно поэтому
 * прочитанный на плате «limit tx mcs max= 0» означает «не задано», а не
 * «потолок MCS 0».
 */
#define TX_MCS_MAX_CAP  -1

/*
 * АВТОПОДСТРОЙКА МОЩНОСТИ: -1 — не трогать, 0 — выключить, 1 — включить.
