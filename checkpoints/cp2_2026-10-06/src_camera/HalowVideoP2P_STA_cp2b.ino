static const char *fs_name(framesize_t fs)
{
    switch (fs) {
        case FRAMESIZE_96X96: return "96x96";
        case FRAMESIZE_QQVGA: return "160x120";
        case FRAMESIZE_HQVGA: return "240x176";
        case FRAMESIZE_QVGA:  return "320x240";
        case FRAMESIZE_HVGA:  return "480x320";
        case FRAMESIZE_VGA:   return "640x480";
        case FRAMESIZE_SVGA:  return "800x600";
        default:              return "?";
    }
}

/*
 * Шершавость кадра RGB565: средняя разница между соседними пикселями по
 * горизонтали, усреднённая по трём каналам. RGB565 разбираем в 8 бит на
 * канал, чтобы число было в той же шкале, что и у tools/frame_check.py.
 */
static float cam_roughness(const camera_fb_t *fb)
{
    if (!fb || fb->format != PIXFORMAT_RGB565 || fb->width < 2 || !fb->buf) {
        return 0.0f;
    }
    /* СТАРШИЙ БАЙТ ПЕРВЫЙ — как кладёт камера и как читает cam_rough_at().
     *
     * Здесь было `(const uint16_t *)fb->buf`, то есть порядок платформы —
     * младшим вперёд. Пока эта функция только мерила, расхождение было
     * безвредным: метрика со спутанными полями всё равно отличает гладкое
     * от рябого. Но с 25.09 она служит ВТОРЫМ УСЛОВИЕМ ОТКАТА, а там это
     * смертельно: в съехавшем хвосте пары байт сдвинуты, и чтение младшим
     * вперёд попадает там «в такт», а ПОСЛЕ верной вставки — выпадает. Две
     * функции оказались анти-коррелированы, и откат срабатывал на КАЖДОЙ
     * верной починке. На плате это дало «вылечено 388 из 3083».
     *
     * Побочное следствие правки: шкала сдвинулась, и старый порог 8.0 к ней
     * больше не привязан. Это не страшно: правка на порог не опирается вовсе,
     * а строка статистики теперь сравнима с числами лаборатории. */
    const uint8_t *bp = fb->buf;
    uint32_t acc = 0, n = 0;
    for (size_t y = 0; y < fb->height; y += CAM_CHECK_ROW_STEP) {
        const uint8_t *row = bp + y * fb->width * 2;
        for (size_t x = 1; x < fb->width; x++) {
            uint16_t a = (uint16_t)((row[(x - 1) * 2] << 8) | row[(x - 1) * 2 + 1]);
            uint16_t b = (uint16_t)((row[x * 2] << 8) | row[x * 2 + 1]);
            int dr = (int)((a >> 11) & 0x1f) - (int)((b >> 11) & 0x1f);
            int dg = (int)((a >>  5) & 0x3f) - (int)((b >>  5) & 0x3f);
            int db = (int)( a        & 0x1f) - (int)( b        & 0x1f);
            /* 5 и 6 бит -> 8, чтобы шкала совпала с разбором на ПК */
            acc += (uint32_t)(abs(dr) << 3) + (uint32_t)(abs(dg) << 2)
                 + (uint32_t)(abs(db) << 3);
            n += 3;
        }
    }
    return n ? (float)acc / (float)n : 0.0f;
}

