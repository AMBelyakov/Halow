//
// OV5640 на этой плате: аппаратный JPEG-энкодер виснет и отдаёт пустые кадры на
// любом разрешении (проверено на двух модулях). Рабочий режим — снимать в
// RGB565 и жать в JPEG программно через frame2jpg().
// HQVGA — рабочий предел ЗАХВАТА на этой плате, а не выбор из экономии канала.
// 13.08-14.08: на 20 МГц HQVGA идёт чисто, QVGA (320x240) рвётся в клочья.
// QVGA это 153600 байт на кадр против 84480, почти вдвое больше через DMA в
// PSRAM — тракт не тянет. Он же выдавал EV-VSYNC-OVF в CameraSelfTest именно
// на QVGA. Сжатие тут ни при чём: на HQVGA работает то же самое сжатие.
// Чёткость поднимать через JPEG_QUALITY_SW, а не через разрешение.
/* 29.09 ОПЫТ: QVGA. Камера на HQVGA упирается в ~20 к/с сенсора, два кодировщика
 * дают запас по пикселям. Запреты 13-14.08 выше сняты на тракте без слип-диагноза;
 * смотреть EV-VSYNC-OVF и «ЗАХВАТ: поражено». Не взлетит — вернуть HQVGA. */
/* 06.10 ночь, ЧЕКПОИНТ 2: 480×320. С током выходов сенсора ×1 (CAM_DRIVE) и новым
 * кодировщиком (NEW_JPEG) на 5 м — 0,9–1,0 Мбит/с, 5–6 целых кадров/с, сенсор 8,8 к/с
 * (опыт drvq). На ×4 тот же кадр тяжелее на 13–18 % и захват вставал — см. CAM_DRIVE. */
#define FRAME_SIZE      FRAMESIZE_HVGA   // QQVGA(160x120) | HQVGA(240x176) | QVGA(320x240) | HVGA(480x320)

// 20 МГц — проверено обеими сторонами: на 16 кадр рвётся, на 24 (вместе с
// QVGA) захват уходит в сплошной EV-VSYNC-OVF и плата падает по сторожевому
// таймеру. 20 — единственная рабочая точка.
//
// 20 МГц, а не 16. Раньше стояло 16 «для запаса против EV-VSYNC-OVF».
// 13.08 выяснилось, что кадр приходит от драйвера уже рваным (проверено:
// буфер во время сжатия не меняется, два сжатия одного кадра дают побайтно
// одинаковый JPEG, crc_err на приёмнике 0 — то есть портит именно захват).
// У OV5640 внутренний PLL рассчитан на 20-24 МГц; на 16 МГц драйвер считает
// нестандартные делители, и PCLK выходит на грани того, что успевает
// защёлкнуть LCD_CAM у ESP32-S3. Отсюда пропущенные строки в кадре.
/*
 * 06.10: ОПЯТЬ 16 МГц — ради режима «DMA прямо в PSRAM», а не ради такта.
 *
 * Записи выше — эпоха радуги, которая 25.09 оказалась шлейфом (механика), так что
 * «на 16 хуже» тех дней доказательством не служит.
 *
 * Разобрано по дизассемблеру cam_config в libesp32-camera.a (arduino 2.0.9):
 * psram_mode = (xclk_freq_hz == 16000000) — литерал −16000000 и moveqz. Только
 * ровно 16 МГц включает режим, где DMA пишет кадр прямо в буфер в PSRAM.
 * На 20 МГц драйвер принимает строки во внутренний буфер DMA 30720 Б из двух
 * половин по 15360 Б (24 строки QVGA), и cam_task копирует каждую половину в
 * PSRAM. Очередь событий у неё — половин минус одна, то есть ОДНО место. Копию
 * последней половины надо успеть до VSYNC следующего кадра; при такте сенсора
 * ×1,5 (pll12, кадр 84 мс) не успевала: 1076 EV-VSYNC-OVF за 12 с, 2–3 к/с
 * вместо 5,5. В режиме PSRAM копии нет, очередь на 9 мест (10 половин).
 *
 * Цена режима: DMA пишет в PSRAM мимо кэша процессора — см. cam_cache_fresh().
 * Такт сенсора при 16 МГц восстанавливается множителем PLL (CAM_PLL_MUL).
 *
 * 06.10 12:19, ИТОГ: ОТКАЧЕНО В 20. Очередь вылечилась (EV-*-OVF 0 за 75 с), к/с
 * 6,1–7,8 против 5,5 — но «ЗАХВАТ: поражено» 99 % (838 из 843), шершавость ~11:
 * сдвиг байта почти в каждом кадре. Механизм тот же, что 15.09 (см.
 * CAM_FB_IN_DRAM): буфер GDMA крошечный, пока PSRAM занята кодировщиками, он
 * переполняется и байты теряются поштучно. На 20 МГц DMA пишет во внутреннюю
 * память, где делить шину не с кем. Значит, «13.08 на 16 хуже» было про это же.
 */
#define CAM_XCLK_HZ     20000000

/*
 * ДЕЛИТЕЛЬ PCLK СЕНСОРА: 1 — как настроил драйвер, 2 — вдвое медленнее.
 *
 * 15.09. Разобрана радуга: в сыром кадре RGB565, ещё до сжатия, начиная с
 * какого-то места пиксельная сетка съезжает на один байт, и дальше до конца
 * кадра старший и младший байты меняются ролями. Доказано сдвигом хвоста на
 * байт — картинка становится чистой (кадр 06: грубость 14.34 -> 2.99).
 * Значит на шине DVP теряется или появляется лишний байт, то есть не хватает
 * запаса по фронтам PCLK у LCD_CAM.
 *
 * Почему делитель, а не xclk. Понижать xclk уже пробовали 13.08 — см. запись
 * выше: на 16 МГц стало ХУЖЕ, потому что PLL самого OV5640 рассчитан на
 * 20-24 МГц и на 16 драйвер считает нестандартные делители. Ручка xclk тянет
 * за собой PLL. А регистр 0x3035 (SC_PLL_CONTRL1, биты 7:4 — системный
 * делитель) режет такт ПОСЛЕ PLL: xclk остаётся 20 МГц, PLL в расчётном
 * режиме, а PCLK становится вдвое медленнее.
 *
 * Кадров это не отнимет: сенсор и так выдаёт больше, чем мы успеваем
 * отправить — потолок стоит на UART, около 3.5-5 кадров/с.
 *
 * Пишем ПОСЛЕ esp_camera_init: инициализация сама программирует PLL, и наша
 * правка должна лечь поверх. Значение читается обратно и печатается в лог —
 * если драйвер его переиграет, это будет видно сразу.
 *
 * 15.09, ИТОГ: ОТКАЧЕНО В 1, ГИПОТЕЗА ЗАКРЫТА. Делитель применился
 * (в логе «0x3035 было 0x11, стало 0x21»), сенсор поехал вдвое медленнее —
 * и радуга осталась ровно та же, байт в байт того же характера. Значит дело
 * НЕ в запасе по фронтам PCLK: если бы LCD_CAM не успевал защёлкнуть, вдвое
 * более медленный такт это бы вылечил.
 *
 * Заплачено при этом дорого: съём кадра вырос с 0-4 мс до 2.8-3.4 с, поток
 * упал до 0.3 кадра в секунду. Так что /2 по этому регистру — не «вдвое
 * медленнее сенсор», а что-то заметно более грубое.
 *
 * Оставлено на 1 и с рабочим кодом: ручка проверена, писать её заново не
 * нужно, а понадобится другой делитель — менять одно число.
 */
#define CAM_PCLK_DIV    1

/*
 * ТАКТ СЕНСОРА — PLL OV5640 (06.10): 0 — как ставит драйвер, иначе множитель PLL.
 *
 * Зачем. На QVGA сенсор отдаёт кадр раз в 126 мс (~8 к/с, «кадр сенсора» в логе),
 * а на HQVGA тот же сенсор давал ~20 к/с (29.09). Камера сейчас — потолок всего
 * тракта: эфир и UART свободны наполовину, 5,5 к/с упираются в сенсор и сжатие.
 *
 * Почему так. Драйвер esp32-camera для RGB565 выбирает PLL по размеру кадра:
 * QVGA..HVGA — множитель 8, делитель PCLK 4 (такт системы ~16 МГц, PCLK ~8 МГц);
 * меньше QVGA — множитель 20, делитель 8 (~40 и ~10 МГц). Частота кадров идёт от
 * такта системы — на QVGA он в 2,5 раза ниже, отсюда и 126 мс. Ставим QVGA тот PLL,
 * что драйвер ставит HQVGA: на этой плате он проверен, а PCLK растёт только с 8
 * до 10 МГц (CAM_PCLK_DIV выше показал: срывы кадров не от фронтов PCLK).
 *
 * Пишем ПОСЛЕ esp_camera_init — он программирует PLL сам. Регистры PLL (0x3034..
 * 0x3037, 0x3108, 0x3824, 0x460C) печатаются до и после: по 0x3036 (множитель)
 * видно, что стояло на самом деле. Смотреть в логе «кадр сенсора» (ждём ~50 мс),
 * «ЗАХВАТ: поражено», «STAGE камера».
 *
 * 06.10, итог при XCLK 20 МГц: множитель 20/делитель 8 (кадр 50 мс) и 12/6 (84 мс)
 * — сенсор ускорялся как задумано, но драйвер тонул в EV-VSYNC-OVF (см.
 * CAM_XCLK_HZ). Теперь XCLK 16: множитель 15 даёт тот же такт системы, что 12 при
 * 20 МГц (16×15 = 20×12 = 240), то есть кадр 84 мс; делитель 6 оставляет PCLK
 * ~8 МГц, как у драйвера по умолчанию, — DMA в PSRAM пишет не быстрее прежнего.
 * 06.10 12:19: на 16 МГц кадры с порчей 99 % (см. CAM_XCLK_HZ) — назад 20 и 12/6,
 * теперь вместе с ENC_BUF_INTERNAL и VSYNC_PROBE.
 */
/* 06.10 17:35–17:40, опыт pllab (ABAB в одном включении, Q80, W=4, буферы jpge во
 * внутренней памяти, фильтр VSYNC 7): x1 — 6,5 и 7,6 к/с, сдвигов байта +13 и +12 за
 * этап; x1,5 — 6,9 и 5,5 к/с, сдвигов +494 и +441 (почти каждый кадр, радуга), кадр
 * JPEG от этого 12 КБ против 8. К/с такт ×1,5 не прибавил: конвейер упирается в JPEG
 * и UART, а правка слипа стоит 38 мс на кадр. ВЫКЛЮЧЕНО (0 — такт драйвера). */
#define CAM_PLL_MUL       0
#define CAM_PLL_PCLK_DIV  6
/* 1 — сенсор на CAM_PLL_MUL, 0 — как ставит драйвер; меняет опыт (exp_step_t.pll). */
static uint8_t cam_pll_fast = (CAM_PLL_MUL > 0) ? 1 : 0;
// 30, а не 20: чёткость поднимаем здесь, потому что разрешение упирается в
// захват (см. FRAME_SIZE выше), а канал ещё не выбран — на 460800 доступно
// около 46 КБ/с, а тратим примерно половину. Кадр вырастет примерно в
// полтора раза. Если fps просядет сильнее, чем хочется, — возвращать к 25.
/* 25.09: 60, а не 30. Узкое место переехало с провода на захват: после
 * FRAME_GAP_MS=0 стадия UART упала до 28 мс, но стадия камеры выросла до
 * 14-27 мс — конвейер просит кадры быстрее, чем их отдаёт сенсор, и ждёт.
 * Частоту уже не поднять (потолок ~18 к/с), значит поток растёт только
 * размером кадра: 125000 Б/с / 18 = 6950 Б на кадр против нынешних 4644.
 *
 * Почему это дёшево: время сжатия почти не зависит от размера выхода —
 * замеры 24.09 дали 2800 Б за 36 мс и 7300 Б за 40 мс, то есть выход
 * вырос в 2.6 раза, а время на 11%. DCT считается по пикселям, от
 * качества растёт только энтропийное кодирование. В бюджете кадра сейчас
 * 56 мс, из них 14-27 — простой в ожидании камеры; время на более крупный
 * JPEG там уже есть, оно просто тратится впустую.
 *
 * Побочно: картинка станет ЛУЧШЕ, а не хуже, и доля искажений сломанного
 * захвата в размере кадра уменьшится. */
/* 29.09: 80. С заводским RTS выше 60 не окупалось — канал не пропускал; с
 * выключенным RTS (RTS_SET_SYM) Q80 даёт 618 кбит/с при 6 к/с против 425 и 7
 * у Q60, Q90 — 680 кбит/с, но 3,9 к/с. См. журнал 29.09, 14:03–14:51. */
/* 06.10 ночь, ЧЕКПОИНТ 2: 70 — старт автокачества для 480×320. На 5 м оно на нём и
 * стоит: задержка ~350 мс между порогами AUTOQ_RTT_LO 300 и AUTOQ_RTT_HI 600. */
#define JPEG_QUALITY_SW 70               // 1..100, меньше — сильнее сжатие

/*
 * САМОПРОВЕРКА ЗАХВАТА ПРИ СТАРТЕ.
 *
 * 24.09. Байтовый слип («радуга») оказался НЕ накапливающимся: внутри прогона
 * размер кадра не растёт (по четвертям: чистый 2762->2675 Б, грязный
 * 6524->6156 Б). Прогон с первой секунды либо чистый, либо грязный, и таким
 * остаётся до конца. Значит состояние определяется при инициализации камеры.
 *
 * Отсюда две беды. Первая: половина прогонов 24.09 снята на испорченном
 * захвате, и мы этого не знали. Вторая: A/B по любому параметру требует цикла
 * питания на каждое плечо, то есть новой инициализации — и мы сравнивали не
 * параметр, а везение.
 *
 * Метрика та же, что в tools/frame_check.py: средняя разница между соседними
 * пикселями по горизонтали. Съехавшая на байт сетка RGB565 делает картинку
 * шершавой. Замеры 15.09 на ПК: чистый кадр 3.1-5.5, поражённый 12-21.
 * Порог 8.0 лежит посередине широкого зазора.
 *
 * ВАЖНО: сюжет влияет. Очень мелкий контрастный кадр (текст, жалюзи во весь
 * кадр) поднимает шершавость сам по себе. Поэтому вердикт ПЕЧАТАЕТСЯ ВСЕГДА:
 * даже без лечения это даёт признак «прогону верить нельзя», которого нам
 * не хватало.
 */
#define CAM_CHECK_ON        1     // 0 — не проверять вовсе
#define CAM_CHECK_THRESHOLD 8.0f  // выше — считаем захват испорченным
#define CAM_CHECK_FRAMES    5     // сколько кадров мерить (берём медиану)
#define CAM_CHECK_SKIP      2     // выбросить первые кадры: сенсор не устоялся
#define CAM_CHECK_ROW_STEP  8     // считать каждую N-ю строку
#define CAM_CHECK_TRIES     4     // сколько раз переинициализировать камеру

/*
 * Паузы.
 *
 * В версии на AT+TXDATA стояли CHUNK_GAP_MS=12 и FRAME_GAP_MS=80 — модуль
 * захлёбывался на третьей подряд команде и отвечал ERROR. Здесь команд нет,
 * захлёбываться нечему, и главный ограничитель — сам UART: 1427 байт на 115200
 * это 124 мс, паузы на их фоне почти ничего не значат.
 *
 * Небольшой зазор между пакетами всё же полезен: модуль режет поток по паузе на
 * линии, и если дать ему передохнуть, границы его кусков будут ближе к нашим.
 * На целостность это не влияет (у нас своё кадрирование), но чуть снижает
 * шанс переполнить внутреннее кольцо на всплеске.
 */
/*
 * ИЗМЕРЕНО 15.08 автоматическим перебором на 460800 (лог
 * tools/logs/halow_20260815_002744_gap-sweep.csv, счётчики брака сняты с
 * приёмника по USB — обратный канал по радио для этого не годится, он
 * глохнет, пока передатчик занимает эфир):
 *
 *   пауза   кбит/с   брак CRC
 *    15      165        0
 *    12      194        0
 *    10      197        0
 *     8      200        0
 *     6      203        0
 *     4      228        0
 *     2      5.7      115     <- обвал
 *
 * Между 4 и 2 мс не спад, а порог: пропускная способность падает в сорок раз
 * и появляется брак. Механика: кольцо модуля 2048 байт, пакет 1427, два
 * подряд не влезают, управления потоком нет. Пока радио успевает выгребать
 * кольцо между пакетами — потерь нет вовсе; как только перестаёт — рушится
 * сразу всё.
 *
 * 8 мс, а не 4: за 12% пропускной способности берём вчетверо больший отступ
 * от обрыва. На столе работало бы и 4, но в поле радио выгребает кольцо
 * медленнее (дистанция, помехи, ретрансмиссии), и запас понадобится.
 *
 * ВНИМАНИЕ: таблица снята на 460800, а сейчас стоит 230400. На вдвое более
 * медленной линии тот же пакет уходит вдвое дольше (62 мс вместо 31), то есть
 * у радио вдвое больше времени выгрести кольцо, и порог обвала сдвинут вниз.
 * 8 мс здесь заведомо с запасом. Захочешь вернуть потерянную скорость —
 * перезапусти GAP_SWEEP уже на 230400 и найди новую точку.
 */
/*
 * КОНВЕЙЕР: 1 — захват и сжатие на отдельном ядре, параллельно с передачей.
 *
 * Замерено 15.08: цикл кадра около 200 мс = сжатие 60 + UART 87 + паузы. Пока
 * шло сжатие, провод молчал; пока шла передача, простаивал процессор. Развели
 * по ядрам — цикл стал максимумом из двух времён, а не суммой.
 *
 * 0 — прежний последовательный путь, если понадобится сравнить.
 */
/*
 * 18.08: ВЫКЛЮЧАЛСЯ. С конвейером возвращалась порча картинки при нулевом
 * frame_crc_err — то есть кадр доезжал побайтно тем же, каким уехал, а уехал
 * уже битым. Камера пишет кадр по DMA в PSRAM одновременно с тем, как
 * кодировщик читает оттуда предыдущий, и шина этого не тянет.
 *
 * 20.08: ВКЛЮЧЁН СНОВА. Конкуренции за PSRAM больше нет: кодировщик работает
 * во внутренней памяти (см. ENCODE_FROM_SRAM ниже), и от него в PSRAM осталось
 * одно чтение кадра подряд вместо шестидесяти миллисекунд доступа вразнобой.
 *
 * Если полосы вернутся — вернуть сюда 0 и смотреть, помогло ли. Не помогло,
 * значит дело в окне копирования (оно есть и в последовательном режиме) —
 * его ловит CHECK_COPY.
 */
#define PIPELINE 1

/*
 * КОДИРОВЩИКОВ JPEG (29.09): 1 — одна задача на ядре 1, как было; 2 — вторая
 * такая же задача на ядре 0.
 *
 * Зачем. Кодер тратит время на пиксель: HQVGA ~41 мс на кадр на одном ядре,
 * это ~20 к/с и 0,5–0,7 Мбит/с, меньше, чем уже отдаёт канал (0,9–1 Мбит/с на
 * 5 м). Две задачи жмут два кадра одновременно.
 *
 * Почему на ядре 0 теперь можно. 25.08 конвейер оттуда увели: рвались кадры,
 * и это списали на голодание драйвера камеры (его задача живёт на ядре 0,
 * CONFIG_CAMERA_CORE0). 26.09 доказано, что слип — наводка собственного
 * передатчика, а не драйвер. Кроме того, задача драйвера идёт с приоритетом
 * configMAX_PRIORITIES-2 и вытесняет наш приоритет 1 сразу. Проверка встроена:
 * строка «ЗАХВАТ: поражено …» покажет, если рвань вернётся.
 *
 * Как устроено. Захват (fb_get, проверка и правка слипа) общий и идёт под
 * замком cap_mutex, сжатие — параллельно, каждый из своего буфера камеры (они
 * в PSRAM, копия не нужна). Кадры нумеруются при захвате (cap_seq); если новый
 * сожмётся раньше старого, старый при отправке выбрасывается (enc_reordered),
 * порядок на приёмнике не ломается. Буферов камеры 4: два держат кодировщики,
 * драйверу остаётся куда писать.
 *
 * Только с ENCODE_FROM_SRAM 0 и CAM_FB_IN_DRAM 0 (там один общий буфер).
 */
#define ENC_WORKERS 2

/*
 * СЖАТИЕ ИЗ ВНУТРЕННЕЙ ПАМЯТИ: 1 — скопировать кадр из PSRAM в SRAM и сжимать
 * уже копию.
 *
 * ЧТО ЛЕЗЛО В PSRAM РАНЬШЕ — не только кадр. arduino-esp32 собран с
 * CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096, то есть обычный malloc отдаёт из
 * PSRAM всё, что крупнее 4 КБ. А крупнее 4 КБ у нас:
 *   - строчные буферы самого кодировщика (jpge держит полосу в 16 строк,
 *     на ширине 240 это около 12 КБ);
 *   - готовый JPEG, который frame2jpg возвращает через malloc (7-9 КБ);
 *   - и из этого же JPEG потом читает UART все 150 мс передачи.
 * Плюс сам кадр: 84 КБ, которые кодировщик читает не подряд, а блоками по
 * 16 строк, то есть с постоянными промахами кэша.
 *
 * Против всего этого стоит DMA камеры, которому опаздывать нельзя: строка
 * пришла с сенсора — положить её надо сейчас, а не когда освободится шина.
 * Проигрывает он, и это те самые полосы.
 *
 * ЧТО ДЕЛАЕМ — два действия, оба в setup():
 *   1) heap_caps_malloc_extmem_enable(INTERNAL_MALLOC_LIMIT) поднимает порог,
 *      после чего буферы кодировщика и готовый JPEG живут во внутренней
 *      памяти, а UART оттуда же их и читает;
 *   2) один раз выделяем внутренний буфер под кадр и копируем кадр в него.
 * После этого в PSRAM остаются только запись DMA и одно наше чтение 84 КБ
 * подряд — самый дружелюбный к шине режим доступа, единицы миллисекунд.
 *
 * ПОБОЧНЫЙ ВЫИГРЫШ: сжатие из SRAM само по себе быстрее, чем из PSRAM. На
 * сколько — видно в строке STAGE, где копия и JPEG печатаются раздельно.
 *
 * ЕСЛИ БУФЕР НЕ ВЫДЕЛИЛСЯ (не хватило внутренней памяти) — работаем как
 * раньше, прямо из PSRAM, и конвейер тогда НЕ включается: без развязки он
 * снова порвёт картинку. Об этом печатается строка в лог.
 */
#define ENCODE_FROM_SRAM 0

/*
 * БУФЕР ЗАХВАТА ВО ВНУТРЕННЕЙ ПАМЯТИ: 1 — кадр от камеры сразу в SRAM,
 * PSRAM в тракте захвата не участвует вовсе.
 *
 * 15.09. Разобрана радуга: в сыром кадре, ещё до сжатия, с какого-то места
 * пиксельная сетка съезжает на ОДИН БАЙТ, и дальше до конца кадра старший и
 * младший байты RGB565 меняются ролями. Доказано сдвигом хвоста на байт —
 * картинка становится чистой (кадр 06: грубость 14.34 -> 2.99).
 *
 * Поимённо оправданы: провод (frame_crc_err 0 при живой радуге), копия в
 * SRAM (CHECK_COPY: 0 расхождений на 71 кадре), конвейер (выброшено 0),
 * кодировщик (разница с сырым кадром — только шум квантования), и наконец
 * скорость шины (делитель PCLK выше — не помог).
 *
 * Остаётся пропускная способность PSRAM. Пока DMA камеры пишет туда кадр, мы
 * из той же PSRAM читаем предыдущий. Буфер GDMA между шиной камеры и памятью
 * крошечный: PSRAM занята нашим чтением — он переполняется и байты теряются
 * поштучно. Это сходится и с разбросом смещений от кадра к кадру, и с тем,
 * что перенос СЖАТИЯ в SRAM (26.08) улучшил картину, но не вылечил: чтение
 * 84 КБ никуда не делось, оно лишь стало короче.
 *
 * Здесь убираем PSRAM из тракта совсем: буфер камеры в SRAM, DMA пишет во
 * внутреннюю память, делить с нами ей нечего.
 *
 * ПОЧЕМУ ENCODE_FROM_SRAM при этом 0. Копия PSRAM->SRAM теряет смысл: кадр и
 * так уже в SRAM, копировать его самому в себя незачем. Заодно освобождаются
 * 84 КБ, без которых два буфера захвата во внутреннюю память не влезли бы:
 * свободно 227 КБ, два буфера по 84 КБ это 169.
 *
 * ДВА буфера, а не один: пока мы 36 мс сжимаем кадр из своего буфера,
 * сенсору надо куда-то писать следующий. Если двух не хватит (init вернёт
