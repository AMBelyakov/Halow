static int8_t   autoq_idx = -1;
#endif
/* 29.09: ступень 30 — на канале ~250 кбит/с при Q40 было 3,3 к/с, ниже некуда. */
/* 06.10 вечер: +95 — поток растим размером кадра, раз сенсор держит не больше 7,9 к/с
 * (см. thalow-camera-fps-limits / CAM_PLL_MUL). Задержка сама опустит, если канал не тянет. */
/* 06.10 вечер (выбор пользователя): +98. */
static const uint8_t autoq_ladder[] = { 30, 40, 50, 60, 70, 80, 85, 90, 95, 98 };
static uint32_t aq_t = 0, aq_acks0 = 0, aq_to0 = 0, aq_blk0 = 0, aq_streak = 0;
static uint32_t aq_ups = 0, aq_downs = 0, aq_last_rtt = 0, aq_last_blk = 0;
static uint64_t aq_rtt0 = 0;

/* Раз в секунду: подобрать качество под канал, см. AUTO_Q. */
static void autoq_tick(uint32_t now)
{
    const int8_t n = (int8_t)sizeof(autoq_ladder);
    if (!autoq_on || synth_on || !link_up) {
        aq_t = 0;
        aq_rtt_n = 0;
        return;
    }
    if (autoq_idx < 0) {
        autoq_idx = 0;
        for (int8_t i = 0; i < n; i++) {
            if (autoq_ladder[i] <= jpeg_q_rt) {
                autoq_idx = i;
            }
        }
        jpeg_q_rt = autoq_ladder[autoq_idx];
        aq_t = 0;
    }
    if (!aq_t || now - aq_t >= 1000) {
        bool first = !aq_t;
        uint32_t dt = now - aq_t;
        uint32_t acks = lat_acks - aq_acks0;
        uint32_t to = fc_timeouts - aq_to0;
        uint32_t blk = dt ? (fc_blocked_ms - aq_blk0) * 1000u / dt : 0;
        uint32_t rtt = acks ? (uint32_t)((lat_rtt_sum - aq_rtt0) / acks) : 0;
        bool in_flight = (frame_id != fc_last_ack_id);
        /* 06.10, правила 3: медиана RTT без запоздалых квитанций (вставками —
         * элементов меньше двух десятков). */
        uint8_t rtt_n = aq_rtt_n;
        uint32_t rtt_med = 0;
        for (uint8_t i = 1; i < rtt_n; i++) {
            uint16_t v = aq_rtt_buf[i];
            int8_t j = (int8_t)i - 1;
            while (j >= 0 && aq_rtt_buf[j] > v) {
                aq_rtt_buf[j + 1] = aq_rtt_buf[j];
                j--;
            }
            aq_rtt_buf[j + 1] = v;
        }
        if (rtt_n) {
            rtt_med = aq_rtt_buf[rtt_n / 2];
        }
        aq_rtt_n = 0;
        aq_t = now;
        uint32_t fps10 = dt ? (frames_total - aq_fr0) * 10000u / dt : 0;
        aq_fr0 = frames_total;
        aq_acks0 = lat_acks;
        aq_to0 = fc_timeouts;
        aq_blk0 = fc_blocked_ms;
        aq_rtt0 = lat_rtt_sum;
        if (first) {
            return;
        }
        if (autoq_on >= 3) {
            rtt = rtt_med;
        }
        aq_last_rtt = rtt;
        aq_last_blk = blk;
        aq_last_fps10 = fps10;
#if GATED_CAPTURE
        bool gated = gate_on;
#else
        bool gated = false;
#endif
        int8_t d = 0;
        int8_t why = -1;                  /* причина шага вниз, см. aq_why */
        if (autoq_on >= 3) {
            /* 06.10: правила 3 и 4, см. AUTO_Q. Квитанции — мерка очереди, не штраф;
             * в 4 задержка роняет Q, только если держится несколько секунд подряд. */
            static uint8_t noack_run = 0, hi_run = 0, bad_run = 0, fps_run = 0;
            const uint8_t need_hi = autoq_on == 4 ? 3 : 1;
            const uint8_t need_bad = autoq_on == 4 ? 2 : 1;
            noack_run = (!acks && in_flight) ? (uint8_t)(noack_run + 1) : 0;
            fps_run = fps10 < AQ_FPS_MIN * 10u ? (uint8_t)(fps_run + 1) : 0;
            if (rtt_n) {                      /* без замеров — счёт не трогаем */
                hi_run = rtt > AUTOQ_RTT_HI ? (uint8_t)(hi_run + 1) : 0;
                bad_run = rtt > AUTOQ_RTT_BAD ? (uint8_t)(bad_run + 1) : 0;
            }
            if (bad_run >= need_bad) {
                d = -2;
                why = 0;
                bad_run = 0;
                hi_run = 0;
            } else if (noack_run >= 2) {
                d = -1;
                why = 1;
                noack_run = 0;
            } else if (hi_run >= need_hi) {
                d = -1;
                why = 2;
                hi_run = 0;
            } else if (autoq_on == 3 && !gated && blk > AUTOQ_BLOCK_HI && rtt_n &&
                       rtt > AUTOQ_RTT_LO) {
                d = -1;
                why = 3;
            } else if (fps_run >= 3 && jpeg_q_rt > AQ_FPS_Q_FLOOR) {
                d = -1;
                why = 5;
                fps_run = 0;
            } else if (rtt_n && rtt < AUTOQ_RTT_LO && fps10 >= AQ_FPS_UP * 10u) {
                if (++aq_streak >= 3) {
                    d = 1;
                }
            } else {
                aq_streak = 0;
            }
        } else {
            /* 05.10: правила 2 — одиночный списанный кадр не в счёт, см. AUTO_Q. */
            bool to_bad = autoq_on == 2 ? false : to > 0;
            bool to_hi  = autoq_on == 2 ? to >= 2 : false;
            if (to_bad || rtt > AUTOQ_RTT_BAD || (!acks && in_flight)) {
                d = -2;
                why = rtt > AUTOQ_RTT_BAD ? 0 : (!acks && in_flight) ? 1 : 4;
            } else if (rtt > AUTOQ_RTT_HI || (!gated && blk > AUTOQ_BLOCK_HI) || to_hi) {
                d = -1;
                why = rtt > AUTOQ_RTT_HI ? 2 : (!gated && blk > AUTOQ_BLOCK_HI) ? 3 : 4;
            } else if (acks && rtt < AUTOQ_RTT_LO && (gated || blk < AUTOQ_BLOCK_LO)) {
                if (++aq_streak >= 3) {
                    d = 1;
                }
            } else {
                aq_streak = 0;
            }
        }
        if (d < 0 && why >= 0 && autoq_idx > 0) {
            aq_why[why]++;
        }
        if (d) {
            aq_streak = 0;
            int8_t ni = autoq_idx + d;
            if (ni < 0) {
                ni = 0;
            }
            if (ni > n - 1) {
                ni = n - 1;
            }
            if (ni != autoq_idx) {
                autoq_idx = ni;
                jpeg_q_rt = autoq_ladder[ni];
                if (d > 0) {
                    aq_ups++;
                } else {
                    aq_downs++;
                }
            }
        }
    }
}
#endif

void loop()
{
    /*
     * Вычитываем и выбрасываем всё, что пришло из USB.
     *
     * Скетч оттуда ничего не ждёт, но НЕ читать нельзя: входной буфер USB
     * переполняется, и плата перестаёт принимать байты вообще. Тогда до неё не
     * достучаться даже загрузчиком — esptool упирается в "Write timeout" и
     * заливка не идёт, пока плату не обесточишь. 20.08 это случилось трижды за
     * день, каждый раз на приёмнике, и каждый раз лечилось выдёргиванием USB.
     */
    /* Пока окно открыто — строки "AT+..." с USB уходят модулю (смена полосы
     * без перепрошивки, см. halow_usb_at_console). После — выбрасываем, но
     * читать обязаны: иначе входной буфер USB переполнится и плата перестанет
     * прошиваться. */
    if (halow_usb_at_console(SerialMon, SerialAT, !streaming)) {
        delay(400);
        while (SerialAT.available()) {
            SerialMon.write((uint8_t)SerialAT.read());
        }
        SerialMon.println();
    }

    if (dbg_stage < 8) {
        dbg_stage = 8;                 /* дошли до основного цикла */
    }
    if (dbg_stage > dbg_maxstage) {
        dbg_maxstage = dbg_stage;
    }
    pumpRx();

    // Ждём, пока в модуле сработает отложенный uart_p2p_init. До этого момента
    // всё, что мы напишем, уйдёт не в эфир, а в разборщик AT-команд.
    if (!streaming) {
        if (millis() < P2P_WINDOW_MS) {
            delay(10);
            return;
        }
        streaming = true;
        /*
         * РЕШАЮЩАЯ ПРОБА. Окно закрылось — значит в прошивке шага 3 модуль уже
         * забрал UART себе, и AT-команда обязана остаться БЕЗ ОТВЕТА.
         * Спрашиваем на 115200, до переключения скорости.
         *
         * Ответил -> модуль в AT-режиме, прозрачный режим не стартовал. Тогда
         * всё, что мы пишем дальше, уходит не в эфир, а в разборщик AT-команд,
         * и на той стороне не появится ни байта — ровно то, что мы наблюдаем.
         */
#if LINK_DIAG
        SerialMon.println("ПРОБА: AT после окна — ответа быть НЕ должно");
        atWindowCmd("AT+VERSION\r\n");
#endif
        /*
         * Окно было настоящим? Если модуль не ответил НИ РАЗУ, значит он уже
         * сидел в прозрачном режиме с прошлой загрузки: наши настройки не
         * применены, и измерять на этом прогоне нечего.
         */
        /* Порог 3, а не 1: одиночное совпадение могло прийти из потока. */
        if (at_window_answers < 3) {
            SerialMon.println("");
            SerialMon.printf("!!!! СТАРТОВОЕ ОКНО НЕ ОТКРЫЛОСЬ !!!! (ответов с OK: %u)\n",
                             (unsigned)at_window_answers);
            SerialMon.println("Модуль почти не отвечает — значит он");
            SerialMon.println("уже в прозрачном режиме с ПРОШЛОЙ загрузки.");
            SerialMon.println("Настройки (MCAST_BW, MCAST_MCS, P2PDEST) НЕ применены,");
            SerialMon.println("модуль работает на том, что было задано раньше.");
            SerialMon.println("ПРОГОН НЕДЕЙСТВИТЕЛЕН. Снимите питание с платы");
            SerialMon.println("физически — перепрошивка ESP32 окна не открывает.");
            SerialMon.println("");
        } else {
            SerialMon.printf("Стартовое окно открыто: %u ответов с OK — "
                             "настройки применены\n",
                             (unsigned)at_window_answers);
        }
        dbg_stage = 9;                 /* стартовое окно закрылось, идём в поток */
        if (P2P_BAUD != AT_BAUD) {
            // Пригодится, когда поднимем UART_P2P_BAUDRATE: окно всегда идёт на
            // 115200, поток — на новой скорости, порт надо переоткрыть.
            SerialAT.updateBaudRate(P2P_BAUD);
        }
        halow_p2p_rx_init(&rx);   // выкидываем накопленный загрузочный лог модуля
        stats_tick = millis();
        hello_since_ms = hello_wait_tick = millis();
#if WAIT_FOR_HELLO
        SerialMon.println("Окно закрыто. Молчу и жду первого отчёта приёмника.");
#else
        tx_enabled = true;
        SerialMon.println("Окно закрыто, начинаю поток (гейт по отчёту выключен)");
#endif
    }

#if PAYLOAD_SWEEP
    psweep_tick();
#endif
#if GAP_SWEEP
    sweep_tick();
#endif
#if FRAME_GAP_SWEEP
    fsweep_tick();
#endif

    if (link_up && millis() - last_stat_ms > LINK_TIMEOUT_MS) {
        link_up = false;
    }

#if WAIT_FOR_HELLO
    /*
     * ГЕЙТ ПЕРЕДАЧИ. Первый 'S' от приёмника открывает поток; до него камера
     * не пишет в модуль ни байта. last_stat_ms ненулевой ровно тогда, когда
     * отчёт хоть раз доехал (pumpRx выставляет его вместе с link_up).
     */
    if (!tx_enabled && last_stat_ms) {
        tx_enabled = true;
        SerialMon.printf("ОТЧЁТ ПРИЁМНИКА ПОЛУЧЕН через %lu с — связь есть, "
                         "открываю поток\n",
                         (unsigned long)((millis() - hello_since_ms) / 1000));
        halow_mon_settle();
        /* Период статистики отсчитываем от этого момента, иначе первая строка
         * усреднит fps по всему времени ожидания и покажет ноль. */
        stats_tick = millis();
        frames_sent = bytes_sent = 0;
        cam_ms_acc = copy_ms_acc = jpeg_ms_acc = send_ms_acc = 0;
        stage_frames = cap_frames = 0;
    }
#if HELLO_WAIT_MAX_MS
    if (!tx_enabled && millis() - hello_since_ms > HELLO_WAIT_MAX_MS) {
        tx_enabled = true;
        SerialMon.println("ВНИМАНИЕ: отчёта так и нет, аварийный клапан открыл "
                          "поток вслепую (HELLO_WAIT_MAX_MS)");
        halow_mon_settle();
    }
#endif
#if RESTREAM_ON_HELLO_LOSS
    if (tx_enabled && last_stat_ms && millis() - last_stat_ms > HELLO_LOST_MS) {
        tx_enabled = false;
        last_stat_ms = 0;
        hello_since_ms = hello_wait_tick = millis();
        SerialMon.println("Отчёты пропали — закрываю поток и жду заново");
        halow_mon_settle();
    }
#endif
#if AIR_LOG
    airlog_pump();
#endif
    if (!tx_enabled) {
#if HELLO_PROBE_MS
        /* Маячок: дать модулю повод ассоциироваться. Без него он в прозрачном
         * режиме не выходит в эфир вовсе — см. HELLO_PROBE_MS. */
        static uint32_t probe_tick = 0;
        if (millis() - probe_tick >= HELLO_PROBE_MS) {
            probe_tick = millis();
            static const uint8_t body[4] = { 'H', 'L', 'W', 'P' };
            int n = halow_p2p_build(pkt, HALOW_P2P_TYPE_PING, body, sizeof(body));
            if (n > 0) {
                SerialAT.write(pkt, n);
                p2pGap();
            }
        }
#endif
        /* Молчание — это и есть результат замера: ассоциации нет. Печатаем
         * раз в пять секунд, чтобы в логе было видно, сколько она не встаёт. */
        if (millis() - hello_wait_tick > 5000) {
            hello_wait_tick = millis();
            SerialMon.printf("[нет связи] жду отчёта приёмника, %lu с | RAM %u\n",
                             (unsigned long)((millis() - hello_since_ms) / 1000),
                             (unsigned)ESP.getFreeHeap());
            halow_mon_settle();
        }
        digitalWrite(BOARD_LED, LOW);
        delay(10);
        return;
    }
#endif
    digitalWrite(BOARD_LED, link_up);
#if EXP_PROGRAM
    exp_tick(millis());
#endif
#if AUTO_Q
    autoq_tick(millis());
#endif

    if (millis() - stats_tick > STATS_PERIOD_MS) {
        uint32_t dt = millis() - stats_tick;
        stats_tick = millis();

        uint32_t fps10 = dt ? frames_sent * 10000u / dt : 0;
        uint32_t kbps10 = dt ? bytes_sent * 10000u / 1024u / dt : 0;
        SerialMon.printf("[%s] %u.%u fps | %u.%u КБ/с | камера: %s | RAM %u\n",
                         link_up ? "связь" : "нет связи",
                         fps10 / 10, fps10 % 10, kbps10 / 10, kbps10 % 10,
                         cam_info, (unsigned)ESP.getFreeHeap());
#if VSYNC_PROBE
        {
            static uint32_t vs_prev = 0, vs_t = 0;
            uint32_t now_ms = millis(), e = vs_edges;
            if (vs_t && now_ms != vs_t) {
                uint32_t r10 = (e - vs_prev) * 10000u / (now_ms - vs_t);
                SerialMon.printf("  VSYNC: фронтов %lu.%lu/с (честный VSYNC — два на кадр сенсора)\n",
                                 (unsigned long)(r10 / 10), (unsigned long)(r10 % 10));
            }
            vs_prev = e;
            vs_t = now_ms;
        }
#endif
#if CAM_SIG_COUNT
        if (sig_ok) {
            int16_t v = 0, h = 0;
            pcnt_get_counter_value(PCNT_UNIT_0, &v);
            pcnt_get_counter_value(PCNT_UNIT_1, &h);
            pcnt_counter_clear(PCNT_UNIT_0);
            pcnt_counter_clear(PCNT_UNIT_1);
            sig_vs_last = v;
            sig_hr_last = h;
            uint32_t vs10 = dt ? (uint32_t)(v < 0 ? 0 : v) * 10000u / dt : 0;
            uint32_t hr1 = dt ? (uint32_t)(h < 0 ? 0 : h) * 1000u / dt : 0;
            SerialMon.printf("  СИГНАЛЫ СЕНСОРА: кадров (VSYNC) %lu.%lu/с, строк (HREF) %lu/с\n",
                             (unsigned long)(vs10 / 10), (unsigned long)(vs10 % 10),
                             (unsigned long)hr1);
        }
#endif
#if CAM_CHECK_ON
        if (cam_live_n) {
            uint32_t avg100 = (uint32_t)(cam_live_sum * 100.0f / cam_live_n);
            uint32_t bad10  = cam_live_bad * 1000u / cam_live_n;
            SerialMon.printf("  ЗАХВАТ: шершавость сейчас %u.%02u, средняя %u.%02u, "
                             "поражено %u.%u%% (%lu из %lu, порог %u.0)\n",
                             (unsigned)(cam_live_last), (unsigned)((uint32_t)(cam_live_last*100)%100),
                             avg100 / 100, avg100 % 100, bad10 / 10, bad10 % 10,
                             (unsigned long)cam_live_bad, (unsigned long)cam_live_n,
                             (unsigned)CAM_CHECK_THRESHOLD);
#if CAM_REPAIR
            SerialMon.printf("  ПРАВКА СЛИПА: вылечено %lu из %lu поражённых, "
                             "осталось %lu, цена %lu мкс на кадр\n",
                             (unsigned long)cam_fix_ok, (unsigned long)cam_fix_try,
                             (unsigned long)cam_fix_left,
                             (unsigned long)(cam_fix_try ? cam_fix_us / cam_fix_try : 0));
#endif
#if SHUTTER_TEST
            {
                unsigned long n0 = sh_n[0], b0 = sh_bad[0], v0 = sh_votes[0];
                unsigned long n1 = sh_n[1], b1 = sh_bad[1], v1 = sh_votes[1];
                SerialMon.printf("  ШТОРКА (цикл %lu): ПЕРЕДАЧА %lu кадров, со сдвигом %lu = %lu.%lu%%, "
                                 "строк на кадр %lu.%lu | ТИШИНА %lu кадров, со сдвигом %lu = %lu.%lu%%, "
                                 "строк на кадр %lu.%lu\n",
                                 (unsigned long)sh_cycles,
                                 n0, b0, n0 ? b0 * 100 / n0 : 0, n0 ? (b0 * 1000 / n0) % 10 : 0,
                                 n0 ? v0 / n0 : 0, n0 ? (v0 * 10 / n0) % 10 : 0,
                                 n1, b1, n1 ? b1 * 100 / n1 : 0, n1 ? (b1 * 1000 / n1) % 10 : 0,
                                 n1 ? v1 / n1 : 0, n1 ? (v1 * 10 / n1) % 10 : 0);
                /* Гистограмма — раз в десять строк статистики, она длинная.
                 * Формат интервала: «сдвиг/всего», интервалы по SH_HIST_MS. */
                if (++sh_hist_print % 10 == 0) {
                    for (int ph = 0; ph < 2; ph++) {
                        SerialMon.printf("  ШТОРКА-ГИСТ %s:", ph ? "ТИШИНА  " : "ПЕРЕДАЧА");
                        for (int i = 0; i < SH_HIST_BINS; i++) {
                            SerialMon.printf(" %lu/%lu", (unsigned long)sh_hb[ph][i],
                                             (unsigned long)sh_hn[ph][i]);
                        }
                        SerialMon.printf("\n");
                    }
                }
            }
#endif
        }
#endif

        // Счётчики приёмника — единственный способ увидеть потери: у нас на
        // передаче никаких подтверждений нет.
        if (link_up) {
            SerialMon.printf("  ПРИЁМНИК ok=%lu crc_err=%lu кадров=%lu последний=%lu\n",
                             (unsigned long)peer.pkts_ok,
                             (unsigned long)peer.pkts_crc_err,
                             (unsigned long)peer.frames_done,
                             (unsigned long)peer.last_frame_id);
        }
        /* 05.10: свой приём камеры — где теряются квитанции (~10 % в ROLE_SWAP).
         * crc_err/len_err растут — пакеты бьются на UART модуля камеры; не растут —
         * квитанции пропадают раньше, в эфире или в модуле приёмника. junk — сюда
         * же текст отчётов модуля, он растёт всегда. */
        SerialMon.printf("  СВОЙ ПРИЁМ ok=%lu crc_err=%lu len_err=%lu junk=%lu\n",
                         (unsigned long)rx.n_ok, (unsigned long)rx.n_crc_err,
                         (unsigned long)rx.n_len_err, (unsigned long)rx.n_junk);

        /* Задержка по подтверждениям: средние — за весь прогон, мин/макс — за
         * период. Отправлено всего frames_total; разница с подтверждёнными —
         * кадры без последнего чанка или подтверждения, потерянные в пути. */
        SerialMon.printf("  ЗАДЕРЖКА: отправлено %lu, подтверждено %lu (неполных %lu, чужих %lu) | "
                         "RTT ср %lu мин %lu макс %lu мс | съёмка->подтверждение ср %lu макс %lu мс | t=%lu\n",
                         (unsigned long)frames_total, (unsigned long)lat_acks,
                         (unsigned long)lat_incomplete, (unsigned long)lat_unmatched,
                         (unsigned long)(lat_acks ? lat_rtt_sum / lat_acks : 0),
                         (unsigned long)(lat_rtt_min == 0xFFFFFFFFu ? 0 : lat_rtt_min),
                         (unsigned long)lat_rtt_max,
                         (unsigned long)(lat_acks ? lat_age_sum / lat_acks : 0),
                         (unsigned long)lat_age_max, (unsigned long)millis());
        if (ck_sent) {
            uint32_t pm = (uint32_t)((uint64_t)(ck_sent - ck_got) * 1000u / ck_sent);
            SerialMon.printf("  КУСКИ: дошло %lu из %lu (пропало %lu.%lu %%), по месту: первый %lu, "
                             "средние %lu, последний %lu, квитанций со списком %lu\n",
                             (unsigned long)ck_got, (unsigned long)ck_sent,
                             (unsigned long)(pm / 10), (unsigned long)(pm % 10),
                             (unsigned long)ck_lost_pos[0], (unsigned long)ck_lost_pos[1],
                             (unsigned long)ck_lost_pos[2], (unsigned long)ck_mask_acks);
        }
        lat_rtt_max = lat_age_max = 0;
        lat_rtt_min = 0xFFFFFFFFu;
#if FC_WINDOW
        SerialMon.printf("  ОКНО: W=%u, в полёте %lu, списано по таймауту %lu, выброшено "
                         "устаревших %lu, окно закрыто при готовом кадре %lu мс\n",
                         (unsigned)fc_window, (unsigned long)(frame_id - fc_last_ack_id),
                         (unsigned long)fc_timeouts, (unsigned long)fc_skipped,
                         (unsigned long)fc_blocked_ms);
#endif
#if GATED_CAPTURE
        SerialMon.printf("  ПАУЗЫ: циклов %lu, тишина ср %lu мс, без %u чистых %lu, "
                         "кадров чистых %lu, грязных %lu, кадр сенсора %lu мс\n",
                         (unsigned long)gate_cycles,
                         (unsigned long)(gate_cycles ? gate_quiet_ms_sum / gate_cycles : 0),
                         (unsigned)GATE_FRAMES, (unsigned long)gate_forced,
                         (unsigned long)gate_clean, (unsigned long)gate_dirty,
                         (unsigned long)gate_frame_ms);
        SerialMon.printf("  ПАУЗЫ-РЕЖИМ: %s, мощность %d дБм (строк %lu), вкл от %d, выкл до %d, "
                         "переключений %lu, с паузами %lu с, без %lu с\n",
                         gate_on ? "ВКЛ" : "выкл", (int)mod_pwr_dbm,
                         (unsigned long)mod_pwr_seen, (int)GATE_PWR_ON, (int)GATE_PWR_OFF,
                         (unsigned long)gate_switches,
                         (unsigned long)(gate_on_ms / 1000), (unsigned long)(gate_off_ms / 1000));
#endif
#if AUTO_Q
        SerialMon.printf("  АВТОКАЧЕСТВО: %s, Q=%u, RTT %lu мс, к/с %lu.%lu, окно закрыто %lu мс из 1000, "
                         "вверх %lu, вниз %lu | вниз из-за: RTT>%d %lu, нет квит %lu, "
                         "RTT>%d %lu, окно %lu, списания %lu, мало к/с %lu | запоздалых квит %lu\n",
                         synth_on || !autoq_on ? "выкл" : autoq_on == 4 ? "вкл4"
                                               : autoq_on == 3 ? "вкл3"
                                               : autoq_on == 2 ? "вкл2" : "вкл",
                         (unsigned)jpeg_q_rt,
                         (unsigned long)aq_last_rtt,
                         (unsigned long)(aq_last_fps10 / 10), (unsigned long)(aq_last_fps10 % 10),
                         (unsigned long)aq_last_blk,
                         (unsigned long)aq_ups, (unsigned long)aq_downs,
                         (int)AUTOQ_RTT_BAD, (unsigned long)aq_why[0], (unsigned long)aq_why[1],
                         (int)AUTOQ_RTT_HI, (unsigned long)aq_why[2], (unsigned long)aq_why[3],
                         (unsigned long)aq_why[4], (unsigned long)aq_why[5], (unsigned long)aq_late);
#endif
#if AIR_LOG
        SerialMon.printf("  ЛОГ ПО ВОЗДУХУ: пакетов %lu, байт %lu, в кольце %lu, пропущено %lu\n",
                         (unsigned long)airlog_pkts, (unsigned long)airlog_bytes,
                         (unsigned long)(airlog_head - airlog_tail),
                         (unsigned long)airlog_lost_total);
#endif
        if (++lat_hist_print % 10 == 0) {
            SerialMon.printf("  ЗАДЕРЖКА-ГИСТ (съёмка->подтверждение, шаг %u мс):",
                             (unsigned)LAT_HIST_MS);
            for (int i = 0; i < LAT_HIST_BINS; i++) {
                SerialMon.printf(" %lu", (unsigned long)lat_hist[i]);
            }
            SerialMon.printf("\n");
        }

        if (stage_frames) {
            /* Съёмка и передача идут с разной частотой: при конвейере снимается
             * больше кадров, чем успевает уехать. Поэтому средние по камере и
             * сжатию считаем по снятым, а по UART — по отправленным. */
            uint32_t cam_avg = cap_frames ? cam_ms_acc / cap_frames : 0;
            uint32_t copy_avg = cap_frames ? copy_ms_acc / cap_frames : 0;
            uint32_t jpeg_avg = cap_frames ? jpeg_ms_acc / cap_frames : 0;
            uint32_t send_avg = send_ms_acc / stage_frames;
            uint32_t frame_period = dt / stage_frames;
            uint32_t busy = cam_avg + copy_avg + jpeg_avg + send_avg;
            uint32_t gaps_avg = frame_period > busy ? frame_period - busy : 0;
            /* Столбец «копия» — цена развязки по памяти. «JPEG» после неё должен
             * стать меньше, чем был при сжатии прямо из PSRAM. */
            SerialMon.printf("  STAGE камера %ums | копия %ums | JPEG %ums | UART %ums | "
                             "паузы+прочее %ums | итого на кадр %ums\n",
                             (unsigned)cam_avg, (unsigned)copy_avg, (unsigned)jpeg_avg,
                             (unsigned)send_avg, (unsigned)gaps_avg,
                             (unsigned)frame_period);
        }

#if CHECK_FB
        if (fb_checked) {
            SerialMon.printf("  БУФЕР КАДРА: проверено %lu, изменился во время сжатия %lu\n",
                             (unsigned long)fb_checked, (unsigned long)fb_torn);
        }
#endif
#if CHECK_ENCODER
        if (enc_checked) {
            SerialMon.printf("  КОДИРОВЩИК: сжато дважды %lu, результаты разошлись %lu\n",
                             (unsigned long)enc_checked, (unsigned long)enc_diff);
        }
#endif
#if CHECK_COPY
        if (copy_checked) {
            SerialMon.printf("  КОПИЯ В SRAM: проверено %lu, оригинал менялся во время "
                             "копирования %lu\n",
                             (unsigned long)copy_checked, (unsigned long)copy_torn);
        }
#endif
#if ENCODE_FROM_SRAM
        if (enc_from_psram) {
            SerialMon.printf("  ВНИМАНИЕ: кадров сжато прямо из PSRAM %lu\n",
                             (unsigned long)enc_from_psram);
        }
#endif

#if PIPELINE
        SerialMon.printf("  КОНВЕЙЕР: выброшено кадров %lu (передача не успевала), "
                         "кодировщиков %u, сжатых позже нового %lu\n",
                         (unsigned long)pipe_dropped, (unsigned)ENC_WORKERS,
                         (unsigned long)enc_reordered);
#endif

        frames_sent = 0;
        bytes_sent = 0;
        cam_ms_acc = copy_ms_acc = jpeg_ms_acc = send_ms_acc = 0;
        stage_frames = cap_frames = 0;

        // Раз в две секунды дождаться, пока напечатанное уйдёт в USB. На фоне
        // периода в 2 с это ничего не стоит, а лог перестаёт теряться, когда
        // конвейер занимает ядро (см. пояснение к flush в setup).
        halow_mon_settle();
    }

    if (!camera_ok) {
        delay(10);
        return;
    }

#if TEST_PATTERN
    // Камеру больше не трогаем: шлём один и тот же буфер. Если полосы на
    // приёмнике окажутся каждый раз новыми — портит передача, а не камера.
    if (tp_jpg) {
        uint32_t t0 = millis();
        sendFrame(tp_jpg, tp_len);
        send_ms_acc += (millis() - t0);
        stage_frames++;
        if (frame_gap_ms) {
            delay(frame_gap_ms);
        }
    }
    return;
#endif

#if SHUTTER_TEST
    if (tx_enabled) {
        shutter_tick();
    }
#endif
#if PIPELINE
    /* Передача. Захват и сжатие идут параллельно в camera_task на другом ядре.
     * Если задача не поднялась (не хватило внутреннего буфера или не создалась
     * очередь), jpg_q == NULL — тогда проваливаемся в последовательный путь
     * ниже, он остаётся рабочим. */
    if (jpg_q) {
#if GATED_CAPTURE
        gate_mode_update(millis());
        if (gate_on) {
            uint32_t now = millis();
            /* fc_can_send списывает кадр без подтверждения, только когда окно
             * полно, а здесь тишина ждёт, пока в пути станет 0. Потерянная
             * квитанция на одиночный кадр останавливала передачу навсегда
             * (29.09, стоп на 4-м кадре) — просроченные списываем и так. */
            while (frame_id != fc_last_ack_id) {
                uint32_t oldest = fc_last_ack_id + 1;
                lat_slot_t *s = &lat_ring[oldest % LAT_RING];
                if (s->id == oldest && s->sent_ms &&
                    millis() - s->sent_ms <= GATE_ACK_TIMEOUT_MS) {
                    break;
                }
                fc_last_ack_id = oldest;
                fc_timeouts++;
            }
            bool can = fc_can_send();
            bool in_flight = (frame_id != fc_last_ack_id);
            bool have = uxQueueMessagesWaiting(jpg_q) > 0;
            if (gate_quiet) {
                bool enough = gate_clean_cur >= GATE_FRAMES;
                bool too_long = now - gate_quiet_t0 > GATE_QUIET_MAX_MS;
                if (!have || !(enough || too_long)) {
                    delay(1);
                    return;                        /* молчим, камера снимает */
                }
                if (!enough) {
                    gate_forced++;
                }
                gate_end_quiet(now);
                gate_sent_busy = 0;
            } else if (gate_sent_busy >= GATE_FRAMES || !have || !can) {
                if (!in_flight && (gate_sent_busy >= GATE_FRAMES || !have)) {
                    gate_begin_quiet(now);         /* всё подтверждено, модуль пуст */
                }
                delay(1);
                return;
            }
        } else
#endif
        {
#if FC_WINDOW
        if (!fc_can_send()) {
            /* Окно закрыто. Полную очередь не держим: старший кадр в сброс,
             * камера тут же снимет свежий. */
            if (uxQueueMessagesWaiting(jpg_q) >= 2) {
                jpg_item_t old;
                if (xQueueReceive(jpg_q, &old, 0) == pdTRUE) {
                    free(old.buf);
                    fc_skipped++;
                }
            }
            if (uxQueueMessagesWaiting(jpg_q) > 0) {
                fc_blocked_ms++;        /* кадр готов, а окно закрыто; ~1 мс на проход */
            }
            delay(1);
            return;
        }
        /* Окно открыто: уходит самый свежий кадр, старшие — в сброс. */
        while (uxQueueMessagesWaiting(jpg_q) > 1) {
            jpg_item_t old;
            if (xQueueReceive(jpg_q, &old, 0) != pdTRUE) {
                break;
            }
            free(old.buf);
            fc_skipped++;
        }
#endif
        }
        jpg_item_t it;
        if (xQueueReceive(jpg_q, &it, 0) == pdTRUE) {
#if SHUTTER_TEST
            /* Тишина: кадр снят, сжат и измерен, но в модуль не идёт.
             * Очередь при этом разгребаем, иначе захват встанет. */
            if (sh_state >= SH_OFF_SETTLE) {
                free(it.buf);
                return;
            }
#endif
            /* Сжался позже более нового, который уже ушёл, — не показываем
             * приёмнику прошлое. См. ENC_WORKERS. */
            if (it.seq && it.seq <= last_sent_seq) {
                free(it.buf);
                enc_reordered++;
                return;
            }
            last_sent_seq = it.seq;
            uint32_t t_send0 = millis();
            lat_next_cap_ms = it.cap_ms;
            sendFrame(it.buf, it.len);
            send_ms_acc += (millis() - t_send0);
            free(it.buf);
            stage_frames++;
#if GATED_CAPTURE
            gate_sent_busy++;
#endif
            if (frame_gap_ms) {
                delay(frame_gap_ms);
            }
        } else {
            delay(2);           // кадра пока нет, отдаём время другим задачам
        }
        return;
    }
#endif
    uint8_t *jpg = NULL;
    size_t   jpg_len = 0;
    uint32_t t_send0 = millis();

    if (!captureFrame(&jpg, &jpg_len, &lat_next_cap_ms)) {
        delay(10);
        return;
    }
    t_send0 = millis();
    sendFrame(jpg, jpg_len);
    send_ms_acc += (millis() - t_send0);
    free(jpg);
    stage_frames++;

    if (frame_gap_ms) {
        delay(frame_gap_ms);
    }
}
