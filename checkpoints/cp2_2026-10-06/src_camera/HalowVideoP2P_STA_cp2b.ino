//************************************[ ПОТОК ]******************************************

// Вычёрпывает UART и разбирает то, что прислал приёмник. Зовётся и между
// чанками тоже — иначе за время кадра приёмный буфер успеет переполниться.
#if LMAC_STATS
/*
 * Сбор текстовых строк, которые модуль печатает вперемешку с отчётами
 * приёмника. Кадрирование их всё равно отбрасывает, но нам они нужны.
 *
 * Отличаем текст от двоичного мусора по содержимому: печатаем только строки с
 * узнаваемыми метками статистики. Иначе в консоль полезли бы обрывки кадров.
 */
static char  lmac_line[256];   /* 06.10: было 160 — длинные строки модуля пропадали целиком */
static uint8_t lmac_len = 0;
#if LMAC_DBG_EVERY
static uint32_t lmac_tp_seen = 0;       /* строк смены лучшей (tp1=/tp2=) всего */
#endif

static void lmacTextByte(uint8_t c)
{
    if (c == '\n' || c == '\r') {
        lmac_line[lmac_len] = 0;
#if LMAC_DBG_EVERY
        /* Отчёт модуля целиком, см. LMAC_DBG_EVERY. */
        static uint8_t  dbg_blk = 0, dbg_left = 0;
        static uint32_t dbg_tp_ms = 0;
        bool dbg_pass = false;
        if (strstr(lmac_line, "LMAC STATUS")) {
            dbg_left = (++dbg_blk % LMAC_DBG_EVERY == 0) ? LMAC_DBG_LINES : 0;
        }
        if (dbg_left && lmac_len >= 4) {
            dbg_left--;
            dbg_pass = true;
        }
        if (strstr(lmac_line, "tp1=") || strstr(lmac_line, "tp2=")) {
            lmac_tp_seen++;
            uint32_t now = millis();
            if (now - dbg_tp_ms >= 250) {        /* не чаще 4 в секунду */
                dbg_tp_ms = now;
                dbg_pass = true;
            }
        }
#else
        const bool dbg_pass = false;
#endif
#if EXP_PROGRAM
        /* «tx0: mcs=*6 snr=34 data=478KB(248kbps) per=61» — эфир и повторы. */
        if (const char *t0 = strstr(lmac_line, "tx0:")) {
            const char *m = strstr(t0, "mcs=");
            const char *d = strstr(t0, "data=");
            const char *r = d ? strchr(d, '(') : NULL;
            const char *pp = strstr(t0, " per=");
            if (m && d && r && pp) {
                m += 4;
                if (*m == '*') {
                    m++;
                }
                exp_mcs_sum += (uint32_t)atoi(m);
                exp_tx0_kb = (uint32_t)atoi(d + 5);
                exp_air_sum += (uint32_t)atoi(r + 1);
                exp_per_sum += (uint32_t)atoi(pp + 5);
                exp_mod_n++;
            }
        }
#endif
#if GATED_CAPTURE
        /* «PWRCTL snr=... pwr=N ...» — текущая мощность модуля, см.
         * GATE_PWR_ON. Ответ на AT+PWRCTL («+PWRCTL:mode=...») не годится:
         * в нём pwr=0 до первой подстройки. */
        if (strstr(lmac_line, "PWRCTL snr=")) {
            const char *pp = strstr(lmac_line, " pwr=");
            if (pp) {
                mod_pwr_dbm = (int8_t)atoi(pp + 5);
                mod_pwr_seen++;
            }
        }
#endif
        /*
         * СТРОГИЙ ОТБОР ПО МЕТКАМ — не косметика, а вопрос скорости.
         *
         * 17.09 фильтр был ослаблен до «любая строка от 10 символов», чтобы
         * выяснить, говорит ли модуль хоть что-нибудь после старта прозрачного
         * режима. В таком виде он попал в прогоны 18-19.09 и ОБРЕЗАЛ ИХ ВДВОЕ:
         * 4.7 кадра в секунду вместо расчётных десяти, 107 кбит/с вместо 220.
         *
         * Механика: печать идёт из pumpRx, то есть из тракта передачи, а
         * запись в USB-CDC блокирует до 100 мс (см. halow_mon_settle и
         * setTxTimeoutMs). Модуль раз в период вываливает два десятка строк, а
         * ослабленный фильтр пропускал ещё и случайные печатные
         * последовательности из двоичного потока отчётов приёмника.
         *
         * Метки оставлены те, что реально нужны: per=, snr=, STA. Остальное
         * модуль печатает для отладки радио, и нам оно не нужно.
         */
        if (dbg_pass ||
            (lmac_len >= 6 &&
             (strstr(lmac_line, "per=") || strstr(lmac_line, "snr=") ||
              strstr(lmac_line, "STA")))) {
            SerialMon.printf("  МОДУЛЬ: %s\n", lmac_line);
        }
        lmac_len = 0;
        return;
    }
#if LMAC_DBG_EVERY
    if (c == '\t') {                 /* таблица может быть с табуляцией */
        c = ' ';
    }
#endif
    if (c < 0x20 || c > 0x7e) {      /* двоичный байт — строка не текстовая */
        lmac_len = 0;
        return;
    }
    if (lmac_len < sizeof(lmac_line) - 1) {
        lmac_line[lmac_len++] = (char)c;
    } else {
        lmac_len = 0;
    }
}
#endif

static void pumpRx(void)
{
    while (SerialAT.available()) {
        int c = SerialAT.read();
        if (c < 0) {
            break;
        }
#if LMAC_STATS
        lmacTextByte((uint8_t)c);
#endif
        if (!halow_p2p_rx_byte(&rx, (uint8_t)c)) {
            continue;
        }
        if (rx.type == HALOW_P2P_TYPE_STAT && rx.len >= sizeof(halow_p2p_stat_t)) {
            halow_p2p_stat_t s;
            memcpy(&s, rx.body, sizeof(s));
            if (s.magic[0] == 'H' && s.magic[1] == 'L' &&
                s.magic[2] == 'W' && s.magic[3] == 'S') {
                peer = s;
                last_stat_ms = millis();
                link_up = true;
            }
        } else if (rx.type == HALOW_P2P_TYPE_ACK && rx.len >= HALOW_P2P_ACK_LEN_V1) {
            /* 05.10: оба размера — старый приёмник шлёт без списка кусков. */
            halow_p2p_ack_t a;
            bool has_mask = rx.len >= sizeof(a);
            memset(&a, 0, sizeof(a));
            memcpy(&a, rx.body, has_mask ? sizeof(a) : HALOW_P2P_ACK_LEN_V1);
            if (a.magic[0] == 'H' && a.magic[1] == 'L' &&
                a.magic[2] == 'W' && a.magic[3] == 'A') {
                lat_on_ack(&a, has_mask);
            }
        }
    }
}

/* Разделитель после любого пакета в модуль: без него соседние пакеты
 * склеиваются в один эфирный кадр. См. CHUNK_GAP_US. */
static void p2pGap(void)
{
#if CHUNK_GAP_US
    SerialAT.flush();                  /* ждёт только передачу, приём не трогает */
    delayMicroseconds(chunk_gap_us);
#else
    if (chunk_gap_ms) {
        delay(chunk_gap_ms);
    }
#endif
}

static bool sendChunk(const uint8_t *payload, uint16_t len,
                      uint16_t idx, uint16_t cnt, uint32_t total_len,
                      uint16_t frame_crc)
{
    uint8_t body[HALOW_P2P_MAX_BODY];
    halow_app_hdr_t hdr;

    hdr.magic[0] = 'H';
    hdr.magic[1] = 'L';
    hdr.magic[2] = 'W';
    hdr.magic[3] = '2';
    hdr.frame_id = frame_id;
    hdr.frame_len = total_len;
    hdr.chunk_idx = idx;
    hdr.chunk_cnt = cnt;
    hdr.payload_len = len;
    hdr.frame_crc = frame_crc;   // одна на все чанки кадра
    /*
     * Поле rssi на прозрачной прошивке всегда было бы нулём: AT+RSSI недоступен,
     * спросить не у кого. Поэтому на время подбора паузы кладём в него саму
     * паузу в миллисекундах — так она доезжает до ПК тем же путём, что и видео,
     * и попадает в CSV логгера в столбец sta_rssi РЯДОМ со счётчиками брака
     * приёмника. Обратный канал для этого не годится: он глохнет, пока
     * передатчик занимает эфир, и отчёты теряются.
     */
#if PAYLOAD_SWEEP
    hdr.rssi = (int8_t)(chunk_payload / 20);   // 70 -> 1400 байт, 13 -> 260
#elif GAP_SWEEP
    hdr.rssi = (int8_t)chunk_gap_ms;
#elif FRAME_GAP_SWEEP
    /* +100, чтобы в логе нельзя было спутать с паузой чанка: 110 -> 10 мс. */
    hdr.rssi = (int8_t)(100 + frame_gap_ms);
#else
    hdr.rssi = 0;               // на прозрачной прошивке AT+RSSI недоступен
#endif
    hdr.flags = (idx + 1 == cnt) ? HALOW_FLAG_LAST : 0;

    memcpy(body, &hdr, HALOW_APP_HDR_LEN);
    memcpy(body + HALOW_APP_HDR_LEN, payload, len);

    int pkt_len = halow_p2p_build(pkt, HALOW_P2P_TYPE_VIDEO,
                                  body, (uint16_t)(HALOW_APP_HDR_LEN + len));
    if (pkt_len < 0) {
        return false;
    }

    // Записи никто не подтверждает: модуль просто отдаёт байты в эфир. Ответа
    // ждать не от кого и незачем — потери ловит CRC на приёмнике.
    SerialAT.write(pkt, pkt_len);
    bytes_sent += pkt_len;
    bytes_total += pkt_len;

    p2pGap();
    /*
     * 25.09: pumpRx() отсюда УБРАН, теперь он зовётся один раз на кадр в
     * sendFrame().
     *
     * Он стоял после КАЖДОГО чанка, то есть трижды на кадр, и каждый раз
     * побайтно разгребал весь накопившийся входящий текст: отчёты приёмника,
     * статистику LMAC, строки UARTSTAT. На 3 Мбод этого текста стало много, и
     * замер показал разрыв: стадия UART занимала 54-63 мс при расчётных 32.5
     * (провод 13.5 + три паузы по 3 + пауза кадра 10). Недостающие ~25 мс —
     * это и есть разбор обратного канала внутри тракта передачи.
     *
     * Тот же класс ошибки мы уже чинили дважды: печать в USB внутри pumpRx
     * (23.09, стоила половины скорости) и запись в USB внутри pumpStream на
     * приёмнике (24.09).
     *
     * Раз в кадр — это раз в ~50 мс, а приёмник шлёт отчёт раз в секунду, так
     * что обратный канал ничего не теряет. Приёмный буфер здесь 2 КБ
     * (setRxBufferSize ниже), за 50 мс на 3 Мбод в него натекает максимум
     * ~150 байт реального трафика — запас двенадцатикратный.
     */
    return true;
}

static void sendFrame(const uint8_t *buf, uint32_t total_len)
{
    uint16_t cnt = (uint16_t)((total_len + chunk_payload - 1) / chunk_payload);
    /*
     * Контрольная сумма ВСЕГО кадра, одна на все его чанки. Каждый чанк уже
     * прикрыт своей CRC на радиоучастке и на USB, но собранный кадр до сих
     * пор никто не проверял целиком. Просмотрщик сверит эту сумму после
     * склейки — и станет видно, показывает ли он ровно то, что уехало с
     * камеры. JPEG у нас единицы килобайт, в 16-битную длину влезает с
     * запасом (лимит 64 КБ).
     */
    uint16_t frame_crc = halow_crc16(buf, (uint16_t)total_len);

    frame_id++;
    for (uint16_t i = 0; i < cnt; i++) {
        uint32_t off = (uint32_t)i * chunk_payload;
        uint16_t len = (uint16_t)min((uint32_t)chunk_payload, total_len - off);

        if (!sendChunk(buf + off, len, i, cnt, total_len, frame_crc)) {
            return;
        }
    }
    /* Отметка для замера задержки — ДО pumpRx: подтверждение могут разобрать
     * прямо в нём. */
    {
        lat_slot_t *s = &lat_ring[frame_id % LAT_RING];
        s->id = frame_id;
        s->cap_ms = lat_next_cap_ms;
        s->sent_ms = millis();
        if (!s->sent_ms) s->sent_ms = 1;   /* ноль занят под «уже подтверждён» */
    }
    pumpRx();                  /* один раз на кадр, см. комментарий в sendChunk */
    frames_sent++;
    frames_total++;
    dbg_stage = 10;                    /* хотя бы один кадр ушёл целиком */
}

#if AIR_LOG
/* Отправка лога по воздуху, см. AIR_LOG. Зовётся из loop между кадрами —
 * в UART модуля пишет только этот поток, чанки видео и 'T' не перемешаются. */
static uint16_t airlog_seq = 0;
static uint32_t airlog_last_ms = 0;
static uint32_t airlog_pkts = 0;
static uint32_t airlog_bytes = 0;
static uint8_t  airlog_body[2 + AIRLOG_CHUNK];
static uint8_t  airlog_pkt[HALOW_P2P_HDR_LEN + 2 + AIRLOG_CHUNK];

static void airlog_pump(void)
{
    if (!tx_enabled || !link_up) {
        return;
    }
#if GATED_CAPTURE
    if (gate_quiet) {
        return;                /* тишина: в модуль ни байта, см. GATED_CAPTURE */
    }
#endif
    uint32_t now = millis();
    if (now - airlog_last_ms < AIRLOG_MIN_MS) {
        return;
    }
    uint32_t used = airlog_head - airlog_tail;
    if (!used || (used < AIRLOG_CHUNK && now - airlog_last_ms < AIRLOG_FLUSH_MS)) {
        return;
    }
    uint32_t n = used < AIRLOG_CHUNK ? used : AIRLOG_CHUNK;

    airlog_body[0] = (uint8_t)(airlog_seq & 0xff);
    airlog_body[1] = (uint8_t)(airlog_seq >> 8);
    portENTER_CRITICAL(&airlog_mux);
    uint32_t pos = airlog_tail % AIRLOG_RING;
    uint32_t first = AIRLOG_RING - pos;
    if (first > n) first = n;
    memcpy(airlog_body + 2, airlog_ring + pos, first);
    memcpy(airlog_body + 2 + first, airlog_ring, n - first);
    airlog_tail += n;
    portEXIT_CRITICAL(&airlog_mux);

    int k = halow_p2p_build(airlog_pkt, HALOW_P2P_TYPE_LOG, airlog_body, (uint16_t)(2 + n));
    if (k > 0) {
        SerialAT.write(airlog_pkt, k);
        p2pGap();          /* иначе склеится со следующим чанком видео */
        airlog_pkts++;
        airlog_bytes += (uint32_t)k;
    }
    airlog_seq++;
    airlog_last_ms = now;
}
#endif

#if PAYLOAD_SWEEP
/*
 * Перебор размеров чанка. Устроен так же, как перебор пауз.
 *
 * Печатаемые здесь цифры приблизительны: они опираются на отчёты приёмника по
 * обратному каналу, а он глохнет, пока передатчик занимает эфир. Настоящие
 * числа берутся из CSV логгера — там счётчики приходят по USB и не теряются.
 * Эта строка нужна только чтобы видеть в мониторе, какой шаг сейчас идёт.
 */
static void psweep_tick(void)
{
    const uint8_t n = (uint8_t)(sizeof(sweep_payloads) / sizeof(sweep_payloads[0]));
    uint32_t now = millis();

    if (psweep_step_start == 0) {
        psweep_step_start = now;
        chunk_payload = sweep_payloads[0];
        SerialMon.printf("ПОДБОР ЧАНКА: %u значений по %u с, начинаю с %u байт\n",
                         n, (unsigned)(PSWEEP_STEP_MS / 1000), sweep_payloads[0]);
        return;
    }

    if (!psweep_settled && now - psweep_step_start >= PSWEEP_SETTLE_MS) {
        psweep_settled = true;
        psweep_ok0 = peer.pkts_ok;
        psweep_crc0 = peer.pkts_crc_err;
        psweep_frames0 = frames_total;
        psweep_bytes0 = bytes_total;
        psweep_t0 = now;
        return;
    }

    if (now - psweep_step_start < PSWEEP_STEP_MS) {
        return;
    }

    uint32_t dt = now - psweep_t0;
    uint32_t d_ok = peer.pkts_ok - psweep_ok0;
    uint32_t d_crc = peer.pkts_crc_err - psweep_crc0;
    uint32_t d_fr = frames_total - psweep_frames0;
    uint32_t d_by = bytes_total - psweep_bytes0;
    uint32_t fps10 = dt ? d_fr * 10000u / dt : 0;
    uint32_t kbps = dt ? d_by * 8u / dt : 0;

    SerialMon.printf("ЧАНК %4u байт: %u.%u fps | %u кбит/с | принято %lu | брак %lu\n",
                     sweep_payloads[psweep_idx], fps10 / 10, fps10 % 10, kbps,
                     (unsigned long)d_ok, (unsigned long)d_crc);

    psweep_idx++;
    if (psweep_idx >= n) {
        psweep_idx = 0;
        SerialMon.println("--- круг пройден, повторяю ---");
    }
    chunk_payload = sweep_payloads[psweep_idx];
    psweep_step_start = now;
    psweep_settled = false;
}
#endif

