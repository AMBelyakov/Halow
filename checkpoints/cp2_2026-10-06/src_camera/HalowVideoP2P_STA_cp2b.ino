static int16_t sig_vs_last = -1, sig_hr_last = -1;

/* Тип блока — int, а не pcnt_unit_t: Arduino выносит прототипы функций в начало
 * скетча, выше #include "driver/pcnt.h", и там этого типа ещё нет. */
static bool sig_unit(int unit, int gpio)
{
    const pcnt_unit_t u = (pcnt_unit_t)unit;
    pcnt_config_t c;
    memset(&c, 0, sizeof(c));
    c.pulse_gpio_num = gpio;
    c.ctrl_gpio_num = PCNT_PIN_NOT_USED;
    c.lctrl_mode = PCNT_MODE_KEEP;
    c.hctrl_mode = PCNT_MODE_KEEP;
    c.pos_mode = PCNT_COUNT_INC;
    c.neg_mode = PCNT_COUNT_DIS;
    c.counter_h_lim = 32767;
    c.counter_l_lim = -32768;
    c.unit = u;
    c.channel = PCNT_CHANNEL_0;
    if (pcnt_unit_config(&c) != ESP_OK) {
        return false;
    }
    pcnt_set_filter_value(u, 1000);     /* 1000 тактов APB 80 МГц = 12,5 мкс */
    pcnt_filter_enable(u);
    /* pcnt_unit_config включает подтяжку вверх; драйвер камеры оставил вывод
     * плавающим — возвращаем как было, электрически линию не трогаем. */
    gpio_set_pull_mode((gpio_num_t)gpio, GPIO_FLOATING);
    pcnt_counter_pause(u);
    pcnt_counter_clear(u);
    pcnt_counter_resume(u);
    return true;
}

/* Один раз, после первого подъёма камеры: выводы уже настроены её драйвером, PCNT
 * только подключается к тем же выводам через матрицу GPIO, захвату не мешает. */
static void sig_init(void)
{
    static bool tried = false;
    if (tried) {
        return;
    }
    tried = true;
    sig_ok = sig_unit(PCNT_UNIT_0, CAMERA_PIN_VSYNC) && sig_unit(PCNT_UNIT_1, CAMERA_PIN_HREF);
    SerialMon.printf("СИГНАЛЫ: счётчик VSYNC (GPIO %d) и HREF (GPIO %d) %s\n",
                     (int)CAMERA_PIN_VSYNC, (int)CAMERA_PIN_HREF, sig_ok ? "стоит" : "НЕ ВСТАЛ");
}
#endif

/* Медиана шершавости по нескольким кадрам: один сбойный кадр не решает. */
static float cam_sample_roughness(void)
{
    for (int i = 0; i < CAM_CHECK_SKIP; i++) {
        camera_fb_t *w = esp_camera_fb_get();
        if (w) esp_camera_fb_return(w);
    }
    float v[CAM_CHECK_FRAMES];
    int got = 0;
    for (int i = 0; i < CAM_CHECK_FRAMES; i++) {
        camera_fb_t *fb = esp_camera_fb_get();
        if (!fb) continue;
        cam_cache_fresh(fb);
        v[got++] = cam_roughness(fb);
        cam_fb_give(fb);
    }
    if (!got) return 0.0f;
    for (int i = 1; i < got; i++) {          /* вставками, got <= 5 */
        float k = v[i]; int q = i - 1;
        while (q >= 0 && v[q] > k) { v[q + 1] = v[q]; q--; }
        v[q + 1] = k;
    }
    return v[got / 2];
}

/*
 * ИСПРАВЛЕНИЕ БАЙТОВОГО СЛИПА В СЫРОМ КАДРЕ. ВЕРСИЯ 3 (25.09).
 *
 * Механизм (разобран 15.09): в сыром RGB565 с некоторого смещения k теряется
 * один байт. Дальше до конца кадра старший и младший байты меняются ролями,
 * пиксельная сетка съезжает — отсюда «радуга». Строки при этом целы и разрывов
 * нет, поэтому все проверки на рвань ничего не находили. Починка — вставить
 * один байт обратно на позицию k; какое у него значение, неважно — это один
 * пиксель.
 *
 * Версии 1 и 2 кадры ПОРТИЛИ, и обе по одной причине — абсолютный порог
 * шершавости. Контрастный сюжет превышает его безо всякого слипа, и байт
 * выбрасывался из здорового кадра. Версия 1 раздула кадр с 4 до 25 КБ (потери
 * чанков 47.6%), версия 2 до 15 КБ (потери 28.5%).
 *
 * Здесь порога нет вовсе. Мера порчи — сколько строк УВЕРЕННО читаются со
 * сдвигом на байт: для строки считаются две шершавости, обычная и сдвинутая,
 * и сравниваются друг с другом. Контраст поднимает обе разом и решения не
 * меняет. Вставка принимается, только если таких строк стало МЕНЬШЕ и кадр в
 * целом не стал грубее; иначе — откат.
 *
 * Откат стоит один байт, а не копию кадра в 84 КБ: сдвиг вправо выталкивает
 * из буфера последний байт, и если его сохранить, обратный сдвиг восстановит
 * кадр побайтно. Поэтому неудачная попытка здесь ничего не стоит.
 *
 * ПРОВЕРЕНО НА СОХРАНЁННЫХ КАДРАХ, а не на живом потоке — tools/slip_lab.py,
 * 30 кадров с прошлых прогонов: 16 целых не тронуты ни одним байтом, 11
 * починены полностью, 3 многократно побитых улучшены, испорченных нет.
 * Независимая метрика (вертикальная гладкость, её алгоритм не оптимизирует)
 * улучшилась на всех 14 изменённых кадрах. Оттуда же взяты все константы.
 */
/* 26.09: контрольный прогон без правки дал кадр 6750 Б против 5032 и 46.1%
 * поражённых против 8.9% на том же сюжете. Правка окупается и по времени:
 * сжатие +9 мс, зато UART -9 мс, мелкий кадр быстрее уходит в провод. */
#define CAM_REPAIR        1
#define CAM_REPAIR_ROW    2      /* шаг по строкам при подсчёте съехавших */
#define CAM_REPAIR_PIX    2      /* шаг по пикселям: вчетверо дешевле, вывод тот же */
#define CAM_REPAIR_MAX    4      /* сколько вставок пробовать на одном кадре */
#define CAM_REPAIR_MARGIN 0.75f  /* насколько уверенно сдвиг должен выигрывать */
#define CAM_REPAIR_FINE   24     /* окно мелкого добора, пикселей */

static uint32_t cam_fix_try = 0, cam_fix_ok = 0;   /* поражённых кадров и вылеченных */
static uint32_t cam_fix_left = 0;                  /* остались со съехавшими строками */
static uint32_t cam_fix_us = 0;                    /* суммарная цена правки, мкс */
static uint32_t cam_votes_sum = 0;                 /* съехавших строк на поражённых, сумма */

/*
 * Шершавость участка, начиная с ПРОИЗВОЛЬНОГО байтового смещения. Смещение
 * может быть нечётным — в этом и смысл: так проверяется гипотеза «а если бы
 * сюда был вставлен байт», ничего не меняя в данных. Читаем побайтно: по
 * нечётному адресу uint16 брать нельзя.
 */
static float cam_rough_at(const uint8_t *p, int npix, int step)
{
    if (npix < 2 || step < 1) {
        return 0.0f;
    }
    uint32_t acc = 0, n = 0;
    /* СТАРШИЙ БАЙТ ПЕРВЫЙ. Камера кладёт RGB565 именно так, и это не
     * мелочь: при обратном порядке «съехавшими» выглядят 29 кадров из 30,
     * включая заведомо целые, и правка начинает вставлять байты в здоровые.
     * Именно это случилось в первом прогоне v3: 491 «поражённый» кадр из
     * 493, кадр раздулся до 11 КБ, потери чанков 31%. Сдвинутая картинка
     * остаётся гладкой по горизонтали, поэтому шершавость порчи не видела. */
    uint16_t prev = (uint16_t)((p[0] << 8) | p[1]);
    for (int x = step; x < npix; x += step) {
        const uint8_t *q = p + (size_t)x * 2;
        uint16_t cur = (uint16_t)((q[0] << 8) | q[1]);
        int dr = (int)((prev >> 11) & 0x1f) - (int)((cur >> 11) & 0x1f);
        int dg = (int)((prev >>  5) & 0x3f) - (int)((cur >>  5) & 0x3f);
        int db = (int)( prev        & 0x1f) - (int)( cur        & 0x1f);
        acc += (uint32_t)(abs(dr) << 3) + (uint32_t)(abs(dg) << 2)
             + (uint32_t)(abs(db) << 3);
        n += 3;
        prev = cur;
    }
    return n ? (float)acc / (float)n : 0.0f;
}

/*
 * Уверенно ли сдвинутое чтение ровнее обычного. Больше нуля — участок съехал.
 * Запас нужен затем, что на контрастном сюжете обе величины большие и
 * близкие, и сравнение «хоть на сколько-нибудь» вырождается в подбрасывание
 * монеты.
 */
static float cam_shift_gain(const uint8_t *p, int npix, int step, float margin)
{
    float a = cam_rough_at(p, npix, step);
    if (a <= 0.0f) {
        return -1.0f;
    }
    return a * margin - cam_rough_at(p + 1, npix, step);
}

/* Сколько строк уверенно читаются со сдвигом. Это и есть мера порчи кадра. */
static int cam_shift_votes(const camera_fb_t *fb)
{
    const int w = fb->width, h = fb->height;
    int votes = 0;

    for (int y = 0; y < h; y += CAM_REPAIR_ROW) {
        size_t off = (size_t)y * w * 2;
        if (off + (size_t)w * 2 + 2 > fb->len) {
            break;
        }
        if (cam_shift_gain(fb->buf + off, w - 2, CAM_REPAIR_PIX,
                           CAM_REPAIR_MARGIN) > 0.0f) {
            votes++;
        }
    }
    return votes;
}

/* Первая строка, с которой начинается съезд; -1 — таких нет. */
static int cam_transition_row(const camera_fb_t *fb)
{
    const int w = fb->width, h = fb->height;

    for (int y = 0; y < h; y += CAM_REPAIR_ROW) {
        size_t off = (size_t)y * w * 2;
        if (off + (size_t)w * 2 + 2 > fb->len) {
            break;
        }
        if (cam_shift_gain(fb->buf + off, w - 2, CAM_REPAIR_PIX,
                           CAM_REPAIR_MARGIN) <= 0.0f) {
            continue;
        }
        /* Подтверждаем следующей строкой: одиночный выброс не в счёт. */
        int ny = y + CAM_REPAIR_ROW;
        if (ny < h) {
            size_t noff = (size_t)ny * w * 2;
            if (noff + (size_t)w * 2 + 2 <= fb->len &&
                cam_shift_gain(fb->buf + noff, w - 2, CAM_REPAIR_PIX,
                               CAM_REPAIR_MARGIN) <= 0.0f) {
                continue;
            }
        }
        return y;
    }
    return -1;
}

/*
 * Точное смещение потерянного байта: наименьшее НЕЧЁТНОЕ p, с которого
 * сдвинутое чтение начинает выигрывать. Предикат монотонен — до места потери
 * сдвинутое чтение портит участок [p, k) и проигрывает, после k выигрывает,
 * — поэтому годится деление пополам.
 *
 * Широкое окно устойчиво, но у самой границы размывается, и дальше идёт
 * короткий добор мелким окном: промах на сотню байт оставит в кадре полоску
 * неверных пикселей, которая никуда не денется и раздует JPEG. У границы
 * важна точность, а не уверенность, поэтому запас здесь 1.0.
 */
static long cam_find_k(const camera_fb_t *fb, long lo, long hi)
{
    const int w = fb->width;
    const uint8_t *buf = fb->buf;
    long guard = (long)fb->len - (long)w * 2 - 4;

    if (guard < 2) {
        return -1;
    }
    lo |= 1;
    hi |= 1;
    if (hi > guard) {
        hi = guard | 1;
    }
    if (hi <= lo) {
        return -1;
    }
    if (cam_shift_gain(buf + hi, w, 1, 1.0f) >= 0.0f) {
        return -1;                       /* выше по кадру чище не становится */
    }

    long a = lo, b = hi;
    while (a + 2 < b) {
        long m = ((a + b) / 2) | 1;
        if (m <= a) {
            break;
        }
        if (cam_shift_gain(buf + m, w, 1, 1.0f) < 0.0f) {
            b = m;
        } else {
            a = m + 2;
        }
    }

    long start = b - (long)CAM_REPAIR_FINE * 8;
    if (start < lo) {
        start = lo;
    }
    start |= 1;
    for (long q = start; q <= b; q += 2) {
        if (cam_shift_gain(buf + q, CAM_REPAIR_FINE, 1, 1.0f) < 0.0f) {
            return q;
        }
    }
    return b;
}

/*
 * Чинит кадр на месте. Возвращает шершавость после правки.
 *
 * Критерий приёмки структурный: считается не «сколько шершавости», а «сколько
 * строк лежит не на своей сетке». Такая мера не зависит ни от сюжета, ни от
 * освещения — именно поэтому здесь нет ни одного абсолютного порога.
 */
static float cam_repair_slip(camera_fb_t *fb, float before)
{
    if (!fb || fb->format != PIXFORMAT_RGB565 || fb->width < 8 || !fb->buf) {
        return before;
    }
    const int w = fb->width;
    uint8_t *buf = fb->buf;

    int votes = cam_shift_votes(fb);
    if (votes == 0) {
        return before;                   /* кадр цел, не трогаем вовсе */
    }
    cam_fix_try++;
    cam_votes_sum += (uint32_t)votes;
    uint32_t t_fix0 = micros();

    for (int pass = 0; pass < CAM_REPAIR_MAX; pass++) {
        int r = cam_transition_row(fb);
        if (r < 0) {
            break;
        }
        long lo = (long)(r - 2) * w * 2;
        if (lo < 0) {
            lo = 0;
        }
        long k = cam_find_k(fb, lo, (long)(r + 3) * w * 2);
        if (k < 0 || (size_t)k + 1 >= fb->len) {
            break;
        }

        float rough_before = cam_roughness(fb);
        uint8_t lost   = buf[fb->len - 1];
        uint8_t filler = buf[k];
        memmove(buf + k + 1, buf + k, fb->len - (size_t)k - 1);
        buf[k] = filler;

        int   nv          = cam_shift_votes(fb);
        float rough_after = cam_roughness(fb);

        /* Оба условия относительные: съехавших строк стало меньше И кадр не
         * стал грубее. Второе страхует от «починки», которая переставляет
         * порчу с места на место. */
        if (nv >= votes || rough_after > rough_before * 1.1f + 0.5f) {
            memmove(buf + k, buf + k + 1, fb->len - (size_t)k - 1);
            buf[fb->len - 1] = lost;     /* откат точный, байт в байт */
            break;
        }
        votes = nv;
        if (votes == 0) {
            break;
        }
    }

    /* Считаем по тому же, чем чинили: ноль съехавших строк — кадр вылечен.
     * Никаких «стало меньше»: именно такой счётчик врал в версии 1, показывая
     * «408 удачных из 590» на кадрах, которые она портила. */
    if (votes == 0) {
        cam_fix_ok++;
    } else {
        cam_fix_left++;
    }
    cam_fix_us += micros() - t_fix0;
    return cam_roughness(fb);
}

/*
 * ДИАГНОСТИКА «ШТОРКА» (26.09). КОГДА РОЖДАЕТСЯ СЛИП?
 *
 * Известно: слип зависит от мощности передатчика. На 1 дБм 0 поражённых из
 * 720 кадров, на 20 дБм 44% — при прочих равных. Значит это наводка от
 * собственного радио на шлейф камеры. Железо не трогаем, лечить только кодом.
 *
 * Неизвестно: КОГДА она бьёт. Если во время считывания кадра с сенсора — то
 * кадр достаточно снимать, пока модуль молчит, и разнос захвата и передачи
 * во времени решит задачу. Если наводка портит сенсор как-то иначе (скажем,
 * его настройки по SCCB), тишина в эфире не поможет, и строить разнос незачем.
 *
 * Опыт: передача и тишина чередуются. В тишине кадры снимаются и сжимаются как
 * обычно — путь захвата тот же, — но в модуль не уходят. Слип считается по
 * съехавшим строкам ДО правки, раздельно по фазам. Начало каждой фазы не
 * считается: после остановки модуль ещё дошлёт кольцо и повторы, а драйвер
 * камеры держит в буферах кадры, снятые раньше.
 *
 * Связь в тишине не падает: RESTREAM_ON_HELLO_LOSS 0, а приёмник шлёт отчёт по
 * таймеру раз в секунду. Наш модуль на них отвечает только короткими ACK.
 *
 *   в тишине чисто, при передаче слип  -> строим разнос во времени;
 *   слип и в тишине                    -> механизм другой, разнос не поможет.
 */
#define SHUTTER_TEST      0   /* 28.09: ответ получен, см. журнал; шаг 1 — замер задержки */
#define SHUTTER_ON_MS     5000   /* фаза передачи целиком */
#define SHUTTER_OFF_MS    5000   /* фаза тишины целиком */
#define SHUTTER_SETTLE_MS 700    /* начало фазы не считается */

#if SHUTTER_TEST
enum { SH_ON_SETTLE = 0, SH_ON, SH_OFF_SETTLE, SH_OFF };
static volatile uint8_t  sh_state = SH_ON_SETTLE;
static uint32_t          sh_t0 = 0;
static bool              sh_started = false;
/* [0] — передача, [1] — тишина */
static volatile uint32_t sh_n[2]     = { 0, 0 };  /* кадров измерено */
static volatile uint32_t sh_bad[2]   = { 0, 0 };  /* из них со сдвигом */
static volatile uint32_t sh_votes[2] = { 0, 0 };  /* сумма съехавших строк */
static uint32_t          sh_cycles   = 0;
/* Гистограмма по времени внутри фазы: [фаза][интервал по SH_HIST_MS]. Фаза
 * отсчитывается от начала переходного участка, последний интервал копит всё
 * позже (фаза длится 5 с, запас на задержки опроса). */
#define SH_HIST_MS   500
#define SH_HIST_BINS 12
static volatile uint32_t sh_hn[2][SH_HIST_BINS];
static volatile uint32_t sh_hb[2][SH_HIST_BINS];
static uint32_t          sh_hist_print = 0;

static void shutter_tick(void)
{
    uint32_t now = millis();
    if (!sh_started) {
        sh_started = true;
        sh_t0 = now;
        sh_state = SH_ON_SETTLE;
        return;
    }
    uint32_t dt = now - sh_t0;
    switch (sh_state) {
        case SH_ON_SETTLE:
            if (dt >= SHUTTER_SETTLE_MS) sh_state = SH_ON;
            break;
        case SH_ON:
            if (dt >= SHUTTER_ON_MS) { sh_state = SH_OFF_SETTLE; sh_t0 = now; }
            break;
        case SH_OFF_SETTLE:
            if (dt >= SHUTTER_SETTLE_MS) sh_state = SH_OFF;
            break;
        default:
            if (dt >= SHUTTER_OFF_MS) { sh_state = SH_ON_SETTLE; sh_t0 = now; sh_cycles++; }
            break;
    }
}

/* Зовётся из захвата: кадр только что отдан драйвером, правка ещё не трогала. */
static void shutter_account(const camera_fb_t *fb)
{
    uint8_t st = sh_state;
    int v  = cam_shift_votes(fb);

    /* Гистограмма по времени от начала фазы, переходный участок включён.
     * Прогон 28.09 дал в тишине 30 % кадров со сдвигом при 84 % в передаче:
     * если сдвиг в тишине затухает к концу фазы — это хвост передачи, и разнос
     * во времени сработает при паузе длиннее хвоста; если ровный — источник
     * другой. */
    int hph = (st >= SH_OFF_SETTLE) ? 1 : 0;
    uint32_t bin = (millis() - sh_t0) / SH_HIST_MS;
    if (bin >= SH_HIST_BINS) bin = SH_HIST_BINS - 1;
    sh_hn[hph][bin]++;
    if (v > 0) sh_hb[hph][bin]++;

    if (st != SH_ON && st != SH_OFF) {
        return;                              /* переходный участок — не в счёт */
    }
    int ph = (st == SH_OFF) ? 1 : 0;
    sh_n[ph]++;
    sh_votes[ph] += (uint32_t)v;
    if (v > 0) {
        sh_bad[ph]++;
    }
}
#endif

/*
 * 25.09. САМОПРОВЕРКА ПРИ СТАРТЕ ВРЁТ — она мерит первые кадры сразу после
 * инициализации, а слип к этому моменту ещё держится и уходит позже. Живой
 * замер через tools/frame_check.py дал медиану 1.98 и 1.3% поражённых там, где
 * стартовая проверка кричала 17.04 и «ЗАХВАТ ИСПОРЧЕН». Из-за этого мы полночи
 * считали прогоны негодными, а они были хороши.
 *
 * Поэтому меряем ЕЩЁ И ПО ХОДУ, на тех самых кадрах, что уходят в эфир: каждый
 * CAM_LIVE_EVERY-й кадр считаем шершавость и копим долю поражённых. Числа идут
 * в строку статистики, то есть попадают в лог каждого прогона.
 */
#define CAM_LIVE_EVERY 8        /* считать каждый N-й кадр: замер дешёвый, но не даровой */

static uint32_t cam_live_n = 0, cam_live_bad = 0;
static float    cam_live_sum = 0.0f, cam_live_last = 0.0f;

/* Вердикт последней самопроверки — чтобы его было видно и снаружи. */
static float   cam_check_value = 0.0f;
static bool    cam_check_clean = true;
static uint8_t cam_check_tries = 0;

static bool camera_init(void)
{
    camera_config_t config;

    /*
     * Затыкаем лог драйвера камеры В РАНТАЙМЕ, а не флагом сборки.
     *
     * 14.08: CORE_DEBUG_LEVEL=0 на cam_hal не действует — он приходит готовой
     * скомпилированной библиотекой в составе фреймворка, и уровень в ней уже
     * зашит. А печатает он из cam_task, у которой маленький стек: первое же
     * сообщение EV-VSYNC-OVF валит плату по Stack canary watchpoint. То есть
     * не переполнение захвата само по себе роняет плату, а попытка о нём
     * сообщить. Гасим — и переполнение становится тем, чем должно быть:
     * потерянным кадром, а не перезагрузкой.
     */
    esp_log_level_set("cam_hal", ESP_LOG_NONE);
    esp_log_level_set("s3 ll_cam", ESP_LOG_NONE);

    memset(&config, 0, sizeof(config));
    config.ledc_channel = LEDC_CHANNEL_0;
    config.ledc_timer = LEDC_TIMER_0;
    config.pin_d0 = CAMERA_PIN_Y2;
    config.pin_d1 = CAMERA_PIN_Y3;
    config.pin_d2 = CAMERA_PIN_Y4;
    config.pin_d3 = CAMERA_PIN_Y5;
    config.pin_d4 = CAMERA_PIN_Y6;
    config.pin_d5 = CAMERA_PIN_Y7;
    config.pin_d6 = CAMERA_PIN_Y8;
    config.pin_d7 = CAMERA_PIN_Y9;
    config.pin_xclk = CAMERA_PIN_XCLK;
    config.pin_pclk = CAMERA_PIN_PCLK;
    config.pin_vsync = CAMERA_PIN_VSYNC;
    config.pin_href = CAMERA_PIN_HREF;
    config.pin_sccb_sda = CAMERA_PIN_SIOD;
    config.pin_sccb_scl = CAMERA_PIN_SIOC;
    config.pin_pwdn = CAMERA_PIN_PWDN;
    config.pin_reset = CAMERA_PIN_RESET;
    config.xclk_freq_hz = CAM_XCLK_HZ;
    config.pixel_format = PIXFORMAT_RGB565;
    config.frame_size = FRAME_SIZE;

    SerialMon.printf("PSRAM: %s\n", psramFound() ? "есть" : "нет");
    if (psramFound()) {
        // ТРИ буфера, а не два. Причина (13.08): при fb_count=2 и GRAB_LATEST,
        // пока мы держим один буфер на время frame2jpg, драйверу остаётся
        // ровно один — и он может отдать кадр, в который прямо сейчас пишет
        // DMA. На картинке это выглядит как полосы цветного мусора поперёк
        // кадра при полностью целом транспорте (crc_err=0, потери 0.5%).
        // Третий буфер даёт сенсору куда писать, пока два других заняты.
        // HQVGA RGB565 = 84 КБ на буфер, в PSRAM это ничто.
        /*
         * Три буфера.
         *
         * 26.08 поднимал до пяти, подозревая, что драйвер отдаёт кадр, в который
         * DMA ещё дописывает строки. Проверка сырых кадров эту версию закрыла:
         * выгрузили кадры по USB (DUMP_RAW) и разобрали на ПК — строки целы,
         * разрывов нет, CRC сырого кадра сходится, JPEG с платы совпадает с
         * картинкой, собранной на ПК из тех же байт. РВАНИ НЕТ ВООБЩЕ.
         *
         * То, что мы называли радугой, оказалось искажением ЦВЕТА, а не потерей
         * строк, и к буферам захвата отношения не имеет. Возвращаю три.
         */
        /*
         * 15.09: всё, что написано выше про три буфера, — про PSRAM, где
         * 84 КБ ничего не стоят. При CAM_FB_IN_DRAM буфер живёт во внутренней
         * памяти, каждый стоит дорого, и берём мы два: пока мы 36 мс сжимаем
         * кадр из одного, сенсор пишет следующий во второй.
         */
#if CAM_FB_IN_DRAM
        config.fb_count = 2;
        config.fb_location = CAMERA_FB_IN_DRAM;
#else
        /* 29.09: при двух кодировщиках четыре — два держат они, см. ENC_WORKERS. */
        config.fb_count = (ENC_WORKERS > 1) ? 4 : 3;
        config.fb_location = CAMERA_FB_IN_PSRAM;
#endif
        // GRAB_WHEN_EMPTY, а не GRAB_LATEST. 13.08: на LATEST картинка шла с
        // радужным мусором ниже некоторой строки при полностью целом
        // транспорте (crc_err=0). Радужный шум — это не искажение картинки, а
        // сырой мусор вместо пикселей: JPEG честно кодирует буфер, в который
        // DMA ещё не дописал кадр. LATEST отдаёт самый свежий буфер, не
        // дожидаясь конца записи; WHEN_EMPTY отдаёт только дописанные.
        // Плата за это — задержка: кадр будет чуть старее.
        config.grab_mode = CAMERA_GRAB_WHEN_EMPTY;
    } else {
        config.fb_count = 1;
        config.grab_mode = CAMERA_GRAB_WHEN_EMPTY;
        config.fb_location = CAMERA_FB_IN_DRAM;
        config.frame_size = FRAMESIZE_QQVGA;
    }

    esp_err_t err = esp_camera_init(&config);
#if CAM_FB_IN_DRAM
    /*
     * Два буфера по 84 КБ во внутренней памяти — это впритык, и сколько её
     * останется, зависит от того, что успел занять фреймворк. Не хватило —
     * переспрашиваем один, вместо того чтобы оставлять плату без камеры.
     * С одним буфером сенсору придётся ждать, пока мы отпустим кадр: кадров
     * станет меньше, но рвани не будет, потому что WHEN_EMPTY отдаёт только
     * дописанные кадры.
     */
    if (err == ESP_ERR_NO_MEM && config.fb_count > 1) {
        SerialMon.printf("Камера: на %d буфера во внутренней памяти не хватило, "
                         "беру один\n", config.fb_count);
        config.fb_count = 1;
        err = esp_camera_init(&config);
    }
#endif
    if (err != ESP_OK) {
        SerialMon.printf("Камера не поднялась, ошибка 0x%x\n", err);
        snprintf(cam_info, sizeof(cam_info), "НЕ НАЙДЕНА (0x%x)", err);
        return false;
    }

    sensor_t *s = esp_camera_sensor_get();
    camera_sensor_info_t *info = s ? esp_camera_sensor_get_info(&(s->id)) : NULL;
    const char *name = info ? info->name : "?";
    SerialMon.printf("Сенсор: %s (PID 0x%x)\n", name, s ? s->id.PID : 0);
    if (s && s->id.PID == OV5640_PID) {
        s->set_vflip(s, 1);
#if CAM_PCLK_DIV > 1
        /*
         * Системный делитель сенсора — см. CAM_PCLK_DIV. Поле четыре бита,
         * ноль в нём означает 16, поэтому разбираем его руками.
         *
         * 15.09, ценой одного цикла заливки. Указатели проверяем ЯВНО:
         * sensor_t — таблица функций, и у части драйверов часть ячеек пустая.
         * Вызов по нулю здесь стоил МОЛЧАЛИВОЙ платы, а не падения с трассой:
         * Serial это USB-Serial/JTAG, напечатанное лежит в кольце и
         * выгребается прерыванием, при панике кольцо не выгребается — весь лог
         * загрузки исчезает (то же, из-за чего ниже стоит halow_mon_settle).
         * Порт при этом остаётся в системе, потому что USB-Serial/JTAG живёт
         * в железе и программный сброс его не роняет. Снаружи это выглядит
         * как «плата залита, но молчит», и отличить от севшего питания нельзя.
         *
         * Поэтому кольцо выталкиваем ДО того, как трогать сенсор: если
         * следующая строка всё же уронит плату, всё предыдущее уже на экране.
         */
        halow_mon_settle();
        if (!s->get_reg || !s->set_reg) {
            SerialMon.printf("PCLK: драйвер сенсора не даёт доступа к регистрам, "
                             "делитель не тронут\n");
        } else {
            int reg_was = s->get_reg(s, 0x3035, 0xFF);
            if (reg_was < 0) {
                SerialMon.printf("PCLK: регистр 0x3035 не читается (%d), делитель не тронут\n",
                                 reg_was);
            } else {
                int div_was = (reg_was >> 4) & 0x0F;
                if (div_was == 0) {
                    div_was = 16;
                }
                int div_want = div_was * CAM_PCLK_DIV;
                if (div_want > 15) {
                    SerialMon.printf("PCLK: делитель уже %d, умножать на %d некуда (поле 4 бита)\n",
                                     div_was, CAM_PCLK_DIV);
                } else {
                    s->set_reg(s, 0x3035, 0xF0, (div_want & 0x0F) << 4);
                    int reg_now = s->get_reg(s, 0x3035, 0xFF);
                    SerialMon.printf("PCLK: 0x3035 было 0x%02x, стало 0x%02x, делитель %d -> %d\n",
                                     reg_was, reg_now, div_was, div_want);
                }
            }
        }
        halow_mon_settle();
#endif
#if CAM_PLL_MUL > 0
        /* Такт сенсора — см. CAM_PLL_MUL. Указатели проверяем явно, как выше. */
        halow_mon_settle();
        if (!s->set_pll || !s->get_reg) {
            SerialMon.println("PLL: драйвер сенсора не даёт set_pll/get_reg — такт не тронут");
        } else if (!cam_pll_fast) {
            SerialMon.println("PLL: опыт держит такт драйвера — не трогаю");
        } else {
            static const int pll_regs[] = { 0x3034, 0x3035, 0x3036, 0x3037, 0x3108, 0x3824, 0x460C };
            char was[48], now[48];
            int nw = 0, nn = 0;
            for (unsigned i = 0; i < sizeof(pll_regs) / sizeof(pll_regs[0]); i++) {
                nw += snprintf(was + nw, sizeof(was) - nw, " %02x", s->get_reg(s, pll_regs[i], 0xFF) & 0xFF);
            }
            /* bypass 0, множитель, sys_div 1, root_2x 0, pre_div 1, pclk_root_div 1,
             * ручной PCLK, делитель PCLK — как драйвер для кадров меньше QVGA. */
            int rc = s->set_pll(s, 0, CAM_PLL_MUL, 1, 0, 1, 1, 1, CAM_PLL_PCLK_DIV);
            for (unsigned i = 0; i < sizeof(pll_regs) / sizeof(pll_regs[0]); i++) {
                nn += snprintf(now + nn, sizeof(now) - nn, " %02x", s->get_reg(s, pll_regs[i], 0xFF) & 0xFF);
            }
            SerialMon.printf("PLL: 3034 3035 3036 3037 3108 3824 460C было%s, стало%s "
                             "(set_pll=%d, множитель %d, делитель PCLK %d)\n",
                             was, now, rc, (int)CAM_PLL_MUL, (int)CAM_PLL_PCLK_DIV);
        }
        halow_mon_settle();
#endif
    }

#if VSYNC_PROBE
    vs_probe_attach();
#endif
#if CAM_VSYNC_FILTER
    {
        unsigned thr0 = LCD_CAM.cam_ctrl.cam_vsync_filter_thres;
        unsigned en0 = LCD_CAM.cam_ctrl1.cam_vsync_filter_en;
        LCD_CAM.cam_ctrl.cam_vsync_filter_thres = CAM_VSYNC_FILTER;
        LCD_CAM.cam_ctrl1.cam_vsync_filter_en = 1;
        SerialMon.printf("VSYNC: фильтр LCD_CAM было порог %u вкл %u, стало порог %u вкл %u\n",
                         thr0, en0, (unsigned)LCD_CAM.cam_ctrl.cam_vsync_filter_thres,
                         (unsigned)LCD_CAM.cam_ctrl1.cam_vsync_filter_en);
    }
#endif
    /* Сила выходов — см. CAM_DRIVE. Перезапуск драйвера возвращает ×4, поэтому
     * ставим то, что стояло до него (опыт мог сменить). */
    {
        uint8_t d = cam_drv_now ? cam_drv_now : (uint8_t)CAM_DRIVE;
        if (d) {
            cam_drv_apply(d, true);
        }
    }
#if CAM_SIG_COUNT
    sig_init();
#endif
    SerialMon.printf("Буфер захвата: %s, %d шт\n",
#if CAM_FB_IN_DRAM
                     "внутренняя память",
#else
                     "PSRAM",
#endif
                     config.fb_count);

    snprintf(cam_info, sizeof(cam_info), "%s %s RGB565->JPEG",
             name, fs_name(config.frame_size));
    SerialMon.printf("Режим камеры: %s\n", cam_info);
#if CAM_CHECK_ON
    cam_check_value = cam_sample_roughness();
    cam_check_clean = (cam_check_value <= CAM_CHECK_THRESHOLD);
    SerialMon.printf("Самопроверка захвата: шершавость %.2f (порог %.1f) — %s\n",
                     cam_check_value, (double)CAM_CHECK_THRESHOLD,
                     cam_check_clean ? "ЧИСТО" : "БАЙТОВЫЙ СЛИП");
    if (!cam_check_clean) {
        if (cam_check_tries < CAM_CHECK_TRIES) {
            cam_check_tries++;
            SerialMon.printf("  переинициализация камеры, попытка %u из %u\n",
                             (unsigned)cam_check_tries, (unsigned)CAM_CHECK_TRIES);
            esp_camera_deinit();
            delay(200);
            return camera_init();       /* глубина ограничена cam_check_tries */
        }
        SerialMon.printf("!!!! ЗАХВАТ ИСПОРЧЕН, %u попыток исчерпано !!!!\n"
                         "Кадры раздуты примерно вдвое, картинка в цветных полосах.\n"
                         "ПРОГОН НЕПРИГОДЕН ДЛЯ СРАВНЕНИЯ С ДРУГИМИ.\n",
                         (unsigned)CAM_CHECK_TRIES);
    }
#endif
    return true;
}

//************************************[ ARDUINO ]****************************************

/*
 * СТОРОЖ КАМЕРЫ (30.09): 0 — нет, N — после N пустых esp_camera_fb_get подряд
 * (каждый ждёт кадр 4 с) перезапустить драйвер камеры.
 *
 * Зачем. 30.09 утром (перебор var0930rs) камера после загрузки отдала четыре
 * кадра, снятых ещё в стартовом окне (15–30 с назад), и больше ни одного —
 * все 5 минут опыта впустую, при живой связи и нормальном питании (3,27 В).
 * Похоже на известную беду драйвера на S3 в режиме GRAB_WHEN_EMPTY: пока
 * передача не началась, все буферы полны и захват стоит, а после их возврата
 * иногда так и не возобновляется. Раньше случалось изредка (29.09 14:01 —
 * тоже 0 к/с в первом включении). Для борта это вообще обязательно: камера,
 * молча вставшая в полёте, без сторожа не оживёт до посадки.
 */
#define CAM_WATCHDOG  2
/* 06.10 ночь: столько перезапусков драйвера подряд без единого кадра — и ESP
 * перезагружается целиком. 22:18 три перезапуска подряд не вернули ни кадра (сенсор
 * при каждом сбрасывался по RESET), а снятие питания вернуло. 0 — не перезагружать. */
#define CAM_REBOOT_AFTER 2
#if CAM_WATCHDOG
static uint32_t cam_null_streak = 0;   /* пустых захватов подряд (под cap_mutex) */
static uint32_t cam_reinits = 0;
static uint32_t cam_reinit_streak = 0;   /* перезапусков подряд без единого кадра */
#endif

/*
 * Снять кадр и сжать его. Вынесено из loop() отдельной функцией, потому что
 * при PIPELINE этим занимается своя задача на другом ядре.
 * Возвращает true и указатель на JPEG, который вызывающий обязан освободить.
 */
#if NEW_JPEG
/* Сжатие кадра RGB565 через esp_new_jpeg — см. NEW_JPEG. Результат — в malloc, как у
 * fmt2jpg: освобождает отправитель. Индекс экземпляра — ядро вызывающей задачи. */
#define NJ_OUT_CAP (96 * 1024)
static jpeg_enc_handle_t nj_enc[2] = { NULL, NULL };
static uint8_t  nj_q[2], *nj_out[2] = { NULL, NULL }, *nj_in[2] = { NULL, NULL };
static uint16_t nj_w[2], nj_h[2];
static size_t   nj_in_cap[2];
static uint32_t nj_fail = 0, nj_unaligned = 0;

static bool nj_encode(const uint8_t *src, size_t len, uint16_t w, uint16_t h, uint8_t q,
                      uint8_t **out, size_t *out_len)
{
    const int k = xPortGetCoreID() ? 1 : 0;
    if (nj_enc[k] && (nj_w[k] != w || nj_h[k] != h)) {
        jpeg_enc_close(nj_enc[k]);
        nj_enc[k] = NULL;
    }
    if (!nj_enc[k]) {
        jpeg_enc_config_t cfg = DEFAULT_JPEG_ENC_CONFIG();
        cfg.width = w;
        cfg.height = h;
        cfg.src_type = JPEG_PIXEL_FORMAT_RGB565_BE;
        cfg.subsampling = JPEG_SUBSAMPLE_420;
        cfg.quality = q;
        cfg.rotate = JPEG_ROTATE_0D;
        cfg.task_enable = false;
        jpeg_error_t rc = jpeg_enc_open(&cfg, &nj_enc[k]);
        if (rc != JPEG_ERR_OK || !nj_enc[k]) {
            nj_enc[k] = NULL;
            nj_fail++;
            SerialMon.printf("NEWJPEG: открыть кодировщик не вышло (%d)\n", (int)rc);
            return false;
        }
        nj_w[k] = w;
        nj_h[k] = h;
        nj_q[k] = q;
        SerialMon.printf("NEWJPEG: кодировщик на ядре %d открыт, %ux%u, Q%u, вход %s\n",
                         k, (unsigned)w, (unsigned)h, (unsigned)q,
                         ((uintptr_t)src & 15) ? "НЕ выровнен — копирую" : "выровнен");
    }
    if (nj_q[k] != q) {
        jpeg_enc_set_quality(nj_enc[k], q);
        nj_q[k] = q;
    }
    if ((uintptr_t)src & 15) {
        if (nj_in_cap[k] < len) {
            if (nj_in[k]) {
                jpeg_free_align(nj_in[k]);
            }
            nj_in[k] = (uint8_t *)jpeg_calloc_align(len, 16);
            nj_in_cap[k] = nj_in[k] ? len : 0;
        }
        if (!nj_in[k]) {
            nj_fail++;
            return false;
        }
        memcpy(nj_in[k], src, len);
        src = nj_in[k];
        nj_unaligned++;
    }
    if (!nj_out[k]) {
        nj_out[k] = (uint8_t *)heap_caps_malloc(NJ_OUT_CAP, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
        if (!nj_out[k]) {
            nj_fail++;
            return false;
        }
    }
    int got = 0;
    jpeg_error_t rc = jpeg_enc_process(nj_enc[k], src, (int)len, nj_out[k], NJ_OUT_CAP, &got);
    if (rc != JPEG_ERR_OK || got <= 0) {
        nj_fail++;
        return false;
    }
    uint8_t *j = (uint8_t *)malloc((size_t)got);
    if (!j) {
        nj_fail++;
        return false;
    }
    memcpy(j, nj_out[k], (size_t)got);
    *out = j;
    *out_len = (size_t)got;
    return true;
}
#endif

static bool captureFrame(uint8_t **out_jpg, size_t *out_len, uint32_t *out_cap_ms,
                         uint32_t *out_seq = NULL)
{
    /*
     * 27.08: «курицы с яйцом» здесь нет, и прежний вывод отменён.
     *
     * Было: шлём независимо от link_up, потому что приёмнику якобы не о чем
     * отчитываться, пока поток не пошёл. Это неверно — приёмник шлёт свой 'S'
     * раз в секунду безусловно (HalowVideoP2P_AP, sendStat в loop), ему наш
     * поток для этого не нужен. Значит первый 'S' можно дождаться, ничего не
     * передавая, и он же будет доказательством ассоциации.
     *
     * Гейт стоит выше по течению: сюда управление не доходит, пока tx_enabled
     * ложно (WAIT_FOR_HELLO). Здесь остаётся только съёмка.
     */
#if ENC_WORKERS > 1
    if (cap_mutex) {
        xSemaphoreTake(cap_mutex, portMAX_DELAY);   /* захват по одному */
    }
#endif
    uint32_t t_cam0 = millis();
    camera_fb_t *fb = esp_camera_fb_get();
    uint32_t t_cam1 = millis();
    uint32_t t_copy1 = t_cam1;
#if CAM_WATCHDOG
    if (fb) {
        cam_null_streak = 0;
        cam_reinit_streak = 0;
    } else if (++cam_null_streak >= CAM_WATCHDOG) {
        /* Сенсор встал, см. CAM_WATCHDOG. Замок захвата у нас — второй
         * кодировщик ждёт его и камеру не тронет; буферов на руках нет:
         * кадров не было уже несколько секунд. */
        cam_null_streak = 0;
        cam_reinits++;
#if CAM_SIG_COUNT
        SerialMon.printf("КАМЕРА: сигналы сенсора за прошлый период — VSYNC %d, HREF %d\n",
                         (int)sig_vs_last, (int)sig_hr_last);
#endif
#if CAM_REBOOT_AFTER
        if (++cam_reinit_streak > CAM_REBOOT_AFTER) {
            SerialMon.printf("КАМЕРА: %u перезапуска драйвера подряд не вернули кадр — "
                             "ПЕРЕЗАГРУЗКА ESP\n", (unsigned)CAM_REBOOT_AFTER);
            delay(1500);               /* дать логу уйти по воздуху */
            esp_restart();
        }
#endif
        SerialMon.printf("КАМЕРА: %u раз подряд нет кадра (по 4 с) — перезапуск драйвера\n",
                         (unsigned)CAM_WATCHDOG);
        esp_camera_deinit();
        delay(200);
        camera_ok = camera_init();
        SerialMon.printf("КАМЕРА: перезапуск %s, всего %lu\n",
                         camera_ok ? "удался" : "НЕ УДАЛСЯ", (unsigned long)cam_reinits);
    }
#endif
    if (!fb) {
#if ENC_WORKERS > 1
        if (cap_mutex) {
            xSemaphoreGive(cap_mutex);
        }
#endif
        return false;
    }
    cam_cache_fresh(fb);               /* см. «КЭШ И КАДР» */
    *out_cap_ms = fb_start_ms(fb);     /* для замера задержки, см. lat_on_ack */
#if GATED_CAPTURE
    if (!gate_frame_clean(*out_cap_ms)) {
        /* Снят, пока модуль передавал, — назад драйверу, не сжимая. */
        cam_fb_give(fb);
#if ENC_WORKERS > 1
        if (cap_mutex) {
            xSemaphoreGive(cap_mutex);
        }
#endif
        return false;
    }
#endif
    {
        uint32_t seq = ++cap_seq;
        if (out_seq) {
            *out_seq = seq;
        }
    }

#if CAM_CHECK_ON
    /* Живой контроль захвата — на кадре, который сейчас уйдёт в эфир. */
    /* 25.09: проверяем и правим КАЖДЫЙ кадр, а не каждый CAM_LIVE_EVERY-й.
     * Иначе семь кадров из восьми уходили бы в эфир испорченными — для
     * статистики хватило бы выборки, а для картинки нет. Сам замер дёшев:
     * cam_roughness берёт каждую восьмую строку, это ~5 тыс. операций.
     * Дорогая часть — поиск и сдвиг — включается только на поражённых. */
    {
#if SHUTTER_TEST
        shutter_account(fb);
#endif
        cam_live_last = cam_roughness(fb);
#if CAM_REPAIR
        /* Снимаем слип ДО сжатия, чтобы в эфир ушла исправленная картинка, а
         * не исправленная копия. Решает сама правка: целый кадр она узнаёт по
         * нулю съехавших строк и не трогает. Порог здесь больше ни при чём —
         * на нём погорели версии 1 и 2. */
        cam_live_last = cam_repair_slip(fb, cam_live_last);
#endif
        cam_live_sum += cam_live_last;
        cam_live_n++;
        if (cam_live_last > CAM_CHECK_THRESHOLD) {
            cam_live_bad++;
        }
    }
#endif

    /* Всё, что понадобится кодировщику, снимаем с fb сразу: при работе из SRAM
     * буфер камеры возвращается ещё ДО сжатия. */
    const uint8_t *src     = fb->buf;
    size_t         src_len = fb->len;
    uint16_t       src_w   = (uint16_t)fb->width;
    uint16_t       src_h   = (uint16_t)fb->height;
#if ENC_WORKERS > 1
    /* Захват и правка слипа позади — сжимать можно параллельно. */
    if (cap_mutex) {
        xSemaphoreGive(cap_mutex);
    }
#endif

#if ENCODE_FROM_SRAM
    if (sram_frame && src_len <= sram_frame_cap) {
        // Одно чтение 84 КБ подряд вместо шестидесяти миллисекунд доступа
        // вразнобой — ровно ради этого всё и затевалось.
        memcpy(sram_frame, fb->buf, src_len);
        src = sram_frame;
        t_copy1 = millis();
#if CHECK_COPY
        if (big_crc(fb->buf, src_len) != big_crc(sram_frame, src_len)) {
            copy_torn++;        // в буфер писали, пока мы его читали
        }
        copy_checked++;
#endif
    } else {
        enc_from_psram++;       // буфера нет — сжимаем из PSRAM, как раньше
    }
#endif

#if CHECK_FB
    uint16_t crc_before = big_crc(fb->buf, fb->len);
#endif
#if DUMP_RAW
    bool dump_now = (++dump_counter % DUMP_EVERY == 0);
#endif

    /* Кадр камере больше не нужен — кодировщик работает с копией. Отдаём сразу,
     * чтобы у драйвера всегда был свободный буфер под следующий кадр.
     * Диагностикам ниже нужен исходный буфер, поэтому при них держим до конца,
     * как раньше. */
#if ENCODE_FROM_SRAM && !CHECK_FB && !CHECK_ENCODER && !DUMP_RAW
    if (src == sram_frame) {
        cam_fb_give(fb);
        fb = NULL;
    }
#endif

    uint8_t *jpg = NULL;
    size_t jpg_len = 0;
#if NEW_JPEG
    bool ok = nj_encode(src, src_len, src_w, src_h, jpeg_q_rt, &jpg, &jpg_len);
#else
    bool ok = fmt2jpg((uint8_t *)src, src_len, src_w, src_h, PIXFORMAT_RGB565,
                      jpeg_q_rt, &jpg, &jpg_len);
#endif
    uint32_t t_jpeg1 = millis();

#if DUMP_RAW
    /*
     * Выгружаем ПАРУ: сырой кадр и сделанный из него JPEG, подряд и до
     * возврата буфера камере. Раз это один и тот же кадр, сравнение картинок
     * на ПК даёт прямой ответ, портит ли кодировщик: BMP чистый при рваном
     * JPEG означает, что виноват frame2jpg, и больше некому.
     */
    if (dump_now) {
        dumpRawFrame(fb);
#if DUMP_JPEG
        if (ok) {
            dumpJpegFrame(jpg, jpg_len);
        }
#endif
    }
#endif
#if CHECK_FB
    uint16_t crc_after = big_crc(fb->buf, fb->len);
    if (crc_before != crc_after) {
        fb_torn++;
    }
    fb_checked++;
#endif
#if CHECK_ENCODER
    if (ok) {
        uint8_t *jpg2 = NULL;
        size_t jpg2_len = 0;
        if (fmt2jpg((uint8_t *)src, src_len, src_w, src_h, PIXFORMAT_RGB565,
                    jpeg_q_rt, &jpg2, &jpg2_len)) {
            bool same = (jpg2_len == jpg_len) &&
                        (halow_crc16(jpg, (uint16_t)min((size_t)60000, jpg_len)) ==
                         halow_crc16(jpg2, (uint16_t)min((size_t)60000, jpg2_len)));
            if (!same) {
                enc_diff++;
            }
            free(jpg2);
        }
        enc_checked++;
    }
#endif
    if (fb) {
        cam_fb_give(fb);
    }

    if (!ok) {
        return false;
    }

    *out_jpg = jpg;
    *out_len = jpg_len;
#if ENC_WORKERS > 1
    portENTER_CRITICAL(&enc_stat_mux);
#endif
    cam_ms_acc  += (t_cam1 - t_cam0);
    copy_ms_acc += (t_copy1 - t_cam1);
    jpeg_ms_acc += (t_jpeg1 - t_copy1);
    cap_frames++;
    cap_all++;
    cam_ms_all += (t_cam1 - t_cam0);
#if ENC_WORKERS > 1
    portEXIT_CRITICAL(&enc_stat_mux);
#endif
    return true;
}

#if PIPELINE
/*
 * КОНВЕЙЕР НА ДВУХ ЯДРАХ.
 *
 * Раньше всё шло по очереди в одном цикле: снять, сжать, передать, снова
 * снять. Пока идёт сжатие, UART простаивает; пока идёт передача, простаивает
 * процессор — он просто ждёт, когда провод пропустит байты. Половина времени
 * каждый узел бездельничал.
 *
 * Теперь захват со сжатием живут отдельной задачей на ядре 0, а передача
 * осталась в loop() на ядре 1. Между ними очередь на пару кадров. Цикл
 * становится не суммой времён, а максимумом из них.
 *
 * Очередь короткая нарочно. Длинная копила бы кадры и растила задержку — для
 * видео это хуже, чем выбросить лишнее. Если передача не успевает, свежий
 * кадр отбрасывается сразу (счётчик pipe_dropped), и на приёмник идёт то, что
 * снято только что, а не десять секунд назад.
 */
typedef struct {
    uint8_t *buf;
    size_t   len;
    uint32_t cap_ms;    /* начало съёмки, для замера задержки */
    uint32_t seq;       /* номер захвата, см. ENC_WORKERS */
} jpg_item_t;

static QueueHandle_t jpg_q = NULL;
static uint32_t pipe_dropped = 0;

static void camera_task(void *arg)
{
    for (;;) {
        /* tx_enabled, а не streaming: пока приёмник не отозвался, снимать и
         * сжимать не для кого. Камера и кодировщик простаивают вместе с
         * передатчиком, и модуль получает тихий UART на всё время ассоциации. */
        if (!camera_ok || !tx_enabled) {
            vTaskDelay(pdMS_TO_TICKS(20));
            continue;
        }
        /*
         * Снимаем ТОЛЬКО когда в очереди есть место. Раньше здесь был цикл без
         * пауз: снял, очередь полна, выбросил, тут же снимаешь следующий. Ядро
         * было занято на сто процентов впустую — кадры выбрасывались сотнями,
         * PSRAM молотила зря, а USB не получал времени даже на то, чтобы
         * принять команду сброса от загрузчика (плата переставала прошиваться).
         *
         * Ждём места, а не выбрасываем. Задержка от этого не растёт: очередь
         * всего на два кадра, значит снятое уедет в ближайшие сотни миллисекунд.
         */
        if (uxQueueSpacesAvailable(jpg_q) == 0) {
            vTaskDelay(pdMS_TO_TICKS(5));
            continue;
        }

#if SYNTH_SOURCE || EXP_PROGRAM
        if (SYNTH_SOURCE || synth_on) {
        if (arg) {
            vTaskDelay(pdMS_TO_TICKS(20));   /* второй кодировщик в синтетике молчит */
            continue;
        }
        /* Синтетический источник, см. SYNTH_SOURCE. Кадр в очереди держим
         * ровно один: канал выбирает его сразу, как только окно откроется, а
         * выбрасывать устаревшие здесь незачем — все кадры одинаковые. */
        {
            static uint8_t *synth_jpg = NULL;
            static size_t   synth_len = 0;
            if (!synth_jpg) {
#if SYNTH_NOCAM
                synth_len = SYNTH_NOCAM_LEN;
                synth_jpg = (uint8_t *)malloc(synth_len);
                if (!synth_jpg) {
                    vTaskDelay(pdMS_TO_TICKS(10));
                    continue;
                }
                uint32_t x = 0x12345678u;
                for (size_t k = 0; k < synth_len; k++) {
                    x = x * 1664525u + 1013904223u;
                    synth_jpg[k] = (uint8_t)(x >> 24);
                }
                synth_jpg[0] = 0xFF;
                synth_jpg[1] = 0xD8;
                synth_jpg[synth_len - 2] = 0xFF;
                synth_jpg[synth_len - 1] = 0xD9;
#else
                uint32_t cap0 = 0;
                if (!captureFrame(&synth_jpg, &synth_len, &cap0)) {
                    vTaskDelay(pdMS_TO_TICKS(10));
                    continue;
                }
#endif
                SerialMon.printf("СИНТЕТИКА: кадр %u Б гоняется по кругу, камера и кодер отключены\n",
                                 (unsigned)synth_len);
            }
            if (uxQueueMessagesWaiting(jpg_q) > 0) {
                vTaskDelay(1);
                continue;
            }
            uint8_t *copy = (uint8_t *)malloc(synth_len);
            if (!copy) {
                vTaskDelay(pdMS_TO_TICKS(5));
                continue;
            }
            memcpy(copy, synth_jpg, synth_len);
            jpg_item_t sit = { copy, synth_len, millis(), ++cap_seq };
            if (xQueueSend(jpg_q, &sit, 0) != pdTRUE) {
                free(copy);
            }
            cap_frames++;
            vTaskDelay(1);
            continue;
        }
        }
#endif

        uint8_t *jpg = NULL;
        size_t   len = 0;
        uint32_t cap_ms = 0;
        uint32_t seq = 0;
        if (!captureFrame(&jpg, &len, &cap_ms, &seq)) {
            vTaskDelay(pdMS_TO_TICKS(10));
            continue;
        }
        jpg_item_t it = { jpg, len, cap_ms, seq };
        if (xQueueSend(jpg_q, &it, 0) != pdTRUE) {
            free(jpg);          // место кончилось между проверкой и отправкой
            pipe_dropped++;
        }
        vTaskDelay(1);          // обязательная уступка: иначе задача не отдаёт ядро
    }
}
#endif

void setup()
{
    /* Первым делом, до инициализации чего бы то ни было. */
    if (dbg_magic != 0x48414C4FUL) {          /* "HALO" — первый запуск после питания */
        dbg_magic = 0x48414C4FUL;
        dbg_boots = 0;
        dbg_maxstage = 0;
    }
    dbg_boots++;
    dbg_reason = (uint32_t)esp_reset_reason();
    dbg_stage = 1;

#if AIR_LOG
    SerialMon.setTxBufferSize(8192);   /* до begin; с хостом — запас на всплески */
#endif
    SerialMon.begin(115200);
    /* Ограничиваем ожидание при записи в USB: нет читателя — запись
     * отбрасывается, но НЕ блокирует главный цикл. Ждать опустошения (flush)
     * нельзя вовсе, см. halow_mon_settle() в halow_stream.h. При AIR_LOG —
     * ноль: камера может жить вовсе без хоста, см. AIR_LOG. */
    SerialMon.setTxTimeoutMs(AIR_LOG ? 0 : 100);
    dbg_stage = 2;
    delay(2000);
    dbg_stage = 3;

    SerialMon.println();
    SerialMon.println("=== T-Halow: камера (STA), прозрачный режим ===");

    // Приёмный буфер побольше стандартных 256 байт: обратный канал редкий, но
    // модуль в стартовом окне вываливает загрузочный лог, и терять его начало
    // из-за переполнения не хочется.
    SerialAT.setRxBufferSize(2048);
    SerialAT.begin(AT_BAUD, SERIAL_8N1, SERIAL_AT_RXD, SERIAL_AT_TXD);
    SerialMon.printf("UART к модулю: %u бод (окно), %u бод (поток)\n",
                     (unsigned)AT_BAUD, (unsigned)P2P_BAUD);

    pinMode(BOARD_LED, OUTPUT);
    halow_p2p_rx_init(&rx);
    memset(&peer, 0, sizeof(peer));

#if SYNTH_NOCAM
    camera_ok = true;          /* дальше камеру не трогает никто, кроме синтетики */
    SerialMon.println("SYNTH_NOCAM: камера не запускается, кадр синтетики — из памяти");
#else
    camera_ok = camera_init();
#endif
    dbg_stage = 4;
    SerialMon.printf("Камера: %s\n", camera_ok ? "OK" : "ОШИБКА");

#if ENCODE_FROM_SRAM || CAM_FB_IN_DRAM || ENC_BUF_INTERNAL
    /*
     * Развязка по памяти — до первого сжатия.
     *
     * Порог malloc поднимаем, чтобы буферы кодировщика и готовый JPEG легли во
     * внутреннюю память. Размер буфера под копию берём из таблицы разрешений
     * драйвера, а не константой: так он не разойдётся с FRAME_SIZE, если
     * разрешение потом поправят.
     *
     * 15.09: условие расширено. Порог нужен и при CAM_FB_IN_DRAM, где копии в
     * SRAM уже нет. Иначе получилось бы наоборот: кадр мы из PSRAM убрали, а
     * буферы кодировщика (12 КБ) и готовый JPEG (7-9 КБ) туда вернули — и
     * PSRAM осталась бы в тракте, ровно там, откуда её и выгоняем.
     */
    heap_caps_malloc_extmem_enable(INTERNAL_MALLOC_LIMIT);
#if ENCODE_FROM_SRAM
    if (camera_ok) {
        sensor_t *s = esp_camera_sensor_get();
        framesize_t fs = s ? s->status.framesize : FRAME_SIZE;
        sram_frame_cap = (size_t)resolution[fs].width * resolution[fs].height * 2;
        sram_frame = (uint8_t *)heap_caps_malloc(sram_frame_cap,
                                                 MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
        if (!sram_frame) {
            sram_frame_cap = 0;
        }
    }
#endif
    SerialMon.printf("SRAM: свободно %u, наибольший кусок %u\n",
                     (unsigned)heap_caps_get_free_size(MALLOC_CAP_INTERNAL),
                     (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL));
#if ENCODE_FROM_SRAM
    if (sram_frame) {
        SerialMon.printf("Кодировщик работает из внутренней памяти, буфер %u байт\n",
                         (unsigned)sram_frame_cap);
    } else {
        SerialMon.println("ВНИМАНИЕ: внутреннего буфера нет, сжимаю прямо из PSRAM "
                          "— вернётся гонка с DMA камеры");
    }
#endif
#endif

    dbg_stage = 5;

#if PIPELINE
    /* Очередь на два кадра и задача захвата на ядре 0. loop() живёт на ядре 1,
     * так что сжатие и передача идут по-настоящему одновременно.
     *
     * Без развязки по памяти конвейер не поднимаем: 18.08 в такой конфигурации
     * он рвал картинку, и включать его снова, зная причину, незачем. */
#if ENCODE_FROM_SRAM
    if (!sram_frame) {
        SerialMon.println("Конвейер: НЕ включаю — нет внутреннего буфера, "
                          "работаю последовательно");
    } else
#endif
    {
#if ENC_WORKERS > 1 && (ENCODE_FROM_SRAM || CAM_FB_IN_DRAM)
#error "ENC_WORKERS 2 только с ENCODE_FROM_SRAM 0 и CAM_FB_IN_DRAM 0: там один общий буфер кадра"
#endif
#if ENC_WORKERS > 1
        cap_mutex = xSemaphoreCreateMutex();
#endif
        jpg_q = xQueueCreate(ENC_WORKERS + 1 + (GATED_CAPTURE ? GATE_FRAMES : 0),
                             sizeof(jpg_item_t));
        /*
         * Стек 8192, а не 4096. Путь сжатия сам по себе укладывается примерно в
         * 2 КБ (convert_image держит кадр в 1168 байт плюс вложенные вызовы
         * кодировщика), но 20.08 выяснилось, что с 4 КБ плата умирала молча ещё
         * до первой печати, а от добавления пары печатей с flush оживала — то
         * есть дело было в считанных байтах и миллисекундах, а не в логике.
         * Четыре лишних килобайта из 228 свободных — разумная цена за то, чтобы
         * этот вопрос больше не возникал.
         */
        /*
         * ЯДРО 1, А НЕ 0. Изменено 25.08.
         *
         * Драйвер камеры держит свою задачу на ядре 0 — это зашито в сборке
         * фреймворка (CONFIG_CAMERA_CORE0=y). Она обслуживает прерывания DMA и
         * переключает буферы ПО ХОДУ кадра, то есть обязана получать процессор
         * вовремя, иначе теряются строки — и кадр приходит рваным.
         *
         * Мы же посадили туда конвейер, который тридцать пять миллисекунд подряд
         * жмёт JPEG и уступает всего раз на кадр. Отсюда, судя по всему, и
         * радужный мусор: не конкуренция за шину PSRAM (копия кадра занимает 2 мс,
         * полтора процента времени), а голодание драйвера.
         *
         * Здесь ядро 1 — то же, где живёт loop() с передачей. Выигрыш конвейера
         * при этом почти не теряется: передача по UART большую часть времени
         * ждёт места в буфере и отдаёт процессор, так что сжатие успевает
         * работать в этих паузах. А ядро 0 остаётся драйверу целиком.
         */
        /*
         * 29.09: при двух кодировщиках приоритет 0, ниже loop() (1). С равным
         * приоритетом loop, проснувшись по «FIFO UART опустел», ждал конца
         * кванта кодировщика до 1 мс — в середине чанка выходила тишина дольше
         * таймера модуля (400 мкс, сборка sil400), чанк рвался на два эфирных
         * кадра, у модуля росли переполнения приёма (110 на МБ, 2 % битых).
         * С приоритетом 0 передача вытесняет сжатие сразу.
         */
        BaseType_t task_ok = jpg_q ? xTaskCreatePinnedToCore(camera_task, "camera",
                                                             8192, NULL,
                                                             (ENC_WORKERS > 1) ? 0 : 1,
                                                             NULL, 1)
                                   : pdFAIL;
#if ENC_WORKERS > 1 && !SYNTH_SOURCE
        /* Второй кодировщик — на ядре 0, приоритет 1: задача драйвера камеры
         * там же, но с приоритетом configMAX_PRIORITIES-2 вытесняет его сразу. */
        if (task_ok == pdPASS && cap_mutex) {
            BaseType_t t2 = xTaskCreatePinnedToCore(camera_task, "camera2",
                                                    8192, (void *)1, 1, NULL, 0);
            SerialMon.printf("Конвейер: второй кодировщик на ядре 0 — %s\n",
                             t2 == pdPASS ? "запущен" : "НЕ ЗАПУСТИЛСЯ");
        }
#endif
        if (task_ok == pdPASS) {
            SerialMon.println("Конвейер: кодировщик на ядре 1 вместе с передачей");
        } else {
            /* Очередь без задачи хуже, чем её отсутствие: loop() ждал бы кадры,
             * которые некому положить, и видео просто не пошло бы. */
            if (jpg_q) {
                vQueueDelete(jpg_q);
                jpg_q = NULL;
            }
            SerialMon.println("Конвейер: не поднялся, работаю последовательно");
        }
    }
#endif

#if TEST_PATTERN
    if (camera_ok) {
        // Первые кадры сенсор отдаёт с неустоявшейся экспозицией — выбрасываем.
        for (int i = 0; i < 5; i++) {
            camera_fb_t *warm = esp_camera_fb_get();
            if (warm) {
                esp_camera_fb_return(warm);
            }
            delay(100);
        }
        camera_fb_t *fb = esp_camera_fb_get();
        if (fb) {
            uint8_t *jpg = NULL;
            size_t jpg_len = 0;
            if (frame2jpg(fb, JPEG_QUALITY_SW, &jpg, &jpg_len)) {
                tp_jpg = jpg;      // намеренно не освобождаем: живёт всю сессию
                tp_len = jpg_len;
            }
            esp_camera_fb_return(fb);
        }
        if (tp_jpg) {
            SerialMon.printf("ТЕСТ-КАДР: %u байт, CRC16=%04X — шлю его по кругу\n",
                             (unsigned)tp_len, halow_crc16(tp_jpg, (uint16_t)tp_len));
        } else {
            SerialMon.println("ТЕСТ-КАДР: снять не удалось");
        }
    }
#endif

    dbg_stage = 6;

    useAtWindow();

    dbg_stage = 7;
    SerialMon.printf("Ждём окончания стартового окна (%u мс), поток начнётся после\n",
                     (unsigned)P2P_WINDOW_MS);
    /*
     * Принудительно выталкиваем всё, что напечатали.
     *
     * 20.08: Serial здесь — это USB-Serial/JTAG (ARDUINO_USB_MODE=1), и запись
     * в него только кладёт байты в кольцо, а выгребает их прерывание. Когда
     * следом стартует конвейер и занимает ядро 0, кольцо перестаёт выгребаться,
     * и весь лог загрузки пропадает молча — плата выглядит мёртвой, хотя
     * исправно шлёт кадры. Здесь ждём, пока кольцо опустеет, поэтому лог
     * загрузки доезжает всегда.
     */
    halow_mon_settle();
}

